* text=auto

# Shell gates must stay LF even when maintainers work from Windows with
# core.autocrlf=true; CRLF makes WSL/Linux bash fail before validation starts.
scripts/* text eol=lf
*.sh text eol=lf

# Security smoke tests pin these vendored browser assets by SHA-256. Keep their
# checked-out bytes stable on Windows and Linux.
vendor/ember/*.js text eol=lf
vendor/ember/LICENSE text eol=lf
vendor/ember/UPSTREAM.md text eol=lf
vendor/jquery/jquery.js text eol=lf
vendor/ansi-up/ansi-up-global.js text eol=lf
vendor/semver/semver-global.js text eol=lf
vendor/shell-quote/shell-quote-global.js text eol=lf

# The reviewed ember-fetch source and its legal files must pack byte-for-byte
# the same way on Windows and Linux. The install archive itself stays binary.
vendor/ember-fetch-compat/** text eol=lf
vendor/ember-fetch-compat/*.tgz -text

# Vendored theme sources and their MIT provenance must archive identically on
# Windows and Linux so the public artifact license hashes remain reproducible.
vendor/ember-power-select/** text eol=lf
vendor/ember-basic-dropdown/** text eol=lf
vendor/runtime-licenses/** text eol=lf
