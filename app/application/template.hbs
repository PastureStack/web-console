<div id="underlay" class="underlay hide"></div>
<div id="loading-underlay" class="underlay"></div>
<div id="loading-overlay" class="loading-overlay">
  {{#if this.settings.isRancher}}
    <div class="pasturestack-loader" role="status" aria-live="polite">
      <div class="pasturestack-loader__stage" aria-hidden="true">
        <div class="pasturestack-loader__panel">
          <div class="pasturestack-loader__brand">
            <div class="pasturestack-loader__mark-shell">
              <img class="pasturestack-loader__mark" src="{{this.app.baseAssets}}assets/images/logos/pasturestack-mark.svg" alt="">
            </div>
            <span class="pasturestack-loader__product">{{this.settings.appName}}</span>
          </div>
          <div class="pasturestack-loader__stack">
            <span class="pasturestack-loader__layer pasturestack-loader__layer--one"></span>
            <span class="pasturestack-loader__layer pasturestack-loader__layer--two"></span>
            <span class="pasturestack-loader__layer pasturestack-loader__layer--three"></span>
          </div>
        </div>
      </div>
      <div class="pasturestack-loader__progress" aria-hidden="true">
        <span></span>
      </div>
      <span class="pasturestack-loader__label">{{t "generic.loading"}}</span>
    </div>
  {{else}}
    <div class="whiteboxloader">
      <div class="loader-inner ball-clip-rotate-pulse">
        <div></div>
        <div></div>
      </div>
    </div>
  {{/if}}
</div>

<div id="application">
  {{outlet}}

  <div class="dropdown" id="resource-actions-parent">
    <ul role="menu" id="resource-actions" class="hide resource-actions global-actions dropdown-menu dropdown-menu-right">
      <li class="resource-actions-tabbable"><a tabindex="-1" id="resource-actions-first" aria-label="{{t 'generic.selectActionBelow'}}"></a></li>
      {{#each this.resourceActions.activeActions as |item|}}
        {{#if item.divider}}
          <li class="divider"></li>
        {{else}}
          <li>
            {{action-menu-item
              label=item.label
              icon=item.icon
              action="clickedAction"
              actionArg=item.action
              altActionArg=item.altAction
            }}
          </li>
        {{/if}}
      {{else}}
        <li><a href="#" onclick="return false;" disabled="true">{{t 'generic.noActionsAvailable'}}</a></li>
      {{/each}}
    </ul>
  </div>
</div>

{{component this.tooltip tooltipTemplate=this.tooltipTemplate class="container-tooltip" id="tooltip-base" role="tooltip" aria-hidden="false"}}
{{modal-root}}
