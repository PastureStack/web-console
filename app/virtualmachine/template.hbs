<section class="header clearfix">
  <h1><LinkTo @route="virtualmachines">{{t 'virtualMachinePage.header'}}</LinkTo></h1>

  <select class="form-control virtual-machine-select"
    aria-label={{t 'virtualMachinePage.header'}}
    onchange={{action "changeVirtualMachine" value="target.value"}}>
    {{#each this.model.vm.primaryHost.instances as |obj|}}
      <option value={{obj.id}} selected={{eq obj.id this.model.vm.id}}>{{obj.displayName}}</option>
    {{/each}}
  </select>

  {{#if this.model.vm.primaryHost}}
    <strong class="r-mr5 r-ml5">{{t 'uiText.relationOn'}} <LinkTo @route="host" @model={{this.model.vm.primaryHost.id}}>{{this.model.vm.primaryHost.displayName}}</LinkTo></strong>
  {{/if}}
  <div class="pull-right">
    {{action-menu model=this.model.vm size="sm" classNames="r-ml5 pull-right"}}
    {{header-state model=this.model.vm classNames="pull-right"}}
  </div>
</section>

<section>
  <div class="row">
    <div class="col-md-3">
      {{#if this.model.vm.description}}
        <div>
          <label>{{t 'virtualMachinePage.multistat.description'}} </label>
          <span>{{this.model.vm.description}}</span>
        </div>
        <hr>
      {{/if}}
      <div>
        <label>{{t 'virtualMachinePage.multistat.host'}}</label>
        {{#if this.model.vm.primaryHost}}
          <LinkTo @route="host" @model={{this.model.vm.primaryHost.id}}>{{this.model.vm.primaryHost.displayName}}</LinkTo>
        {{else}}
          <span class="text-muted">{{t 'generic.unknown'}}</span>
        {{/if}}
      </div>

      <hr>

      <div>
        <label>{{t 'virtualMachinePage.multistat.hostIp'}}</label>
        {{copy-ip ip=this.model.vm.primaryHost.displayIp noIp='formatIp.unknownIp'}}
      </div>

      <hr>

      <div>
        <label>{{t 'virtualMachinePage.multistat.vmIp'}}</label>
        {{copy-ip ip=this.model.vm.displayIp}}
      </div>

      <hr>

      <div>
        <label>{{t 'virtualMachinePage.multistat.image'}}</label>
        <span class="force-wrap">
          {{this.model.vm.displayImage}} {{copy-to-clipboard clipboardText=this.model.vm.displayImage size="small"}}
        </span>
      </div>
    </div>
    <div class="col-md-9">
      <div class="row r-p15">
        <ul class="nav nav-tabs nav-tabs-well shadowed">
          <li><LinkTo @route="virtualmachine.labels"><i class="icon icon-tag"></i> {{t 'virtualMachinePage.navTabs.labels'}}</LinkTo></li>
        </ul>
        <div class="table-flat well">
          {{outlet}}
        </div>
      </div>
    </div>
  </div>
</section>
