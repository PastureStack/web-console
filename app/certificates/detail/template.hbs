<section class="header clearfix">
  <h1><LinkTo @route="certificates">{{t 'certificatesPage.detail.header'}}</LinkTo></h1>

  <PowerSelect @options={{this.model.allCertificates}} @selected={{this.model.certificate}} @onChange={{action "changeCertificate"}} @searchField="displayName" as |obj|>
    <span class="clip">
      {{select-dot model=obj}}
    </span>
  </PowerSelect>

  {{action-menu model=this.model.certificate size="sm"}}
</section>

{{#if this.model.certificate.description}}
  <section>
    <div class="well description">
      <label>{{t 'certificatesPage.detail.description'}}</label>
      <p>{{this.model.certificate.description}}</p>
    </div>
  </section>
{{/if}}

<section>
  <div class="row">
    <div class="row-same-height row-full-height">
      <div class="col-sm-12 col-md-6 col-md-height col-md-full-height col-top" style="margin-bottom: 20px;">
        <div class="well no-padding-margin" style="height: 100%;">
          <div style="padding: 20px;">
            <label class="section">{{t 'certificatesPage.detail.info.labelText'}}</label>
            <div>
              <ul class="list-lines">
                <li>
                  <label>{{t 'certificatesPage.detail.info.valid'}}</label>
                  {{date-calendar this.model.certificate.issuedAt}} ({{date-from-now this.model.certificate.issuedDate}})
                </li>
                <li>
                  <label>{{t 'certificatesPage.detail.info.expires'}}</label>
                  <span class="{{if this.model.certificate.expiresSoon "text-bold text-danger"}}">
                    {{date-calendar this.model.certificate.expiresAt}}
                    ({{date-from-now this.model.certificate.expiresDate}})
                  </span>
                </li>
                <li class="force-wrap">
                  <label>{{t 'certificatesPage.detail.info.algorithm'}}</label>
                  {{this.model.certificate.algorithm}}{{#if this.model.certificate.keySize}} - {{this.model.certificate.keySize}} {{t 'uiText.certificateBits'}}{{/if}}
                </li>
                <li class="force-wrap">
                  <label>{{t 'certificatesPage.detail.info.issuer'}}</label>
                  {{this.model.certificate.displayIssuer}}
                </li>
                <li class="force-wrap">
                  <label>{{t 'certificatesPage.detail.info.serialNumber'}}</label>
                  {{this.model.certificate.serialNumber}}
                </li>
                <li>
                  <label>{{t 'certificatesPage.detail.info.version'}}</label>
                  {{this.model.certificate.version}}
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
      <div class="col-sm-12 col-md-6 col-md-height col-md-full-height col-top" style="margin-bottom: 20px;">
        <div class="well no-padding-margin" style="height: 100%;">
          <div style="padding: 20px;">
            <label class="section">{{t 'certificatesPage.detail.domainNames.labelText'}}</label>
            <div>
              <ul class="list-unstyled">
                {{#if this.model.certificate.CN}}
                  <li><a href="https://{{this.model.certificate.CN}}" target="_blank">{{this.model.certificate.CN}}</a> (CN)</li>
                  {{#each this.model.certificate.displaySans as |san|}}
                    <li><a href="https://{{san}}" target="_blank">{{san}}</a></li>
                  {{/each}}
                {{else}}
                  <span class="text-muted">{{t 'generic.none'}}</span>
                {{/if}}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
