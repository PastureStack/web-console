<div style="max-width: 360px; margin: 100px auto 0 auto;">
  <div class="farm-box login top-colors">
    <h1>
      {{format-html-message 'loginPage.greeting' appName=settings.appName}}
      <div class="logo"></div>
    </h1>
    <section class="r-pb0">
      {{language-dropdown login=true class='r-mt10 r-mb10'}}
      <br/>
      {{#if hasNewRecoveryCodes}}
        <div class="alert alert-warning" role="alert">
          <strong>{{t 'loginPage.mfa.recoveryCodes.header'}}</strong>
          <p>{{t 'loginPage.mfa.recoveryCodes.help'}}</p>
        </div>
        <div class="well">
          {{#each newRecoveryCodes as |code|}}
            <div><code>{{code}}</code></div>
          {{/each}}
        </div>
        <div class="text-center">
          <button type="button" class="btn btn-default r-mr10" {{action "copyRecoveryCodes"}}>
            <i class="icon icon-copy"></i>
            {{t 'loginPage.mfa.recoveryCodes.copy'}}
          </button>
          <button type="button" class="btn btn-primary" {{action "acknowledgeRecoveryCodes"}}>
            {{t 'loginPage.mfa.recoveryCodes.saved'}}
          </button>
        </div>
      {{else if isMfaPending}}
        <h3 class="text-center">{{t 'loginPage.mfa.header'}}</h3>

        {{#if infoMsg}}
          <div class="alert alert-danger" role="alert">{{infoMsg}}</div>
        {{/if}}

        {{#if mfaChallenge.mfaEnrollmentRequired}}
          <div class="alert alert-warning" role="status">
            {{t 'loginPage.mfa.enrollmentRequired'}}
          </div>
        {{/if}}

        {{#if (gt mfaChallenge.mfaMethods.length 1)}}
          <div class="btn-group btn-group-justified r-mb15" role="group">
            {{#each mfaChallenge.mfaMethods as |method|}}
              <a href="#" role="button"
                 class="btn {{if (eq activeMfaMethod method) 'btn-primary' 'btn-default'}}"
                 {{action "selectMfaMethod" method}}>
                {{t (concat 'loginPage.mfa.methods.' method)}}
              </a>
            {{/each}}
          </div>
        {{/if}}

        {{#if isMfaEnrollment}}
          <p>{{t 'loginPage.mfa.totp.enrollHelp'}}</p>
          <label>{{t 'loginPage.mfa.totp.secret'}}</label>
          <div class="well text-center"><code>{{mfaChallenge.totpSecret}}</code></div>
        {{/if}}

        {{#if isMfaTotp}}
          <label for="mfa-code">{{t 'loginPage.mfa.totp.code'}}</label>
          {{input id="mfa-code" value=mfaCode class="form-control input-lg text-center"
                  maxlength="6" autocomplete="one-time-code"
                  placeholder=(t 'loginPage.mfa.totp.placeholder')}}
          <button type="button" class="btn btn-primary btn-block r-mt15"
                  disabled={{waiting}} {{action "verifyMfa"}}>
            {{#if waiting}}<i class="icon icon-spinner icon-spin"></i>{{/if}}
            {{t 'loginPage.mfa.verify'}}
          </button>
        {{/if}}

        {{#if isMfaPasskey}}
          <p>{{t 'loginPage.mfa.passkey.help'}}</p>
          <button type="button" class="btn btn-primary btn-block"
                  disabled={{waiting}} {{action "verifyPasskey"}}>
            {{#if waiting}}<i class="icon icon-spinner icon-spin"></i>{{else}}<i class="icon icon-key"></i>{{/if}}
            {{t 'loginPage.mfa.passkey.action'}}
          </button>
        {{/if}}

        {{#if isMfaRecoveryCode}}
          <p>{{t 'loginPage.mfa.recoveryCode.help'}}</p>
          {{input value=recoveryCode class="form-control input-lg text-center"
                  autocomplete="one-time-code"
                  placeholder=(t 'loginPage.mfa.recoveryCode.placeholder')}}
          <button type="button" class="btn btn-primary btn-block r-mt15"
                  disabled={{waiting}} {{action "verifyMfa"}}>
            {{t 'loginPage.mfa.verify'}}
          </button>
        {{/if}}

        {{#if isMfaEmailRecovery}}
          <div class="alert alert-warning" role="status">
            {{t 'loginPage.mfa.emailRecovery.warning'}}
          </div>
          <p>{{t 'loginPage.mfa.emailRecovery.destination' email=mfaChallenge.recoveryEmailMasked}}</p>
          {{#if emailCodeSent}}
            {{input value=emailCode class="form-control input-lg text-center"
                    maxlength="6" autocomplete="one-time-code"
                    placeholder=(t 'loginPage.mfa.emailRecovery.placeholder')}}
            <button type="button" class="btn btn-danger btn-block r-mt15"
                    disabled={{waiting}} {{action "verifyMfa"}}>
              {{t 'loginPage.mfa.emailRecovery.complete'}}
            </button>
          {{else}}
            <button type="button" class="btn btn-warning btn-block"
                    disabled={{waiting}} {{action "verifyMfa"}}>
              {{t 'loginPage.mfa.emailRecovery.send'}}
            </button>
          {{/if}}
        {{/if}}

        <p class="text-center r-mt15">
          <button type="button" class="btn btn-link" {{action "cancelMfa"}}>
            <i class="icon icon-chevron-left"></i>
            {{t 'loginPage.mfa.cancel'}}
          </button>
        </p>
      {{else}}
      {{#if useLocalRecovery}}
        <div class="alert alert-info" role="status">
          <strong>{{t 'loginPage.localRecovery.header'}}</strong>
          <p class="r-mb0">{{t 'loginPage.localRecovery.help'}}</p>
        </div>
      {{else if isGithub}}
        <p>{{t 'loginPage.githubMessage' appName=settings.appName}}</p>
        <br/>
      {{/if}}

      {{#if isShibboleth}}
        <p>{{t 'loginPage.shibbolethMessage' appName=settings.appName}}</p>
        <br/>
      {{/if}}

      {{#if isOidc}}
        <p>{{t 'loginPage.oidcMessage' appName=settings.appName providerName=oidcProviderName}}</p>
        <br/>
      {{/if}}

      {{#if infoMsg}}
        <div class="alert {{if errorMsg 'alert-danger' 'alert-warning'}}" role="alert">{{infoMsg}}</div>
      {{/if}}

      {{#if (or useLocalRecovery isLocal isActiveDirectory isOpenLdap isAzureAd)}}
        {{login-user-pass action="authenticate" waiting=waiting}}
      {{/if}}
      {{#unless useLocalRecovery}}
        {{#if isGithub}}
          {{login-github action="started" waiting=waiting}}
        {{/if}}
        {{#if isShibboleth}}
          {{login-shibboleth action="started" waiting=waiting}}
        {{/if}}
        {{#if isOidc}}
          {{login-oidc action="started" errorAction="oidcError" waiting=waiting providerName=oidcProviderName}}
        {{/if}}
      {{/unless}}

      {{#if canLocalRecovery}}
        <p class="text-center r-mt15">
          {{#if useLocalRecovery}}
            <button type="button" class="btn btn-link" {{action "usePrimaryLogin"}}>
              <i class="icon icon-chevron-left"></i>
              {{t 'loginPage.localRecovery.back'}}
            </button>
          {{else}}
            <button type="button" class="btn btn-link" {{action "useRecoveryLogin"}}>
              <i class="icon icon-life-ring"></i>
              {{t 'loginPage.localRecovery.action'}}
            </button>
          {{/if}}
        </p>
      {{/if}}
      {{/if}}
    </section>
  </div>
</div>
