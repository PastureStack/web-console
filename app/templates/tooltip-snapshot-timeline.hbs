<div class="tooltip-content-inner tooltip-dot">
  {{action-menu model=this.model showPrimary=false inTooltip=true class="pull-right tooltip-more-actions"}}
  <div class="display-name">{{this.displayName}}</div>
  <div class="bottom-row">
    <span class="pull-left">{{this.model.state}}</span>
    <span class="pull-right r-pr20">{{date-str this.model.created}}</span>
  </div>

</div>
