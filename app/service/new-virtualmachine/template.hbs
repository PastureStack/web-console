{{new-container
  isService=true
  isUpgrade=this.upgrade
  isSidekick=false
  isVm=true
  launchConfig=this.model.service.launchConfig
  service=this.model.service
  primaryResource=this.model.service
  allHosts=this.model.allHosts
  allStoragePools=this.model.allStoragePools
  done=(action 'done')
  cancel=(action 'cancel')
}}
