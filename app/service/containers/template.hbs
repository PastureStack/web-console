{{#sortable-table
  classNames="lacsso grid sortable-table container-table table-fit-content"
  body=model.instances
  sortBy=sortBy
  bulkActions=false
  search=true
  columnSelector=true
  columnPreference=statsColumnPreferenceKey
  paging=true
  perPage=prefs.statsTablePerPage
  pageSizeOptions=statsPageSizes
  perPagePreference=statsTablePreferenceKey
  headers=headers
  liveSortFields=liveSortFields
  sortRevision=statsSortRevision
  animateLiveSort=true
  onPageContentChange=(action 'setVisibleStatsInstances') as |container kind dt visibleColumns|}}
  {{#if (eq kind "row")}}
    {{container-row
      model=container
      showStats=true
      showActions=true
      showHost=true
      showCommand="column"
      showStateColumn=visibleColumns.state
      showNameColumn=visibleColumns.name
      showCpuColumn=visibleColumns.cpu
      showRamColumn=visibleColumns.ram
      showNetworkColumn=visibleColumns.network
      showStorageColumn=visibleColumns.storage
      showIpColumn=visibleColumns.ip
      showHostColumn=visibleColumns.host
      showImageColumn=visibleColumns.image
      showCommandColumn=visibleColumns.command
      showActionsColumn=visibleColumns.actions
      cpuMax=cpuMax
      memoryMax=memoryMax
      storageMax=storageMax
      networkMax=networkMax}}
  {{else if (eq kind "nomatch")}}
    <tr><td colspan="{{visibleColumns.count}}" class="text-center text-muted lacsso pt-20 pb-20">{{t 'containersPage.index.table.body.noMatch'}}</td></tr>
  {{else if (eq kind "norows")}}
    <tr><td colspan="{{visibleColumns.count}}" class="text-center text-muted lacsso pt-20 pb-20">{{t 'servicePage.containersTab.table.body.noData'}}</td></tr>
  {{/if}}
{{/sortable-table}}
