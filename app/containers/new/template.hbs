{{new-container
  isStandalone=true
  isService=false
  isSidekick=false
  editing=false
  launchConfig=this.model.instance
  primaryResource=this.model.instance
  allHosts=this.model.allHosts
  allStorageDrivers=this.model.allStorageDrivers
  allStoragePools=this.model.allStoragePools
  allVolumes=this.model.allVolumes
  done=(action 'done')
  cancel=(action 'cancel')
}}
