<div class="lacsso banner bg-info m-0 p-0">
  <div class="lacsso banner-icon" style="width: 68px;"><span class="icon icon-2x icon-notification"></span></div>
  <div class="lacsso banner-message">
    <p class="lacsso mt-15 mb-15">
      {{t 'uiText.secretsExperimental'}}
    </p>
  </div>
</div>

<section class="header clearfix">
  <h1>{{t 'secretsPage.index.header'}}</h1>

  <LinkTo @route="secrets.new" class="btn btn-sm btn-primary">{{t 'secretsPage.index.linkTo'}}</LinkTo>
</section>

<section class="well instances r-pt5 r-pb5">
  {{#sortable-table
    classNames="lacsso grid sortable-table"
    sorts=this.sorts
    body=this.model
    sortBy=this.sortBy
    bulkActions=true
    bulkActionCallee=(action 'applyBulkAction')
    bulkActionsList=this.bulkActionsList
    perPage=this.prefs.tablePerPage
    headers=this.headers as |row kind dt|}}
    {{#if (eq kind "row")}}
      <td data-title="{{dt.state}}">{{badge-state model=row}}</td>
      <td data-title="{{dt.name}}">{{row.name}}</td>
      <td data-title="{{dt.description}}">{{row.description}}</td>
      <td data-title="{{dt.created}}">{{date-from-now row.created}}</td>
      <td data-title="{{dt.actions}}" class="actions">
        {{action-menu model=row}}
      </td>
    {{else if (eq kind "nomatch")}}
      <tr><td colspan="{{this.headers.length}}" class="text-center text-muted lacsso pt-20 pb-20">{{t 'secretsPage.index.noMatch'}}</td></tr>
    {{else if (eq kind "norows")}}
      <tr><td colspan="{{this.headers.length}}" class="text-center text-muted lacsso pt-20 pb-20">{{t 'secretsPage.index.noData'}}</td></tr>
    {{/if}}
  {{/sortable-table}}
</section>
