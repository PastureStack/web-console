<div class="pod-header clearfix">

  <div class="pull-left pod-state {{this.stateBackground}}"><span>{{this.model.displayState}}</span></div>
  <div class="pull-right">{{action-menu model=this.model}}</div>
</div>
  <div class="pod-name">
    <a href="{{href-to 'host' this.model.id}}">{{this.model.displayName}}</a>
    {{#if (and (not this.showOnlyMessage) this.model.showTransitioningMessage)}}
      <div class="pod-message {{if this.model.isError 'text-danger' 'text-muted'}}">
        {{this.model.transitioningMessage}}
      </div>
    {{/if}}
  </div>

{{#if this.showOnlyMessage}}
  <div class="machine-info text-center force-wrap">
    <span class="{{if this.isError 'text-danger' 'text-muted'}}">{{this.model.transitioningMessage}}</span>
  </div>
{{else}}
  <div class="pod-info">
    <div class="pod-info-container">
      {{#if this.model.displayIp}}
        <div class="pod-info-item"><i class="icon icon-link"></i> {{format-ip this.model.displayIp}}</div>
      {{/if}}

      {{#if this.model.dockerEngineVersion}}
        <div class="pod-info-item"><i class="icon icon-docker"></i> {{this.model.dockerEngineVersion}}
        </div>
      {{/if}}
    </div>
    <div class="pod-info-container">
      {{#if this.model.osBlurb}}
        <div class="pod-info-item clip"><i class="icon icon-linux"></i> {{this.model.osBlurb}}{{#if this.model.kernelBlurb}} ({{this.model.kernelBlurb}}) {{/if}}</div>
      {{/if}}
    </div>
    <div class="pod-info-container">
      {{#if this.model.cpuBlurb}}
        <div class="pod-info-item"><i class="icon icon-cpu" style="position: relative; top: -1px;"></i> {{this.model.cpuBlurb}}</div>
      {{/if}}
      {{#if this.model.memoryBlurb}}
        <div class="pod-info-item"><i class="icon icon-memory"></i> {{this.model.memoryBlurb}}</div>
      {{/if}}
      {{#if this.model.diskBlurb}}
        <div class="pod-info-item"><i class="icon icon-hdd"></i> {{this.model.diskBlurb}}</div>
      {{/if}}
    </div>
    <div class="pod-info-container">
      {{#if this.model.driver}}
        <div class="pod-info-item"><i class="icon icon-cloud"></i> {{this.model.driver}}</div>
      {{/if}}
    </div>
  </div>
  {{#if (eq this.model.supportState 'unsupported')}}
    <div class="pod-info lacsso pt-5">
      <a href="{{this.settings.docsBase}}/hosts/#supported-docker-versions" target="_blank" rel="noopener noreferrer"><span class="lacsso tag bg-error force-wrap"><i class="icon icon-alert"></i> {{t 'hostPod.supportState.unsupported'}}</span></a>
    </div>
  {{else if (eq this.model.supportState 'untested')}}
    <div class="pod-info lacsso pt-5">
      <a href="{{this.settings.docsBase}}/hosts/#supported-docker-versions" target="_blank" rel="noopener noreferrer"><span class="lacsso tag bg-warning force-wrap"><i class="icon icon-alert"></i> {{t 'hostPod.supportState.untested'}}</span></a>
    </div>
  {{/if}}
  {{#if this.strictUserLabelArray.length}}
    <div class="pod-info r-mb10">
        <div class="lacsso pt-5" style="white-space: normal;">
          {{#each this.strictUserLabelArray as |label|}}
            <span class="label label-default clip" style="display: inline-block; max-width: 100%;">{{label.key}}{{#if label.value}}={{label.value}}{{/if}}</span>
          {{/each}}
        </div>
    </div>
  {{/if}}
  {{#if this.model.requireAnyLabels.length}}
    <div class="pod-info r-mb10">
        <div class="lacsso pt-5" style="white-space: normal;">
          {{#each this.model.requireAnyLabels as |label|}}
            <span class="label label-warning clip" style="display: inline-block; max-width: 100%;">{{label}}</span>
          {{/each}}
        </div>
    </div>
  {{/if}}

  <div class="clearfix {{if (eq this.mode "dot") 'r-p5'}}" style="white-space: normal">
    {{#if (eq this.mode "dot")}}
      {{#each this.arrangedInstances as |item|}}
        {{container-dot model=item}}
      {{/each}}
    {{else}}
      {{#each this.groupedInstances as |group|}}
        {{#if (or this.showAdd group.instances.length)}}
          <div class="container-subpod-info">
            <div class="subpod-header">
              <h6 class="clip">
                {{~#if group.name~}}
                  {{#if group.kubernetes}}
                    {{t 'hostPod.groupedInstances.namespace'}}
                    {{group.name}}
                  {{else}}
                    {{t 'hostPod.groupedInstances.stack'}}
                    {{#link-to "stack" group.id}}{{group.name}}{{/link-to}}
                  {{/if}}
                {{else}}
                  {{t 'hostPod.groupedInstances.standalone'}}
                {{/if}}
              </h6>
            </div>
            <div class="subpod-inner clearfix">
              {{#each group.instances as |item|}}
                {{container-subpod model=item.main stripProject=true children=item.children}}
              {{/each}}
              {{#unless group.name}}
                {{#if this.showAdd}}
                  {{add-subpod action="newContainer" label="hostsPage.addContainer" groupHasChildren=group.hasChildren}}
                {{/if}}
              {{/unless}}
            </div>
          </div>
        {{/if}}
      {{else}}
        {{#if this.showAdd}}
          {{add-subpod action="newContainer" label="hostsPage.addContainer" groupHasChildren=this.group.hasChildren}}
        {{/if}}
      {{/each}}
    {{/if}}
  </div>
{{/if}}
