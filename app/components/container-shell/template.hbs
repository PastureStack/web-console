{{#if this.showProtip}}
  <div class="protip">
    {{t 'containerShell.protip' key=this.alternateLabel}}
  </div>
  <hr>
{{/if}}
<h2 class='r-mb10'><i class="icon icon-terminal"></i> {{t 'modalShell.title' instanceName=this.instance.displayName}}</h2>
<div class="shell-container">
  <div class="shell-body" contenteditable="{{this.contenteditable}}" oncontextmenu={{action "contextMenuHandler"}}>
  </div>
</div>
<div class="footer-actions">
  <div class="console-status text-muted">{{t (concat-str 'containerShell.status' this.status character='.') error=this.error}}</div>
  {{yield}}
</div>
