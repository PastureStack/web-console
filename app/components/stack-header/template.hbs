<section class="header clearfix">
  <h1><LinkTo @route="stacks">{{t 'stackHeader.backLink'}}</LinkTo></h1>

  <PowerSelect @options={{this.all}} @selected={{this.model}} @onChange={{action "changeStack"}} @searchField="displayName" as |obj|>
      {{select-dot model=obj}}
  </PowerSelect>


  <div class="pull-right">
    {{#if this.outputs.length}}
      <div class="btn-group">
        <button type="button" class="btn btn-sm btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
          {{t 'stackHeader.outputs'}} <i class="icon icon-chevron-down"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
          {{#each this.outputs as |obj|}}
            <li><a href="{{obj.value}}" target="_blank">{{obj.key}}</a></li>
          {{/each}}
        </ul>
      </div>
    {{/if}}

    <div class="btn-group r-ml10">
      <LinkTo @route="service.new" @query={{hash stackId=this.model.id}} class="btn btn-primary btn-sm">{{t 'stackHeader.add.service'}}</LinkTo>
        <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
          <i class="icon icon-chevron-down"></i>
          <span class="sr-only">{{t 'nav.srToggleNav'}}</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end" role="menu">
          {{#unless this.projects.current.isWindows}}
          <li><LinkTo @route="service.new-balancer" @query={{hash stackId=this.model.id}}>{{t 'stackHeader.add.balancer'}}</LinkTo></li>
          {{/unless}}
          <li><LinkTo @route="service.new-alias" @query={{hash stackId=this.model.id}}>{{t 'stackHeader.add.alias'}}</LinkTo></li>
          <li><LinkTo @route="service.new-external" @query={{hash stackId=this.model.id}}>{{t 'stackHeader.add.external'}}</LinkTo></li>
          {{#if (and this.hasVm (not this.projects.current.isWindows))}}
            <li><LinkTo @route="service.new-virtualmachine" @query={{hash stackId=this.model.id}}>{{t 'stackHeader.add.vm'}}</LinkTo></li>
          {{/if}}
        </ul>
    </div>

    {{action-menu model=this.model classNames="r-ml10 pull-right" size="sm"}}
    {{header-state model=this.model classNames="pull-right"}}

    <div class="btn-group r-ml10">
      <LinkTo @route="stack.index" class="btn btn-sm btn-default">{{tooltip-link icon="icon-tasks" text=(t 'tooltipLink.list') options=this.listLinkOptions}}</LinkTo>
      <LinkTo @route="stack.graph" class="btn btn-sm btn-default">{{tooltip-link icon="icon-share" text=(t 'tooltipLink.linkGraph') options=this.graphLinkOptions}}</LinkTo>
      {{#if this.model.canViewConfig}}
        <LinkTo @route="stack.code" class="btn btn-sm btn-default">{{tooltip-link icon="icon-file" text=(t 'tooltipLink.composeYaml') options=this.yamlLinkOptions}}</LinkTo>
      {{/if}}
    </div>

    {{upgrade-btn model=this.model classNames="r-ml10"}}
  </div>
</section>
