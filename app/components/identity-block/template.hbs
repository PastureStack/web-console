{{yield}}
{{#if this.avatar}}
  <div class="gh-avatar">
    {{#if this.avatarSrc}}
      {{#if (and this.url this.link)}}
        <a href="{{this.url}}" target="_blank">
          <img src="{{this.avatarSrc}}" width="{{this.size}}" height="{{this.size}}">
        </a>
      {{else}}
        <img src="{{this.avatarSrc}}" width="{{this.size}}" height="{{this.size}}">
      {{/if}}
    {{else}}
      <div class="gh-placeholder"></div>
    {{/if}}
  </div>
{{/if}}
<div class="gh-block-content">
  <div class="clip gh-block-name">
    {{#if this.loading}}
      {{t 'identityBlock.loading'}}
    {{else}}
      {{#if (and this.url this.link)}}
        <a href="{{this.url}}" target="_blank">{{this.login}}</a>
      {{else}}
        {{#if this.login}}
          {{this.login}}
        {{else}}
          &nbsp;
        {{/if}}
      {{/if}}
    {{/if}}
  </div>
  <div class="gh-block-detail clip">
    {{#if this.displayDescription}}
      {{this.displayDescription}}
    {{else}}
      &nbsp;
    {{/if}}
  </div>
</div>
