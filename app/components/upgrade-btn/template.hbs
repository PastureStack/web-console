{{#if this.currentVersion}}
  {{#tooltip-element type="tooltip-basic" model=this.currentVersion tooltipTemplate='tooltip-static' aria-describedby="tooltip-base" tooltipFor="upgrade"}}
    {{t (concat-str 'upgradeBtn.status.' this.upgradeStatus character='')}}
  {{/tooltip-element}}
{{else}}
  {{t (concat-str 'upgradeBtn.status.' this.upgradeStatus character='')}}
{{/if}}
