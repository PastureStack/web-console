<td data-title="{{t 'generic.state'}}:">
  {{badge-state model=this.model}}
</td>
<td data-title="{{t 'generic.name'}}:" class="force-wrap">
  {{#link-to "certificates.detail" this.model.id}}{{this.model.displayName}}{{/link-to}}
</td>
<td data-title="{{t 'certificatesPage.table.cn'}}:">
  {{#if this.model.CN}}
    {{this.model.CN}}
    {{#if this.model.countableSans.length}}
      + {{t 'certificatesPage.table.otherNames' count=this.model.countableSans.length}}
    {{/if}}
  {{else}}
    <span class="text-muted">{{t 'certificatesPage.table.noCn'}}</span>
  {{/if}}
</td>
<td data-title="{{t 'certificatesPage.table.expiresDate'}}:">
  <span class="{{if this.model.expiresSoon "text-bold text-danger"}}">
    {{date-from-now this.model.expiresDate}}
  </span>
</td>
<td data-title="{{t 'generic.actions'}}:" class="actions">
  {{action-menu model=this.model}}
</td>
