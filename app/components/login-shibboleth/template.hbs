<form {{action "authenticate" on="submit"}} class="text-left login-provider-form">
  <div class="login-submit-row text-center">
    <button type="submit" disabled={{waiting}} class="btn btn-primary btn-block">
      {{t 'loginShibboleth.buttonText'}}
    </button>
    <a href="{{outRoute}}/v1-auth/saml/logout" target="_blank" rel="noopener noreferrer" class="inline-block r-mt15">{{t 'loginShibboleth.logout'}}</a>
  </div>
</form>
