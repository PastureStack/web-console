<div class="r-p40 text-center">
  <h1 class="header">{{t 'projectUpgrade.header' appName=this.settings.appName}}</h1>

  <p>{{format-html-message 'projectUpgrade.detail' appName=this.settings.appName appVersion=this.settings.minorVersion}}</p>

    <div class="footer-actions">
      {{#if this.errorMessage}}
        <div class="alert alert-danger" role="alert">{{this.errorMessage}}</div>
      {{/if}}
      {{#if this.canUpgrade}}
        <button {{action "upgrade"}} class="btn btn-primary" disabled={{this.isUpgrading}}>{{t 'projectUpgrade.actionButton'}}</button>
      {{else}}
        <button class="btn btn-primary btn-disabled" disabled="disabled">{{t 'projectUpgrade.actionButton'}}</button>
        <p class="text-muted">{{#if this.isOwner}}{{t 'projectUpgrade.notAvailable'}}{{else}}{{t 'projectUpgrade.notOwner'}}{{/if}}</p>
      {{/if}}
    </div>
</div>
