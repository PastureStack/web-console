{{#liquid-if this.loading}}
  <div class="text-center">
    <p>
      <i class="icon icon-spinner icon-spin"></i> {{t 'generic.loading'}}
    </p>
  </div>
{{else}}
  <section class="horizontal-form container-fluid">
    <h2>{{t (if this.model.instance.isVm 'editContainer.title.vm' 'editContainer.title.container')}}</h2>

    {{top-errors errors=this.errors}}

    {{form-name-description
      model=this.model.instance
      namePlaceholder="editContainer.name.placeholder"
      descriptionPlaceholder="editContainer.description.placeholder"
    }}

    {{form-ports initialPorts=this.model.ports editing=true changed=(action "setPorts")}}

    {{form-container-links initialLinks=this.model.instanceLinks instance=this.model.instance allHosts=this.model.allHosts editing=true changed=(action "setLinks")}}
  </section>

  {{save-cancel editing=this.editing save="save" cancel="cancel"}}
{{/liquid-if}}
