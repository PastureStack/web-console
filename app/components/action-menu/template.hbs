{{yield}}
{{#if (and this.showPrimary this.model.primaryAction)}}
  <button class="btn btn-default btn-{{this.size}}" data-primary="0" aria-label="{{t this.model.primaryAction.label}}">
    {{#tooltip-element type="tooltip-basic" model=this.model.primaryAction tooltipFor="actionMenu"}}
      <i class="icon-fw {{this.model.primaryAction.icon}}"></i>
    {{/tooltip-element}}
  </button>
{{/if}}
<button aria-label="{{t 'generic.moreActions'}}" aria-controls="resource-actions" class="btn btn-default btn-{{this.size}} more-actions must-propagate" data-bs-toggle="dropdown" data-bs-target=".resource-actions" aria-expanded="false">
  <i class="icon icon-fw icon-vertical-ellipsis" alt="{{t 'generic.moreActions'}}"></i>
</button>
