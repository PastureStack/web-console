<div class="row form-group">
  <div class="col-sm-12 col-md-2 form-label">
    <label class="form-control-static">{{t 'formNetwork.networkMode.label'}}</label>
  </div>

  <div class="col-sm-12 {{if this.isContainerNetwork 'col-md-3' 'col-md-8'}}">
    {{#input-or-display editable=this.editing value=this.instance.networkMode}}
      {{new-select
        classNames="form-control"
        content=this.networkChoices
        value=this.instance.networkMode
      }}
    {{/input-or-display}}
  </div>

  {{#if this.isContainerNetwork}}
    {{#if this.isService}}
      <div class="col-sm-12 col-md-2 form-label">
        <label class="form-control-static">{{t 'formNetwork.container.label'}}</label>
      </div>
      <div class="col-sm-12 col-md-3">
        {{#input-or-display editable=this.editing value=this.instance.networkLaunchConfig}}
          {{input
            classNames="form-control"
            value=this.instance.networkLaunchConfig
          }}
        {{/input-or-display}}
      </div>
    {{else}}
      <div class="col-sm-12 col-md-2 form-label">
        <label class="form-control-static">{{t 'formNetwork.container.label'}}</label>
      </div>
      <div class="col-sm-12 col-md-3">
        {{#input-or-display editable=this.editing value=this.instance.networkContainerId}}
          {{new-select
            classNames="form-control"
            content=this.containersOnRequestedHost
            optionLabelPath="name"
            optionValuePath="id"
            optionGroupPath="group"
            value=this.instance.networkContainerId
          }}
        {{/input-or-display}}
      </div>
    {{/if}}
  {{/if}}
</div>

{{#if this.isManagedNetwork}}
  <div class="row form-group">
    <div class="col-sm-12 col-md-2 form-label">
      <label class="form-control-static">{{t 'formNetwork.requestedIp.label'}}</label>
    </div>

    <div class="col-sm-12 col-md-8">
      {{#input-or-display editable=this.editing value=this.requestedIp}}
        {{input type="text" value=this.requestedIp classNames="form-control" placeholder=(t 'formNetwork.requestedIp.placeholder')}}
        <p class="help-block">{{t 'formNetwork.requestedIp.help'}}</p>
      {{/input-or-display}}
    </div>
  </div>
  {{#if (and this.isService (not this.isSidekick))}}
    <div class="row">
      <div class="col-sm-12 col-md-2 form-label">
        <label class="form-control-static">{{t 'formNetwork.retainIp.label'}}</label>
      </div>

      <div class="col-sm-12 col-md-8">
        {{#input-or-display editable=this.editing value=this.service.retainIp}}
          <label class="form-control-static radio small">{{input type="checkbox" checked=this.service.retainIp disabled=this.disableRetainIp}} {{t 'formNetwork.retainIp.reuse'}}</label>
        {{/input-or-display}}
      </div>
    </div>
  {{/if}}
{{else}}
  {{#if this.isHostNetwork}}
    <div class="row form-group">
      <div class="col-sm-12 col-md-2 form-label">
        <label class="form-control-static">{{t 'formNetwork.dns.label'}}</label>
      </div>

      <div class="col-sm-12 col-md-8">
        {{#input-or-display editable=this.editing value=this.dnsDiscovery}}
          <label class="form-control-static checkbox small r-ml20">{{input type="checkbox" checked=this.dnsDiscovery}}{{t 'formNetwork.dns.enable' appName=this.settings.appName}}</label>
        {{/input-or-display}}
      </div>
    </div>
  {{/if}}
{{/if}}

{{#unless this.isService}}
  {{#if this.editing}}
    {{form-container-links initialLinks=this.instance.instanceLinks instance=this.instance allHosts=this.allHosts}}
  {{else}}
    <div class="row form-group">
      <div class="col-sm-12 col-md-2 form-label">
        <label>{{t 'formContainerLinks.label'}}</label>
      </div>
      <div class="col-sm-12 col-md-8">
        {{#if this.instance.instanceLinks}}
          <table class="grid fixed">
            <thead>
              <tr>
                <th>{{t 'formNetwork.links.table.dest'}}</th>
                <th>{{t 'formNetwork.links.table.as'}}</th>
              </tr>
            </thead>
            <tbody>
              {{#each-in this.instance.instanceLinks as |key value|}}
                <tr>
                  <td class="force-wrap valign-top" data-title={{t 'formNetwork.links.table.data.dest'}}>{{key}}</td>
                  <td class="force-wrap valign-top" data-title={{t 'formNetwork.links.table.data.as'}}>{{value}}</td>
                </tr>
              {{/each-in}}
            </tbody>
          </table>
        {{else}}
          <div>{{t 'generic.none'}}</div>
        {{/if}}
      </div>
    </div>
  {{/if}}
{{/unless}}

{{#unless this.isHostNetwork}}
  <div class="row form-group">
    <div class="col-sm-12 col-md-2 form-label">
      <label class="form-control-static">{{t 'formNetwork.hostname.label'}}</label>
    </div>

    <div class="col-sm-12 col-md-8">
      {{#if this.isService}}
        {{#input-or-display editable=this.editing value=this.hostname}}
          <div class="radio small r-mt10">
            <label>{{radio-button selection=this.hostname value="default"}} {{t 'formNetwork.hostname.dockerId'}}</label>
          </div>
          <div class="radio small r-mt10">
            <label>{{radio-button selection=this.hostname value="override"}} {{t 'formNetwork.hostname.containerName'}}</label>
          </div>
          <div class="radio small">
            <label>{{radio-button selection=this.hostname value="custom"}} {{t 'formNetwork.hostname.custom'}}:</label>
            {{input type="text" value=this.instance.hostname classNames="form-control r-ml10 input-sm" safeStyle="display:inline; width: 200px;" placeholder=(t 'formNetwork.hostname.placeholder') disabled=(not-eq this.hostname "custom")}}
          </div>
        {{/input-or-display}}
      {{else}}
        {{#input-or-display editable=this.editing value=this.instance.hostname}}
          {{input type="text" value=this.instance.hostname classNames="form-control" placeholder=(t 'formNetwork.hostname.placeholder')}}
        {{/input-or-display}}
      {{/if}}
    </div>
  </div>
{{/unless}}

<div class="row form-group">
  <div class="col-sm-12 col-md-2 form-label">
    <label class="form-control-static">{{t 'formNetwork.domainName.label'}}</label>
  </div>

  <div class="col-sm-12 col-md-8">
    {{#input-or-display editable=this.editing value=this.instance.domainName}}
      {{input type="text" value=this.instance.domainName classNames="form-control" placeholder=(t 'formNetwork.domainName.placeholder')}}
    {{/input-or-display}}
  </div>
</div>

{{#unless this.projects.current.isWindows}}
  <div class="row form-group">
    <div class="col-sm-12 col-md-2 form-label">
      <label class="form-control-static">{{t 'formNetwork.resolvingServers.label'}}</label>
    </div>

    <div class="col-sm-12 col-md-8">
      {{#if this.editing}}
        <div>
          <button class="btn-circle-text" {{action "addDnsResolver"}}><i class="icon icon-plus-circle"/> <span>{{t 'formNetwork.resolvingServers.addActionLabel'}}</span></button>
        </div>
        {{#if this.dnsResolverArray.length}}
          <table class="table fixed no-lines no-top-padding tight">
            {{#each this.dnsResolverArray as |dns|}}
              <tr>
                <td>
                  {{input type="text" value=dns.value classNames="form-control dns-value input-sm" placeholder=(t 'formNetwork.resolvingServers.placeholder')}}
                </td>
                <td width="30" class="text-right">
                  <button class="btn btn-primary btn-sm" {{action "removeDnsResolver" dns}}><i class="icon icon-minus"/></button>
                </td>
              </tr>
            {{/each}}
          </table>
        {{/if}}
      {{else}}
        {{#if this.dnsResolverArray.length}}
          <table class="table fixed no-lines no-top-padding tight" style="margin-top: -4px;">
            {{#each this.dnsResolverArray as |dns|}}
              <tr>
                <td>
                  {{dns.value}}
                </td>
              </tr>
            {{/each}}
          </table>
        {{else}}
          <div class="form-control-static">{{t 'generic.none'}}</div>
        {{/if}}
      {{/if}}
    </div>
  </div>

  <div class="row form-group">
    <div class="col-sm-12 col-md-2 form-label">
      <label class="form-control-static">{{t 'formNetwork.searchDomains.label'}}</label>
    </div>

    <div class="col-sm-12 col-md-8">
      {{#if this.editing}}
        <div>
          <button class="btn-circle-text" {{action "addDnsSearch"}}><i class="icon icon-plus-circle"/> <span>{{t 'formNetwork.searchDomains.addActionLabel'}}</span></button>
        </div>
        {{#if this.dnsSearchArray.length}}
          <table class="table fixed no-lines no-top-padding tight">
            {{#each this.dnsSearchArray as |dnsSearch|}}
              <tr>
                <td>
                  {{input type="text" value=dnsSearch.value classNames="form-control dns-search-value input-sm" placeholder=(t 'formNetwork.searchDomains.placeholder')}}
                </td>
                <td width="30" class="text-right">
                  <button class="btn btn-primary btn-sm" {{action "removeDnsSearch" dnsSearch}}><i class="icon icon-minus"/></button>
                </td>
              </tr>
            {{/each}}
          </table>
        {{/if}}
      {{else}}
        {{#if this.dnsSearchArray.length}}
          <table class="table fixed no-lines no-top-padding tight" style="margin-top: -4px;">
            {{#each this.dnsSearchArray as |dnsSearch|}}
              <tr>
                <td>
                  {{dnsSearch.value}}
                </td>
              </tr>
            {{/each}}
          </table>
        {{else}}
          <div class="form-control-static">{{t 'generic.none'}}</div>
        {{/if}}
      {{/if}}
    </div>
  </div>
{{/unless}}
