
<section class="horizontal-form">
  <div class="container-fluid">
    {{partial "host/add-common"}}

    <div class="over-hr r-mt20 r-mb20">
      <span>{{t 'machine.driverOther.driverSection'}}</span>
    </div>

    <div class="row form-group">
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverOther.driver.label'}}*</label>
      </div>
      <div class="col-md-8">
        {{new-select
          classNames="form-control"
          content=this.otherChoices
          value=this.otherDriver
        }}
      </div>
    </div>

    <div class="over-hr r-mt20 r-mb20">
      <span>{{t 'machine.driverOther.optionsSection' driverName=(str-replace this.driver match="Config" with="")}}</span>
    </div>

    {{#each this.fieldNames as |fieldName|}}
      {{api-field
        resource=this.driverOpts
        resourceType=this.otherDriver
        field=fieldName
        value=(get this.driverOpts fieldName)
        schemas=this.schemas
        typeDocs=this.typeDocumentations
      }}
    {{/each}}

    {{partial "host/add-options"}}
  </div>

  {{top-errors errors=this.errors}}
  {{save-cancel save="save" cancel="cancel"}}
</section>
