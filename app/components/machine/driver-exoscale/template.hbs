<section class="horizontal-form">
  <form>
    <div class="container-fluid">
      <div class="over-hr r-mb20">
        <span>{{t 'machine.driverExoscale.accountSection'}}</span>
      </div>

      <div class="row {{if this.isStep1 'form-group'}}">
        <div class="col-md-2 form-label">
          <label class="form-control-static">{{t 'machine.driverExoscale.apiKey.label'}}</label>
        </div>
        <div class="col-md-10">
          {{#if this.isStep1}}
            {{input type="text" name="username" classNames="form-control" placeholder=(t 'machine.driverExoscale.apiKey.placeholder') value=this.exoscaleConfig.apiKey}}
          {{else}}
            <div class="form-control-static">{{this.exoscaleConfig.apiKey}}</div>
          {{/if}}
        </div>
      </div>
      <div class="row {{if this.isStep1 'form-group'}}">
        <div class="col-md-2 form-label">
          <label class="form-control-static">{{t 'machine.driverExoscale.secretKey.label'}}</label>
        </div>
        <div class="col-md-10">
          {{#if this.isStep1}}
            {{input type="password" name="password" classNames="form-control" placeholder=(t 'machine.driverExoscale.secretKey.placeholder') value=this.exoscaleConfig.apiSecretKey}}
          {{else}}
            <div class="form-control-static text-muted text-italic">{{t 'machine.driverExoscale.secretKey.provided'}}</div>
          {{/if}}
          {{#if this.isStep1}}
            <p class="help-block">{{t 'machine.driverExoscale.accountHelp'}}</p>
          {{/if}}
        </div>
      </div>
    </div>
    {{#if this.isStep1}}
      {{top-errors errors=this.errors}}

      <div class="footer-actions">
        <button {{action "exoscaleLogin"}} name="submit" class="btn btn-primary">{{t 'machine.driverExoscale.loginAction'}}</button>
        <button {{action "cancel"}} class="btn btn-link">{{t 'generic.cancel'}}</button>
      </div>
    {{/if}}
  </form>
</section>

<section class="horizontal-form r-pt0 {{unless this.isStep2 'hide'}}">
  <div class="text-center">
    <i class="icon icon-spinner icon-spin"></i> {{t 'machine.driverExoscale.loadingZone'}}
  </div>
</section>

<section class="horizontal-form r-pt0 {{unless this.isGteStep3 'hide'}}">
  <div class="container-fluid">
    <div class="over-hr r-mt20 r-mb20">
      <span>{{t 'machine.driverExoscale.zoneSection'}}</span>
    </div>

    <div class="row {{if this.isStep3 'form-group'}}">
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverExoscale.zone.label'}}</label>
      </div>
      <div class="col-md-10">
        {{#if this.isStep3}}
         {{#each this.allZones as |choice|}}
          <div class="radio r-pt10"><label>
            {{radio-button selection=this.whichZone value=choice.id}}
            {{ choice.name }}
          </label></div>
        {{/each}}
        {{else}}
          <div class="form-control-static">
            {{this.exoscaleConfig.zoneName}}
          </div>
        {{/if}}
      </div>
    </div>
  </div>
  {{#if this.isStep3}}
    {{top-errors errors=this.errors}}

    <div class="footer-actions">
      <button {{action "selectZone"}} class="btn btn-primary">{{t 'machine.driverExoscale.selectZoneAction'}}</button>
      <button {{action "cancel"}} class="btn btn-link">{{t 'generic.cancel'}}</button>
    </div>
  {{/if}}
</section>


<section class="horizontal-form r-pt0 {{unless this.isStep4 'hide'}}">
  <div class="text-center">
    <i class="icon icon-spinner icon-spin"></i> {{t 'machine.driverExoscale.loadingSecurity'}}
  </div>
</section>

<section class="horizontal-form r-pt0 {{unless this.isGteStep5 'hide'}}">
  <div class="container-fluid">
    <div class="over-hr r-mt20 r-mb20">
      <span>{{t 'machine.driverExoscale.securityGroupSection'}}</span>
    </div>

    <div class="row {{if this.isStep5 'form-group'}}">
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverExoscale.securityGroup.label'}}</label>
      </div>
      <div class="col-md-10">
        {{#if this.isStep5}}
          <div class="radio r-pt10"><label>
            {{radio-button selection=this.whichSecurityGroup value="default"}}
            {{#if this.defaultSecurityGroup}}
              {{format-html-message 'machine.driverExoscale.securityGroup.defaultExisting' groupName=this.defaultSecurityGroupName}}
            {{else}}
              {{format-html-message 'machine.driverExoscale.securityGroup.defaultCreate' groupName=this.defaultSecurityGroupName}}
            {{/if}}
          </label></div>

          {{#unless this.isCustomSecurityGroup}}
            <p class="help-block r-ml20"><a href="{{this.settings.docsBase}}/network-ports/" target="_blank" rel="noopener noreferrer">{{t 'machine.driverExoscale.portHelp.link'}}</a> {{t 'machine.driverExoscale.portHelp.text'}}</p>
          {{/unless}}

          <div class="radio"><label>{{radio-button selection=this.whichSecurityGroup value="custom"}} {{t 'machine.driverExoscale.securityGroup.custom'}}</label></div>
          {{#if this.isCustomSecurityGroup}}
            <select class="form-control" onchange={{action (mut this.selectedSecurityGroup) value="target.value"}}>
              {{#each this.allSecurityGroups as |choice|}}
                <option value={{choice.name}} selected={{eq this.selectedSecurityGroup choice.name}}>{{choice.name}}</option>
              {{/each}}
            </select>

            <p style="r-m0 r-mt10">{{t 'machine.driverExoscale.needs.label' appName=this.settings.appName}}</p>
            <ul>
              <li>{{format-html-message 'machine.driverExoscale.needs.item1' appName=this.settings.appName}}</li>
              <li>{{format-html-message 'machine.driverExoscale.needs.item2' appName=this.settings.appName}}</li>
              <li>{{format-html-message 'machine.driverExoscale.needs.item3' appName=this.settings.appName}}</li>
            </ul>
          {{/if}}
        {{else}}
          <div class="form-control-static">
            {{this.exoscaleConfig.securityGroup}}
          </div>
        {{/if}}
      </div>
    </div>
  </div>
  {{#if this.isStep5}}
    {{top-errors errors=this.errors}}

    <div class="footer-actions">
      <button {{action "selectSecurityGroup"}} class="btn btn-primary">{{t 'machine.driverExoscale.selectSecurityGroupAction'}}</button>
      <button {{action "cancel"}} class="btn btn-link">{{t 'generic.cancel'}}</button>
    </div>
  {{/if}}
</section>

<section class="horizontal-form {{unless this.isStep6 'hide'}}" style="padding-top: 0">
  <div class="text-center">
    <i class="icon icon-spinner icon-spin"></i>
    {{#if this.defaultSecurityGroup}}
      {{t 'machine.driverExoscale.securityGroup.updating'}}
    {{else}}
      {{t 'machine.driverExoscale.securityGroup.creating'}}
    {{/if}}
  </div>
</section>

<section class="horizontal-form r-pt0 {{unless this.isStep7 'hide'}}">
  <div class="text-center">
    <i class="icon icon-spinner icon-spin"></i> {{t 'machine.driverExoscale.loadingInstance'}}
  </div>
</section>

<section class="horizontal-form r-pt0 {{unless this.isGteStep8 'hide'}}">
  <div class="container-fluid">
    <div class="over-hr r-mt20 r-mb20">
      <span>{{t 'machine.driverExoscale.instanceSection'}}</span>
    </div>

    {{partial "host/add-common"}}

    <div class="row form-group">
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverExoscale.instanceProfile.label'}}</label>
      </div>
      <div class="col-md-4">
        <select class="form-control" onchange={{action (mut this.exoscaleConfig.instanceProfile) value="target.value"}}>
          {{#each this.allInstanceProfiles as |choice|}}
            <option value={{choice.name}} selected={{eq this.exoscaleConfig.instanceProfile choice.name}}>{{choice.displaytext}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverExoscale.diskSize.label'}}</label>
      </div>
      <div class="col-md-4">
        {{input type="number" classNames="form-control" min=10 max=1600 step=10 value=this.exoscaleConfig.diskSize}}
      </div>
    </div>

    <div class="row form-group">
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverExoscale.template.label'}}</label>
      </div>
      <div class="col-md-4">
        <select class="form-control" onchange={{action (mut this.exoscaleConfig.template) value="target.value"}}>
          {{#each this.allTemplates as |choice|}}
            <option value={{choice}} selected={{eq this.exoscaleConfig.template choice}}>{{choice}}</option>
          {{/each}}
        </select>
      </div>
      <div class="col-md-2 form-label">
        <label class="form-control-static">{{t 'machine.driverExoscale.sshUser.label'}}</label>
      </div>
      <div class="col-md-4">
        {{input type="text" classNames="form-control" placeholder=(t 'machine.driverExoscale.sshUser.placeholder') value=this.exoscaleConfig.sshUser}}
      </div>
    </div>

    {{partial "host/add-options"}}
  </div>

  {{top-errors errors=this.errors}}
  {{save-cancel save="save" cancel="cancel"}}
</section>
