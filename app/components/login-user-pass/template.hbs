<form {{action "authenticate" on="submit"}} class="text-left login-credentials-form" data-testid="login-credentials-form">
  <div class="form-group">
    <label for="login-username">{{t 'loginUserPass.userLabel'}}</label>
    <div>
      {{input id="login-username" type="text" class="form-control login-user" value=this.username autocomplete="username" autocapitalize="none" spellcheck="false" placeholder=(t 'loginUserPass.userPlaceholder')}}
    </div>
  </div>

  <div class="form-group">
    <label for="login-password">{{t 'loginUserPass.passwordLabel'}}</label>
    <div class="login-password-field">
      {{input id="login-password" type=(if this.showPassword "text" "password") class="form-control login-pass" value=this.password autocomplete="current-password"}}
      <button type="button"
              class="login-password-toggle {{if this.showPassword 'is-revealed'}}"
              aria-pressed="{{if this.showPassword 'true' 'false'}}"
              aria-label="{{if this.showPassword (t 'loginUserPass.hidePasswordLabel') (t 'loginUserPass.showPasswordLabel')}}"
              title="{{if this.showPassword (t 'loginUserPass.hidePasswordLabel') (t 'loginUserPass.showPasswordLabel')}}"
              data-testid="login-password-toggle"
              {{action "togglePasswordVisibility"}}>
        <svg class="login-password-eye" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
          <path d="M1.5 9s2.8-4.5 7.5-4.5S16.5 9 16.5 9 13.7 13.5 9 13.5 1.5 9 1.5 9Z"></path>
          <circle cx="9" cy="9" r="2.2"></circle>
          <path class="login-password-eye-slash" d="m2.6 2.6 12.8 12.8"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="login-submit-row">
    <button type="submit" disabled={{this.waiting}} class="btn btn-primary btn-block" data-testid="login-submit">
      {{#if this.waiting}}
        <i class="icon icon-spinner icon-spin"></i> {{t 'loginUserPass.loggingInLabel'}}
      {{else}}
        {{t 'loginUserPass.loginLabel'}}
      {{/if}}
    </button>
  </div>
</form>
