<a class="dropdown-toggle hand btn btn-sm btn-link lang-select" data-toggle="dropdown" aria-expanded="false">
  <i class="icon icon-globe"></i> {{this.selectedLabel}} <i class="icon icon-chevron-down"></i>
</a>
<ul class="dropdown-menu dropdown-menu-right text-right" role="menu">
  <li><a href="https://github.com/PastureStack/web-console/issues" target="_blank" rel="noopener noreferrer">{{t 'languageContribute'}}</a></li>
  <li class="divider"></li>
  {{#each-in this.locales as |lang label|}}
    <li class="{{if (eq this.selected lang) 'disabled selected'}}">
      <a {{action 'selectLanguage' lang}}>
        {{label}}
      </a>
    </li>
  {{/each-in}}
</ul>
