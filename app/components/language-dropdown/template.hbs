<button type="button" class="dropdown-toggle hand btn btn-sm btn-link lang-select" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
  <span class="lang-select-label"><i class="icon icon-globe"></i> <span>{{this.selectedLabel}}</span></span>
  <i class="icon icon-chevron-down" aria-hidden="true"></i>
</button>
<ul class="dropdown-menu dropdown-menu-end text-right" role="menu">
  <li><a href="https://github.com/PastureStack/web-console/issues" target="_blank" rel="noopener noreferrer">{{t 'languageContribute'}}</a></li>
  <li class="divider"></li>
  {{#each-in this.locales as |lang label|}}
    <li class="{{if (eq this.selected lang) 'disabled selected'}}">
      <a {{action 'selectLanguage' lang}}>
        {{label}}
      </a>
    </li>
  {{/each-in}}
</ul>
