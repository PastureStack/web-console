<h3>{{t 'hostsPage.hostPage.storageTab.bulkRemove.title'}}</h3>

<p>
  {{t 'hostsPage.hostPage.storageTab.bulkRemove.summary' count=this.volumes.length}}
</p>

<div class="alert alert-warning">
  {{t 'hostsPage.hostPage.storageTab.bulkRemove.warning'}}
</div>

{{#unless this.isComplete}}
  <div class="volume-bulk-remove-preview">
    <strong>{{t 'hostsPage.hostPage.storageTab.bulkRemove.preview'}}</strong>
    <ul>
      {{#each this.previewVolumes as |volume|}}
        <li>{{volume.displayName}}</li>
      {{/each}}
    </ul>
    {{#if this.additionalCount}}
      <div class="text-muted">
        {{t 'hostsPage.hostPage.storageTab.bulkRemove.additional' count=this.additionalCount}}
      </div>
    {{/if}}
  </div>
{{/unless}}

{{#if this.isRunning}}
  <div class="volume-bulk-remove-progress" role="status" aria-live="polite">
    <i class="icon icon-spinner icon-spin"></i>
    {{t 'hostsPage.hostPage.storageTab.bulkRemove.progress' completed=this.completedCount total=this.volumes.length}}
  </div>
{{else if this.isComplete}}
  <div class="alert alert-success" role="status">
    {{t 'hostsPage.hostPage.storageTab.bulkRemove.complete' success=this.successful.length total=this.volumes.length}}
  </div>

  {{#if this.hasFailures}}
    <div class="alert alert-danger">
      {{t 'hostsPage.hostPage.storageTab.bulkRemove.failed' count=this.failed.length}}
      <ul>
        {{#each this.failed as |item|}}
          <li>{{item.name}}</li>
        {{/each}}
      </ul>
    </div>
  {{/if}}

  <div class="footer-actions">
    <button {{action "close"}} class="btn btn-primary">
      {{t 'hostsPage.hostPage.storageTab.bulkRemove.close'}}
    </button>
  </div>
{{else}}
  <div class="footer-actions">
    <button {{action "confirm"}} class="btn btn-danger">
      {{t 'hostsPage.hostPage.storageTab.bulkRemove.confirm' count=this.volumes.length}}
    </button>
    <button {{action "cancel"}} class="btn btn-link">
      {{t 'hostsPage.hostPage.storageTab.bulkRemove.cancel'}}
    </button>
  </div>
{{/if}}
