<td data-title="{{t 'generic.state'}}:" class="state">
  {{badge-state model=this.model}}
</td>
<td data-title="{{t 'registryRow.address'}}:">
  {{this.model.displayAddress}}
</td>
<td data-title="{{t 'registryRow.username'}}:">
  {{#if this.model.credential.publicValue}}{{this.model.credential.publicValue}}{{else}}<i class="text-muted">{{t 'generic.none'}}</i>{{/if}}
</td>
<td data-title="{{t 'registryRow.created'}}:">
  {{date-calendar this.model.created}}
</td>
<td data-title="{{t 'generic.actions'}}:" align="actions">
  {{action-menu model=this.model}}
</td>
