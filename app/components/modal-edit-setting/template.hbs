<section class="header">
  <h1>{{t 'modalEditSetting.title'}}</h1>
</section>
<section class="horizontal-form container-fluid">
  <div class="row form-group">
    <label>{{t 'modalEditSetting.name.label'}}</label>
    <div class="form-control-static text-mono">{{this.model.key}}</div>
    <p class="help-block">{{this.model.description}}</p>
  </div>

  <div class="row form-group">
    <label>{{t 'modalEditSetting.value.label'}}</label>
    <div>
      {{#if (eq this.model.kind 'multiline')}}
        {{textarea class="form-control" value=this.value rows=10}}
      {{else if (eq this.model.kind 'int')}}
        {{input-integer value=this.value class="form-control"}}
      {{else if (eq this.model.kind 'boolean')}}
        <div class="radio">
          <label>{{radio-button selection=this.value value="true"}} {{t 'schema.inputBoolean.y'}}</label>
        </div>
        <div class="radio">
          <label>{{radio-button selection=this.value value="false"}} {{t 'schema.inputBoolean.n'}}</label>
        </div>
      {{else if (eq this.model.kind 'enum')}}
        <select class="form-control" onchange={{action (mut this.value) value="target.value"}}>
          {{#each this.model.options as |choice|}}
            <option value="{{choice}}" selected={{eq choice this.value}}>{{choice}}</option>
          {{/each}}
        </select>
      {{else}}
        {{input type="text" value=this.value class="form-control"}}
      {{/if}}
    </div>
  </div>
</section>

{{#save-cancel editing=true saveDisabled=this.removing save="save" cancel="cancel"}}
  {{#if this.model.canDelete}}
    <button {{action "remove"}} class="btn btn-success">{{t 'modalEditSetting.reset.label'}}</button>
  {{/if}}
{{/save-cancel}}
