<td data-title="{{t 'generic.state'}}:" >
  {{badge-state model=this.model}}
</td>
<td data-title="{{t 'generic.id'}}:" >
  {{this.model.id}}
</td>
<td data-title="{{t 'accountsPage.index.table.kind'}}:" >
  {{t (concat-str 'model.account.kind.' this.model.kind character='')}}
</td>
{{#if this.isLocal}}
  <td data-title="{{t 'accountsPage.index.table.username'}}:" >
    {{#if this.model.username}}
      {{this.model.username}}
    {{else}}
      <span class="text-muted">{{t 'accountsPage.index.table.noName'}}</span>
    {{/if}}
  </td>
  <td data-title="{{t 'generic.name'}}:" class="force-wrap">
    {{this.model.displayName}}
  </td>
{{else}}
  <td data-title="{{t 'accountsPage.index.table.identity'}}" >
    {{#if (and this.model.externalId this.model.externalIdType)}}
      {{identity-block externalIdType=this.model.externalIdType externalId=this.model.externalId}}
    {{else}}
      <span class="text-muted">{{t 'accountsPage.index.table.noName'}}</span>
    {{/if}}
  </td>
{{/if}}
<td data-title="{{t 'generic.actions'}}:" class="actions">
  <LinkTo @route="admin-tab.auth.mfa" @query={{hash accountId=this.model.id}} class="btn btn-xs btn-default account-row-manage-mfa" data-testid="account-row-manage-mfa" title={{t 'authPage.mfa.manageAccount' account=this.model.displayName}}>
    <i class="icon icon-shield"></i>
    <span class="sr-only">{{t 'authPage.mfa.manageAccount' account=this.model.displayName}}</span>
  </LinkTo>
  {{action-menu model=this.model}}
</td>
