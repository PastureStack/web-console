{{yield 'header'}}
{{#if model.isUpstreamFirstParty}}
  <div class="badge-pasturestack">
    <strong>{{model.upstreamFirstPartyBadge}}</strong>
  </div>
{{else}}
  {{#if model.certified}}
    <div class="{{model.certifiedClass}}">
      <strong>{{model.certified}}</strong>
    </div>
  {{/if}}
{{/if}}
{{#if showIcon}}
  <div class="catalog-icon">
    <img src="{{model.links.icon}}"/>
  </div>
{{/if}}
<div class="itemwrap">
  <h5>
    {{model.localizedName}}
  </h5>
  {{#if showSource}}
    <span class="small">{{t 'catalogBox.sourcePrefix'}} <span class="text-capitalize">{{model.catalogId}}</span></span>
  {{/if}}
  {{#if showDescription}}
    <hr class="r-m10" />
    <div class="r-mt10 description">{{model.localizedDescription}}</div>
  {{/if}}
</div>
<div class="footer">
  {{yield 'footer'}}
</div>
