{{yield 'header'}}
{{#if this.model.isUpstreamFirstParty}}
  <div class="badge-pasturestack">
    <strong>{{this.model.catalogBrandBadge}}</strong>
  </div>
{{else}}
  {{#if this.model.certified}}
    <div class="{{this.model.certifiedClass}}">
      <strong>{{this.model.certified}}</strong>
    </div>
  {{/if}}
{{/if}}
{{#if this.showIcon}}
  <div class="catalog-icon">
    <img src="{{this.model.links.icon}}" />
  </div>
{{/if}}
<div class="itemwrap">
  <h5>
    {{this.model.catalogDisplayName}}
  </h5>
  {{#if this.showSource}}
    <span class="small">{{t 'catalogBox.sourcePrefix'}} <span class="text-capitalize">{{this.model.catalogId}}</span></span>
  {{/if}}
  {{#if this.showDescription}}
    <hr class="r-m10" />
    <div class="r-mt10 description">{{this.model.localizedDescription}}</div>
  {{/if}}
</div>
<div class="footer">
  {{yield 'footer'}}
</div>
