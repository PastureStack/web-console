<div class="row form-group">
  <div class="col-md-6 col-md-offset-3">
    <div class="form-label form-control-static">
      <label>{{t 'newReceiver.payloadFormat.label'}}</label>
    </div>
    <div>
      {{new-select
        classNames="form-control"
        content=this.payloadFormatChoices
        localizedLabel=true
        value=this.model.payloadFormat
      }}
    </div>
  </div>
</div>

{{#if (eq this.model.payloadFormat 'alicloud')}}
  <div class="row form-group">
    <div class="col-md-6 col-md-offset-3">
      <div class="form-label form-control-static">
        <label>{{t 'newReceiver.addressType.label'}}</label>
      </div>
      <div>
        {{new-select
          classNames="form-control"
          content=this.addressTypeChoices
          localizedLabel=true
          value=this.model.addressType
        }}
      </div>
    </div>
  </div>
{{/if}}

<div class="row form-group">
  <div class="col-md-6 col-md-offset-3">
    <div class="form-label form-control-static">
      <label>{{t 'newReceiver.tag.label'}}*</label>
    </div>
    <div>
      {{input type="text" class="form-control" value=this.model.tag}}
    </div>
    <p class="help-block">{{t 'newReceiver.tag.help'}}</p>
  </div>
</div>

<div class="row form-group">
  <div class="col-md-6 col-md-offset-3">
    <div class="form-label form-control-static">
      <label>{{t 'newReceiver.serviceSelector.label'}}*</label>
    </div>
    <div>
      {{form-key-value
        initialMap=this.model.serviceSelector
        changed=(action (mut this.model.serviceSelector))
        addActionLabel="newReceiver.serviceSelector.addActionLabel"
        allowEmptyValue=true
      }}
      <p class="help-block">{{t 'newReceiver.serviceSelector.help'}}</p>
    </div>
  </div>
</div>

<div class="row form-group">
  <div class="col-md-6 col-md-offset-3">
    <div class="form-label form-control-static">
      <label>{{t 'formUpgrade.size'}}</label>
    </div>
    <div>
      {{input-integer min="1" class="form-control" value=this.model.batchSize}}
    </div>
  </div>
</div>

<div class="row form-group">
  <div class="col-md-6 col-md-offset-3">
    <div class="form-label form-control-static">
      <label>{{t 'formUpgrade.interval'}}</label>
    </div>
    <div class="input-group">
      {{input-integer class="form-control" value=this.model.intervalMillis}}
      <span class="input-group-addon">{{t 'formUpgrade.sec'}}</span>
    </div>
  </div>
</div>

<div class="row form-group">
  <div class="col-md-6 col-md-offset-3">
    <div class="form-label form-control-static">
      <label>{{t 'formUpgrade.behavior'}}</label>
    </div>
    <div class="form-control-static">
      <label class="checkbox r-ml20" style="color: inherit; text-transform: none;">{{input type="checkbox" checked=this.model.startFirst}} {{t 'formUpgrade.startStop'}}</label>
    </div>
  </div>
</div>
