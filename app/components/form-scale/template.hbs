{{#if this.editing}}
  <div class="row">
    <div class="col-xs-12 form-label">
      <label class="form-control-static">{{t 'formScale.label'}}</label>
    </div>
  </div>

  <div class="row form-group">
    {{#if this.isGlobal}}
      <div class="col-sm-12 col-md-12">
        <span class="text-muted">{{t (if this.isVm 'formScale.global.vm' 'formScale.global.container')}}</span>
      </div>
    {{else}}
      <div class="col-sm-2 col-md-2">
        {{format-number this.scale}}
      </div>
      <div class="col-sm-10 col-md-10">
        {{input-slider value=this.scale valueMax=this.max scaleMax=this.oneLouder}}
      </div>
    {{/if}}
  </div>
{{else}}
  <div class="row">
    <div class="col-xs-12 form-label">
      <label class="form-control-static">{{t 'formScale.label'}}</label>
    </div>
  </div>
  <div class="row">
    <div class="col-sm-3 col-md-3">
      <div class="radio">
        <label>{{radio-button selection=this.isGlobal value=false}} {{t (if this.isVm 'formScale.regular.vm' 'formScale.regular.container') scale=this.scale}}</label>
      </div>
    </div>
    <div class="col-sm-9 col-md-9">
      {{input-slider value=this.scale valueMax=this.max scaleMax=this.oneLouder disabled=this.isGlobal}}
    </div>
  </div>
  <div class="row">
    <div class="col-sm-12 col-md-12">
      <div class="radio">
        <label>{{radio-button selection=this.isGlobal value=true}} {{t (if this.isVm 'formScale.global.vm' 'formScale.global.container')}}</label>
      </div>
    </div>
  </div>
{{/if}}
