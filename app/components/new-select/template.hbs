{{#if this.prompt}}
  <option selected={{not this.selection}}>
    {{t this.prompt}}
  </option>
{{/if}}

{{#each this.ungroupedContent as |item|}}
  <option value="{{get item this.optionValuePath}}" selected={{eq this.value (get item this.optionValuePath)}} disabled={{get item this.optionDisabledPath}}>
    {{#if this.localizedLabel}}
      {{t (get item this.optionLabelPath)}}
    {{else}}
      {{get item this.optionLabelPath}}
    {{/if}}
  </option>
{{/each}}

{{#each this.groupedContent as |group|}}
  <optgroup label="{{group.group}}">
    {{#each group.options as |item|}}
      <option value="{{get item this.optionValuePath}}" selected={{eq this.value (get item this.optionValuePath)}} disabled={{get item this.optionDisabledPath}}>
        {{#if this.localizedLabel}}
          {{t (get item this.optionLabelPath)}}
        {{else}}
          {{get item this.optionLabelPath}}
        {{/if}}
      </option>
    {{/each}}
  </optgroup>
{{/each}}
