<td data-title="{{t 'generic.state'}}">
  {{badge-state model=this.model}}
</td>
<td data-title="{{t 'generic.name'}}">
  {{this.model.displayName}}
</td>
<td data-title="{{t 'hookPage.fields.kind.label'}}">
  {{this.model.displayKind}}
</td>
<td data-title="{{t 'hookPage.fields.detail.label'}}">
  {{#if (eq this.model.driver 'scaleService')}}
    {{t 'hookPage.scaleService.detailPrefix' displayService=this.model.displayService action=this.model.opt.action amount=this.model.opt.amount}}
    <a href="{{href-to "service" this.model.service.stack.id this.model.service.id}}">{{t 'hookPage.scaleService.detailLink' displayService=this.model.displayService action=this.model.opt.action amount=this.model.opt.amount}}</a>
    {{t 'hookPage.scaleService.detailSuffix' displayService=this.model.displayService action=this.model.opt.action amount=this.model.opt.amount}}
  {{else if (eq this.model.driver 'scaleHost')}}
    {{t 'hookPage.scaleHost.detail' labels=this.model.opt.hostSelectorStr action=this.model.opt.action amount=this.model.opt.amount}}
  {{else if (eq this.model.driver 'serviceUpgrade')}}
    {{format-html-message 'hookPage.serviceUpgrade.detail' labels=this.model.opt.serviceSelectorStr tag=this.model.opt.tag}}
  {{/if}}
</td>
<td data-title="{{t 'hookPage.fields.url.label'}}">
  {{copy-to-clipboard clipboardText=this.model.url size="small"}}
</td>
<td data-title="{{t 'generic.actions'}}" class="actions">
  {{action-menu model=this.model showPrimary=this.showPrimaryActions}}
</td>
