{{top-errors errors=this.errors}}

<h2>{{t (if this.editing 'modalEditBackup.edit' 'modalEditBackup.create')}}</h2>

<div class="form-group">
  <label>{{t 'modalEditBackup.nameLabel'}}*</label>
  {{input class="form-control" value=this.backupName }}
</div>

<div class="form-group">
  <label>{{t 'modalEditBackup.backupTarget'}}*</label>
    {{new-select
      classNames="form-control"
      prompt="modalEditBackup.backupTargetPlaceholder"
      content=this.backupTargets
      optionValuePath="id"
      optionLabelPath="name"
      value=this.backupTarget
    }}
</div>


{{save-cancel editing=this.editing save="saveBackup" cancel="cancel"}}
