{{#if this.projects.current.isWindows}}
  <div class="text-center r-p20">{{t 'formVolumes.windowsUnsupported'}}</div>
{{else}}
  <div class="row form-group">
    <div class="col-sm-12 col-md-2 form-label">
      <label class="form-control-static">{{t 'formVolumes.volumes'}}</label>
    </div>

    <div class="col-sm-12 col-md-8">
      <div class="form-control-static">
        <button class="btn-circle-text" {{action "addVolume"}}><i class="icon icon-plus-circle"/> <span>{{t 'formVolumes.addActionLabel'}}</span></button>
      </div>
      {{#if this.volumesArray.length}}
        <table class="table fixed no-lines no-top-padding tight">
          {{#each this.volumesArray as |vol|}}
            <tr>
              <td>
                {{volume-path-autocomplete
                  value=vol.value
                  suggestions=this.volumePathSuggestions
                  placeholder=(t 'formVolumes.pathPlaceholder')
                  changed=(action "volumeValueChanged" vol)
                }}
              </td>
              <td width="30" class="text-right">
                <button class="btn btn-primary btn-sm" {{action "removeVolume" vol}}><i class="icon icon-minus"/></button>
              </td>
            </tr>
          {{/each}}
        </table>
      {{/if}}
      {{#if this.volumeWarnings.length}}
        <ul class="volume-validation-warnings text-warning">
          {{#each this.volumeWarnings as |warning|}}<li>{{warning}}</li>{{/each}}
        </ul>
      {{/if}}
      {{#if this.preflightMessage}}
        <div class="volume-preflight-summary is-{{this.preflightStatus}}" role="status" aria-live="polite">
          {{#if (eq this.preflightStatus "checking")}}<i class="icon icon-spinner icon-spin" aria-hidden="true"></i>
          {{else if (eq this.preflightStatus "available")}}<i class="icon icon-check" aria-hidden="true"></i>
          {{else}}<i class="icon icon-alert" aria-hidden="true"></i>{{/if}}
          <span>{{this.preflightMessage}}</span>
        </div>
      {{/if}}
      {{#if this.preflightIssueMessages.length}}
        <ul class="volume-preflight-issues">
          {{#each this.preflightIssueMessages as |issue|}}
            <li class={{issue.className}}>{{issue.text}}</li>
          {{/each}}
        </ul>
      {{/if}}
    </div>
  </div>

  {{#if this.isService}}
    <div class="row form-group">
      <div class="col-sm-12 col-md-2 form-label">
        <label class="form-control-static">{{t 'formVolumes.volumesFrom'}}</label>
      </div>

      <div class="col-sm-12 col-md-8 form-control-static">
        {{#if this.volumesFromLaunchConfigChoices.length}}
          {{#each this.volumesFromLaunchConfigChoices as |choice|}}
            <label class="r-mr10 radio small" style="color: inherit; text-transform: none;">{{input type="checkbox" checked=choice.enabled}} {{choice.displayName}}</label>
          {{/each}}
        {{else}}
          <span class="text-muted">{{t 'formVolumes.noLaunchConfigs'}}</span>
        {{/if}}
      </div>
    </div>
  {{else}}
    <div class="row form-group">
      <div class="col-sm-12 col-md-2 form-label">
        <label class="form-control-static">{{t 'formVolumes.volumesFrom'}}</label>
      </div>

      <div class="col-sm-12 col-md-8">
        <div class="form-control-static">
          {{#if this.instance.requestedHostId}}
            {{#if this.hostContainerChoices.length}}
              <button class="btn-circle" {{action "addVolumeFrom"}}><i class="icon icon-plus-circle"/></button>
            {{else}}
              <span class="text-muted">{{t 'formVolumes.noHostContainers'}}</span>
            {{/if}}
          {{else}}
              <span class="text-muted">{{t 'formVolumes.onlySingleHost'}}</span>
          {{/if}}
        </div>
        {{#if this.volumesFromArray.length}}
          <table class="table fixed no-lines no-top-padding tight">
            {{#each this.volumesFromArray as |vol|}}
              <tr>
                <td>
                  {{new-select
                    classNames="form-control input-sm volumefrom-container"
                    prompt="formVolumes.value.prompt"
                    value=vol.value
                    content=this.hostContainerChoices
                    optionValuePath="id"
                    optionLabelPath="name"
                    optionGroupPath="group"
                  }}
                </td>
                <td width="30" class="text-right">
                  <button class="btn btn-primary btn-sm" {{action "removeVolumeFrom" vol}}><i class="icon icon-minus"/></button>
                </td>
              </tr>
            {{/each}}
          </table>
        {{/if}}
      </div>
    </div>
  {{/if}}

  <div class="row form-group">
    <div class="col-sm-12 col-md-2 form-label">
      <label for="volumeDriver" class="form-control-static">{{t 'formVolumes.volumeDriver.label'}}</label>
    </div>

    <div class="col-sm-12 col-md-8">
      {{new-select
        classNames="form-control"
        content=this.storageDriverChoices
        value=this.instance.volumeDriver
        action=(action "driverChanged")
        optionValuePath="value"
        optionLabelPath="label"
        optionDisabledPath="disabled"
      }}
      {{#if this.selectedDriverChoice.detail}}
        <div class="volume-driver-option-detail">{{this.selectedDriverChoice.detail}}</div>
      {{/if}}
    </div>
  </div>
{{/if}}
