<td><div class="form-control-static input-sm">{{t 'schedulingRuleRow.theHost'}}</div></td>
<td>
  {{#if this.editing}}
    {{new-select
      classNames="form-control input-sm"
      content=this.schedulingRuleSuffixChoices
      localizedLabel=true
      value=this.suffix
    }}
  {{else}}
    <div><strong>{{this.getSuffixLabel}}</strong></div>
  {{/if}}
</td>
<td><div class="form-control-static text-center input-sm">{{t 'schedulingRuleRow.haveA'}}</div></td>
<td>
  {{#if this.editing}}
    {{new-select
      classNames="form-control input-sm"
      content=this.schedulingRuleKindChoices
      localizedLabel=true
      value=this.kind
    }}
  {{else}}
    <div><strong>{{this.kind}}</strong></div>
  {{/if}}
</td>
<td>
  {{#if (not (or (eq this.kind "service_name") (eq this.kind "container_name")))}}
    <div class="form-control-static text-center input-sm">{{t 'schedulingRuleRow.of'}}</div>
  {{/if}}
</td>
<td>
  {{#if (eq this.kind "host_label")}}
    {{#if this.editing}}
      <div class="input-group">
        {{input type="text" class="form-control input-sm" value=this.userKey}}
        <div class="input-group-btn">
          <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="icon icon-chevron-down"></i></button>
          <ul class="dropdown-menu dropdown-menu-right" role="menu">
            {{#each this.hostLabelKeyChoices as |key|}}
              <li><a {{action "setKey" key}}>{{key}}</a></li>
            {{/each}}
          </ul>
        </div>
      </div>
    {{else}}
      <div><strong>{{this.userKey}}</strong></div>
    {{/if}}
  {{/if}}
  {{#if (eq this.kind "container_label")}}
    {{#if this.editing}}
      <div class="input-group">
        {{input type="text" class="form-control input-sm" value=this.userKey}}
        <div class="input-group-btn">
          <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="icon icon-chevron-down"></i></button>
          <ul class="dropdown-menu dropdown-menu-right" role="menu">
            {{#each this.containerLabelKeyChoices as |key|}}
              <li><a {{action "setKey" key}}>{{key}}</a></li>
            {{/each}}
          </ul>
        </div>
      </div>
    {{else}}
      <div><strong>{{this.userKey}}</strong></div>
    {{/if}}
  {{/if}}
</td>
<td>
  {{#if (not (or (eq this.kind "service_name") (eq this.kind "container_name")))}}
    <div class="form-control-static text-center input-sm">=</div>
  {{/if}}
</td>
<td>
  {{#if (eq this.kind "host_label")}}
    {{#if this.editing}}
      <div class="{{if this.hostLabelValueChoices 'input-group'}}">
        {{input type="text" class="form-control input-sm" value=this.userValue}}
        {{#if this.hostLabelValueChoices.length}}
          <div class="input-group-btn">
            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="icon icon-chevron-down"></i></button>
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
              {{#each this.hostLabelValueChoices as |value|}}
                <li><a {{action "setValue" value}}>{{value}}</a></li>
              {{/each}}
            </ul>
          </div>
        {{/if}}
      </div>
    {{else}}
      <div><strong>{{this.userValue}}</strong></div>
    {{/if}}
  {{/if}}
  {{#if (eq this.kind "container_label")}}
    {{#if this.editing}}
      <div class="{{if this.containerLabelValueChoices 'input-group'}}">
        {{input type="text" class="form-control input-sm" value=this.userValue}}
        {{#if this.containerLabelValueChoices.length}}
          <div class="input-group-btn">
            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="icon icon-chevron-down"></i></button>
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
              {{#each this.containerLabelValueChoices as |value|}}
                <li><a {{action "setValue" value}}>{{value}}</a></li>
              {{/each}}
            </ul>
          </div>
        {{/if}}
      </div>
    {{else}}
      <div><strong>{{this.userValue}}</strong></div>
    {{/if}}
  {{/if}}
  {{#if (eq this.kind "service_name")}}
    {{#if this.editing}}
      <div class="{{if this.serviceValueChoices 'input-group'}}">
        {{input type="text" class="form-control input-sm" value=this.userValue}}
         {{#if this.serviceValueChoices.length}}
          <div class="input-group-btn">
            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="icon icon-chevron-down"></i></button>
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
              {{#each this.serviceValueChoices as |value|}}
                <li><a {{action "setValue" value}}>{{value}}</a></li>
              {{/each}}
            </ul>
          </div>
        {{/if}}
      </div>
    {{else}}
      <div><strong>{{this.userValue}}</strong></div>
    {{/if}}
  {{/if}}
  {{#if (eq this.kind "container_name")}}
    {{#if this.editing}}
      <div class="{{if this.containerValueChoices 'input-group'}}">
        {{input type="text" class="form-control input-sm" value=this.userValue}}
         {{#if this.containerValueChoices.length}}
          <div class="input-group-btn">
            <button type="button" class="btn btn-default btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false"><i class="icon icon-chevron-down"></i></button>
            <ul class="dropdown-menu dropdown-menu-right" role="menu">
              {{#each this.containerValueChoices as |value|}}
                <li><a {{action "setValue" value}}>{{value}}</a></li>
              {{/each}}
            </ul>
          </div>
        {{/if}}
      </div>
    {{else}}
      <div><strong>{{this.userValue}}</strong></div>
    {{/if}}
  {{/if}}
</td>
{{#if this.editing}}
  <td class="text-right">
    <button class="btn btn-primary btn-sm" {{action "remove"}}><i class="icon icon-minus"/></button>
  </td>
{{/if}}
