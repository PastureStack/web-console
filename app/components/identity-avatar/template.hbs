{{yield}}
{{#if this.avatarSrc}}
  {{#if (and this.url this.link)}}
    <a href="{{this.url}}" target="_blank">
      <img src="{{this.avatarSrc}}" width="{{this.size}}" height="{{this.size}}">
    </a>
  {{else}}
    <img src="{{this.avatarSrc}}" width="{{this.size}}" height="{{this.size}}">
  {{/if}}
{{else}}
  <div class="gh-placeholder"></div>
{{/if}}
