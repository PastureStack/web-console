<div>
  <h2>{{t 'modalAuditlogInfo.header'}}</h2>
  <hr>
</div>
<div class="r-mb15" style="max-height: 400px; overflow: auto;">
  <h3>{{t 'modalAuditlogInfo.request'}}</h3>
  <div style="max-height: 400px; overflow: auto;">
    {{#if this.requestDisplay.text}}
      {{#if this.requestDisplay.isJson}}
        {{code-block language="javascript" code=this.requestJSON}}
      {{else}}
        <pre data-testid="audit-request-plain-text">{{this.requestDisplay.text}}</pre>
      {{/if}}
    {{else}}
      <p class="text-muted">{{#if (eq this.requestDisplay.state 'unavailable')}}{{t 'modalAuditlogInfo.unavailable'}}{{else}}{{t 'modalAuditlogInfo.noContent'}}{{/if}}</p>
    {{/if}}
  </div>
</div>
<div class="r-mb15">
  <h3>{{t 'modalAuditlogInfo.response'}}</h3>
  <div style="max-height: 400px; overflow: auto;">
    {{#if this.responseDisplay.text}}
      {{#if this.responseDisplay.isJson}}
        {{code-block language="javascript" code=this.responseJSON}}
      {{else}}
        <pre data-testid="audit-response-plain-text">{{this.responseDisplay.text}}</pre>
      {{/if}}
    {{else}}
      <p class="text-muted">{{#if (eq this.responseDisplay.state 'unavailable')}}{{t 'modalAuditlogInfo.unavailable'}}{{else}}{{t 'modalAuditlogInfo.noContent'}}{{/if}}</p>
    {{/if}}
  </div>
</div>
<div class="footer-actions">
  <button class="btn btn-primary" {{action 'dismiss'}}>{{t 'generic.closeModal'}}</button>
</div>
