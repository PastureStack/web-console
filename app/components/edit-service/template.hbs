{{#if this.loading}}
  <div class="text-center">
    <p>
      <i class="icon icon-spinner icon-spin"></i> {{t 'generic.loading'}}
    </p>
  </div>
{{else}}
  <section class="horizontal-form container-fluid">
    <h2>{{t 'editService.title'}}</h2>

    {{form-scale
      editing=true
      initialLabels=this.service.launchConfig.labels
      initialScale=this.service.scale
      setScale=(action 'setScale')
    }}

    {{form-name-description
      model=this.service
      namePlaceholder="servicePage.new.form.name.placeholder"
      descriptionPlaceholder="servicePage.new.form.description.placeholder"
    }}

    {{form-service-links
      service=this.service
      changed=(action 'setServiceLinks')
    }}
  </section>

  {{top-errors errors=this.errors}}
  {{save-cancel editing=this.editing save="save" cancel="cancel"}}
{{/if}}
