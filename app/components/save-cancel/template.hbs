{{yield}}
{{#if this.saving}}
  <button class="btn btn-primary btn-disabled"><i class="icon icon-spinner icon-spin"></i> {{t 'saveCancel.saving'}}</button>
{{else}}
  <button {{action "save"}} disabled={{this.saveDisabled}} class="btn {{if this.saved 'btn-success' 'btn-primary'}}">
    {{t this.btnLabel}}
  </button>
{{/if}}
{{#unless this.cancelDisabled}}
  <button {{action "cancel"}} class="btn btn-link">{{t this.cancelLabel}}</button>
{{/unless}}
