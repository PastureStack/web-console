<tr>
  <td class="force-wrap">
    {{badge-state model=this.model}}
  </td>
  <td class="force-wrap">
    {{#link-to "container" this.model.id}}{{this.model.displayName}}{{/link-to}}
  </td>
  <td class="force-wrap">
    {{this.model.displayImage}}
  </td>
  <td class="actions">
    {{action-menu model=this.model}}
  </td>
</tr>
