<tr>
  <td class="force-wrap">
    {{badge-state model=this.model}}
  </td>
  <td class="force-wrap">
    <a href="#" {{action "toggleExpand"}}><i class="icon {{if this.expanded 'icon-minus-square' 'icon-plus-square'}}" /></a>
    <LinkTo @route="swarm-tab.projects.project" @model={{this.model.id}}>{{this.model.displayName}}</LinkTo>
  </td>
  <td>
    {{#if this.model.services.length}}
      {{this.model.services.length}}
    {{else}}
      <span class="text-muted">{{t 'generic.none'}}</span>
    {{/if}}
  </td>
  <td class="actions">
    {{action-menu model=this.model showPrimary=false}}
  </td>
</tr>
{{#if this.expanded}}
  <tr class="nohover">
    <td colspan="4" class="subtable">
      {{swarm/service-section model=this.model.unremovedServices}}
    </td>
  </tr>
{{/if}}
