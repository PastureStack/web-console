<tr>
  <td class="force-wrap" data-title="{{t 'swarm.serviceSection.state'}}:">
    {{badge-state model=this.model}}
  </td>
  <td class="force-wrap" data-title="{{t 'swarm.serviceSection.name'}}:">
    <a href="#" {{action "toggleExpand"}}><i class="icon {{if this.expanded 'icon-minus-square' 'icon-plus-square'}}" /></a>
    {{#link-to "service" this.model.stackId this.model.id}}{{this.model.displayName}}{{/link-to}}
  </td>
  <td class="force-wrap service-detail" data-title="{{t 'swarm.serviceSection.ports'}}:">
    {{this.model.displayPorts}}
  </td>
  <td class="force-wrap" data-title="{{t 'swarm.serviceSection.containers'}}:">
    {{#if this.model.instances.length}}
      {{this.model.instances.length}}
    {{else}}
      <span class="text-muted">{{t 'generic.none'}}</span>
    {{/if}}
  </td>
  <td class="actions" data-title="{{t 'generic.actions'}}:">
    {{action-menu model=this.model}}
  </td>
</tr>
{{#if this.expanded}}
  <tr class="nohover">
    <td colspan="5" class="subtable">
      {{swarm/container-section model=this.model.instances}}
    </td>
  </tr>
{{/if}}
