<section class="horizontal-form container-fluid">
  <h2>{{t 'editExternalService.title'}}</h2>
  {{top-errors errors=this.errors}}

  {{form-name-description
    model=this.service
    namePlaceholder="editExternalService.name.placeholder"
    descriptionPlaceholder="editExternalService.description.placeholder"
  }}

  {{form-target-ip
    service=this.service
  }}
</section>

{{save-cancel editing=this.editing save="save" cancel="cancel"}}
