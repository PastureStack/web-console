{{#if this.topLevel}}
  <tr class="{{if this.execution.exception 'danger' ''}}">
    <td class="clip">
      {{#if this.checkProcessHandlerExecutions }}
        <span {{action 'expand'}}>
          <i class="icon hand {{if this.expanded 'icon-minus-square' 'icon-plus-square'}}"></i>
        </span>
      {{/if}}
      {{#if this.execution.exception}}
        <span {{action 'showError' this.execution.exception}}>
          <i class="icon icon-alert hand"></i>
        </span>
      {{/if}}
      <span title={{this.execution.processName}}>{{this.execution.processName}}</span>
    </td>
    <td class="clip"><span title={{this.execution.resourceType}}>{{this.execution.resourceType}}:{{this.execution.resourceId}}</span></td>
    <td>{{this.execution.exitReason}}</td>
    {{#if this.execution.startTime}}
      <td>{{date-from-now this.execution.startTime}}</td>
    {{else}}
      <td></td>
    {{/if}}
    {{#if this.execution.stopTime}}
      <td>{{date-from-now this.execution.stopTime}}</td>
    {{else}}
      <td></td>
    {{/if}}
    <td>{{run-time this.execution.startTime this.execution.stopTime}}</td>
  </tr>
{{else}}
  {{#if (or this.expandSelf this.expanded)}}
    <tr class="{{if this.execution.exception 'danger' ''}}">
      <td class="clip">
        <i class="icon icon-level-down indent-{{this.depth}}"></i>
        {{#if this.execution.exception}}
          <span {{action 'showError' this.execution.exception}}>
            <i class="icon icon-alert hand"></i>
          </span>
        {{/if}}
        {{#if this.checkProcessHandlerExecutions }}
            <span {{action 'expand'}}>
              <i class="icon hand {{if this.expanded 'icon-minus-circle' 'icon-plus-circle'}}"></i>
            </span>
        {{/if}}
        <span title={{this.execution.processName}}>{{this.execution.processName}}</span>
      </td>
      <td class="clip"><span title={{this.execution.resourceType}}>{{this.execution.resourceType}}:{{this.execution.resourceId}}</span></td>
      <td>{{this.execution.exitReason}}</td>
      {{#if this.execution.startTime}}
        <td>{{date-from-now this.execution.startTime}}</td>
      {{else}}
        <td></td>
      {{/if}}
      {{#if this.execution.stopTime}}
        <td>{{date-from-now this.execution.stopTime}}</td>
      {{else}}
        <td></td>
      {{/if}}
      <td>{{run-time this.execution.startTime this.execution.stopTime}}</td>
    </tr>
  {{/if}}
{{/if}}
{{#if this.checkProcessHandlerExecutions }}
  {{#each this.execution.processHandlerExecutions as |processExe|}}
    {{process-execution-handler-rows execution=processExe nodeDepth=this.depth expandSelf=this.expanded expandAll=this.expandAll }}
  {{/each}}
{{/if}}
