{{#if (or this.expandSelf this.expanded)}}
  <tr class="{{if this.execution.exception 'danger' ''}}">
    <td class="clip">
      <i class="icon icon-level-down indent-{{this.depth}}"></i>
      {{#if this.execution.exception}}
        <span {{action 'showError' this.execution.exception}}>
          <i class="icon icon-alert hand"></i>
        </span>
      {{/if}}
      {{#if this.checkExecutions }}
        <span {{action 'expand'}}>
            <i class="icon hand {{if this.expanded 'icon-minus-circle' 'icon-plus-circle'}}"></i>
        </span>
      {{/if}}
      {{this.execution.name}}
    </td>
    <td>{{this.execution.resourceId}}</td>
    <td>{{this.execution.exitReason}}</td>
    <td>{{date-from-now this.execution.startTime}}</td>
    <td>{{date-from-now this.execution.stopTime}}</td>
    <td>{{run-time this.execution.startTime this.execution.stopTime}}</td>
  </tr>
{{#if this.checkExecutions }}
  {{#each this.execution.children as |child|}}
    {{#each child.executions as |execution|}}
      {{process-execution-rows execution=execution expandSelf=this.expanded nodeDepth=this.depth expandAll=this.expandAll}}
    {{/each}}
  {{/each}}
{{/if}}
{{/if}}
