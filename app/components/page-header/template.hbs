<nav class="navbar clearfix">
  <div class="container-fluid">
    <div class="navbar-header">
      <a role="button" class="navbar-toggler collapsed" data-bs-toggle="collapse" data-bs-target="#navbar" aria-controls="navbar" aria-expanded="false">
        <span class="sr-only">{{t 'nav.srToggleNav'}}</span>
        <i class="icon icon-ellipsis"></i>
      </a><!--
      --><ul class="nav">
        <li><button class="navbar-brand logo btn"></button></li><!--
          -->{{~page-header-environment
            currentPath=this.currentPath
            canEdit=this.canEdit
            switchProject="switchProject"
            switchNamespace="switchNamespace"
          ~}}
        </ul>
    </div>
    <div id="navbar" class="navbar-collapse collapse">
      <ul class="nav navbar-nav">
        {{#each this.navTree as |item|}}
          {{#if item.url}}
            <li>
              <a href="{{item.url}}" target="{{item.target}}">{{#if item.localizedLabel}}{{t item.localizedLabel}}{{else}}{{item.label}}{{/if}}</a>
            </li>
          {{else if item.submenu.length}}
            {{! Has a submenu }}
            <li class="dropdown">
              <LinkTo
                @route={{item.route}}
                @models={{item.ctx}}
                @query={{item.queryParams}}
                @current-when={{item.currentWhen}}
                class="dropdown-toggle"
                role="button"
                aria-haspopup="true"
                aria-expanded="false"
              >
                {{#if item.localizedLabel}}{{t item.localizedLabel}}{{else}}{{item.label}}{{/if}} <span class="icon icon-chevron-down hidden-sm hidden-xs"/>
              </LinkTo>
              <ul class="dropdown-menu" data-dropdown-id={{item.id}}>
                {{#each item.submenu as |subitem|}}
                  {{#if subitem.divider}}
                    <li class="divider"></li>
                  {{else if subitem.url}}
                    <li>
                      <a href="{{subitem.url}}" target="{{subitem.target}}">
                        <i class="{{subitem.icon}}"/> {{#if subitem.localizedLabel}}{{t subitem.localizedLabel}}{{else}}{{subitem.label}}{{/if}}
                      </a>
                    </li>
                  {{else if subitem.route}}
                    <li>
                      <LinkTo
                        @route={{subitem.route}}
                        @models={{subitem.ctx}}
                        @query={{subitem.queryParams}}
                        @current-when={{subitem.currentWhen}}
                      >
                        <i class="{{subitem.icon}}"/> {{#if subitem.localizedLabel}}{{t subitem.localizedLabel}}{{else}}{{subitem.label}}{{/if}}
                      </LinkTo>
                    </li>
                  {{else}}
                    {{! Just a label }}
                    <li class="dropdown-header">
                     <i class="{{subitem.icon}}"/> {{#if subitem.localizedLabel}}{{t subitem.localizedLabel}}{{else}}{{subitem.label}}{{/if}}
                    </li>
                  {{/if}}
                {{/each}}
              </ul>
              {{#if item.showAlert}}
                {{#tooltip-element class="tooltip-warning" type='tooltip-warning' tooltipFor="showAlert"}}
                  <LinkTo @route={{item.alertRoute}}>!</LinkTo>
                {{/tooltip-element}}
              {{/if}}
            </li>
          {{else if item.route}}
            {{! No submenu }}
            <li>
              <LinkTo
                @route={{item.route}}
                @models={{item.ctx}}
                @query={{item.queryParams}}
                @current-when={{item.currentWhen}}
              >
                {{#if item.localizedLabel}}{{t item.localizedLabel}}{{else}}{{item.label}}{{/if}}
              </LinkTo>
            </li>
          {{else}}
            {{! Just a label }}
            <li class="dropdown-header">
              {{#if item.localizedLabel}}{{t item.localizedLabel}}{{else}}{{item.label}}{{/if}}
            </li>
          {{/if}}
        {{/each}}
      </ul>

      <ul class="nav navbar-nav navbar-right">
        <li class="dropdown">{{page-header-user}}</li>
      </ul>
    </div>
  </div>
</nav>
{{#if (and this.projects.current (not this.hosts.length))}}
  <div class="lacsso banner bg-info m-0 p-0">
    <div class="lacsso banner-icon" style="width: 68px;"><span class="icon icon-2x icon-alert"></span></div>
    <div class="lacsso banner-message">
      <p class="lacsso mt-15 mb-15">
        {{~format-html-message (if this.projects.current.isWindows 'nav.noHostsWindows.prefix' 'nav.noHosts.prefix') appName=this.settings.appName docsBase=this.settings.docsBase minVersion=this.settings.minDockerVersion}}
        <a href="{{href-to 'hosts.new' this.projects.current.id}}">{{t (if this.projects.current.isWindows 'nav.noHostsWindows.link' 'nav.noHosts.link') appName=this.settings.appName docsBase=this.settings.docsBase minVersion=this.settings.minDockerVersion}}</a>
        {{format-html-message (if this.projects.current.isWindows 'nav.noHostsWindows.suffix' 'nav.noHosts.suffix') appName=this.settings.appName docsBase=this.settings.docsBase minVersion=this.settings.minDockerVersion~}}
      </p>
    </div>
  </div>
{{/if}}
{{#if this.projects.current.isUpgrading}}
  <div class="lacsso banner bg-warning m-0 p-0">
    <div class="lacsso banner-icon" style="width: 68px;"><span class="icon icon-2x icon-spinner icon-spin"></span></div>
    <div class="lacsso banner-message">
      <p class="lacsso mt-15 mb-15">
        {{format-html-message 'projectUpgrade.banner'}}
      </p>
    </div>
  </div>
{{/if}}
