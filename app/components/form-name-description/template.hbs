<div class="row form-group">
  <div class="col-md-6">
    <div class="form-label">
      <label class="form-control-static">{{t this.nameLabel}}{{if this.nameRequired '*'}}</label>
    </div>
    {{input type="text" value=this._name classNames="form-control" placeholder=(t this.namePlaceholder) disabled=this.nameDisabled}}
    {{#if this.nameHelpText}}<p class="help-block">{{this.nameHelpText}}</p>{{/if}}
  </div>

  <div class="col-md-6">
    {{#if this.descriptionShown}}
      <div class="form-label">
        <label class="form-control-static">{{t this.descriptionLabel}}{{if this.descriptionRequired '*'}}</label>
      </div>
      {{textarea-autogrow value=this._description classNames="form-control no-resize" rows="1" placeholder=this.descriptionPlaceholder disabled=this.descriptionDisabled}}
      {{#if this.descriptionHelp}}<p class="help-block">{{t this.descriptionHelp}}</p>{{/if}}
    {{else}}
      {{yield}}
    {{/if}}
  </div>
</div>

