<header class="console-workspace-titlebar" onmousedown={{action "startDrag"}} ondblclick={{action "titlebarDoubleClick"}}>
  <div class="console-workspace-window-title">
    {{#if entry.isLogs}}
      <i class="icon icon-file" aria-hidden="true"></i>
      <span>{{t 'consoleWorkspace.session.logs'}} — {{entry.resourceTitle}}</span>
    {{else if entry.isVm}}
      <i class="icon icon-vm" aria-hidden="true"></i>
      <span>{{t 'consoleWorkspace.session.vm'}} — {{entry.resourceTitle}}</span>
    {{else}}
      <i class="icon icon-terminal" aria-hidden="true"></i>
      <span>{{t 'consoleWorkspace.session.terminal'}} — {{entry.resourceTitle}}</span>
    {{/if}}
    <span class="console-workspace-status-dot status-{{entry.status}}" aria-hidden="true"></span>
  </div>

  <div class="console-workspace-window-actions">
    {{#if (and (not entry.isVm) (not-eq entry.status "ended"))}}
      <button type="button" {{action "terminate"}} title="{{t 'consoleWorkspace.window.terminate'}}" aria-label="{{t 'consoleWorkspace.window.terminate'}}">
        <i class="icon icon-stop" aria-hidden="true"></i>
      </button>
    {{/if}}
    <button type="button" {{action "minimize"}} title="{{t 'consoleWorkspace.window.minimize'}}" aria-label="{{t 'consoleWorkspace.window.minimize'}}">
      <i class="icon icon-minus" aria-hidden="true"></i>
    </button>
    <button type="button" {{action "toggleMaximize"}} title="{{if entry.maximized (t 'consoleWorkspace.window.restore') (t 'consoleWorkspace.window.maximize')}}" aria-label="{{if entry.maximized (t 'consoleWorkspace.window.restore') (t 'consoleWorkspace.window.maximize')}}">
      <i class="icon {{if entry.maximized 'icon-copy' 'icon-square'}}" aria-hidden="true"></i>
    </button>
    <button type="button" {{action "close"}} title="{{t 'consoleWorkspace.window.close'}}" aria-label="{{t 'consoleWorkspace.window.close'}}">
      <i class="icon icon-x" aria-hidden="true"></i>
    </button>
  </div>
</header>

<div class="console-workspace-window-body">
  {{#if loadError}}
    <div class="console-workspace-load-error">
      <i class="icon icon-alert" aria-hidden="true"></i>
      {{t 'consoleWorkspace.session.loadError'}}
    </div>
  {{else if instanceLoaded}}
    {{#if entry.isLogs}}
      {{workspace-logs entry=entry instance=entry.instance}}
    {{else if entry.isVm}}
      {{vm-console
        instance=entry.instance
        showProtip=false
        embedded=true
        stateChanged=(action "vmStateChanged")
      }}
    {{else}}
      {{workspace-terminal entry=entry instance=entry.instance}}
    {{/if}}
  {{else}}
    <div class="console-workspace-loading">
      <i class="icon icon-spinner icon-spin" aria-hidden="true"></i>
      {{t 'consoleWorkspace.session.status.connecting'}}
    </div>
  {{/if}}
</div>

<button
  type="button"
  class="console-workspace-resize-handle"
  onmousedown={{action "startResize"}}
  aria-label="{{t 'consoleWorkspace.window.resize'}}"
  title="{{t 'consoleWorkspace.window.resize'}}"
></button>
