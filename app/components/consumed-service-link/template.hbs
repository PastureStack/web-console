{{~#if this.link.service.arbitraryString~}}
  <div>{{this.link.service.name}} <label class="text-muted" style="padding: 0 10px;">{{t 'formServiceLinks.asName'}}</label> {{this.link.name}}</div>
{{~else~}}
  {{~#link-to 'service' this.link.service.stackId this.link.service.id~}}
    {{~#if (eq this.link.service.name this.link.name)~}}
      {{t (if (eq this.link.service.stackId this.stackId) 'serviceLink.noAlias.sameStack' 'serviceLink.noAlias.differentStack')
        stack=this.link.service.displayStack
        service=this.link.service.displayName
        alias=this.link.name
      }}
    {{~else~}}
      {{~#if this.link.name~}}
        {{t (if (eq this.link.service.stackId this.stackId) 'serviceLink.withAlias.sameStack' 'serviceLink.withAlias.differentStack')
          stack=this.link.service.displayStack
          service=this.link.service.displayName
          alias=this.link.name
        }}
      {{~else~}}
        {{t (if (eq this.link.service.stackId this.stackId) 'serviceLink.noAlias.sameStack' 'serviceLink.noAlias.differentStack')
          stack=this.link.service.displayStack
          service=this.link.service.displayName
        }}
      {{~/if~}}
    {{~/if~}}
  {{/link-to}}
{{~/if~}}
