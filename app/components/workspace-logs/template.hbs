{{#unless instance.tty}}
  <ul class="nav nav-tabs workspace-log-tabs">
    <li role="presentation" class="{{if isCombined 'active'}}">
      <a {{action "changeShow" "combined"}}>{{t 'containerLogs.combined'}}</a>
    </li>
    <li role="presentation" class="{{if isStdOut 'active'}}">
      <a {{action "changeShow" "stdout"}}>{{t 'containerLogs.stdout'}}</a>
    </li>
    <li role="presentation" class="{{if isStdErr 'active'}}">
      <a {{action "changeShow" "stderr"}}>{{t 'containerLogs.stderr'}}</a>
    </li>
  </ul>
{{/unless}}

<pre class="workspace-log-body {{unless stdErrVisible 'hide-stderr'}} {{unless stdOutVisible 'hide-stdout'}}"></pre>

<footer class="workspace-log-footer">
  <span>
    <span class="console-workspace-status-dot status-{{status}}" aria-hidden="true"></span>
    {{t (concat-str 'consoleWorkspace.session.status.' status)}}
  </span>
  <span class="workspace-log-actions">
    {{#if (or (eq status "disconnected") (eq status "error"))}}
      <button type="button" class="btn btn-xs btn-default" {{action "reconnect"}}>
        <i class="icon icon-refresh" aria-hidden="true"></i>
        {{t 'consoleWorkspace.window.reconnect'}}
      </button>
    {{/if}}
    <button type="button" class="btn btn-xs btn-default" {{action "scrollToTop"}}>
      {{t 'containerLogs.scrollTop'}}
    </button>
    <button type="button" class="btn btn-xs btn-default" {{action "scrollToBottom"}}>
      {{t 'containerLogs.scrollBottom'}}
    </button>
    <button type="button" class="btn btn-xs btn-default" {{action "clear"}}>
      {{t 'containerLogs.clear'}}
    </button>
  </span>
</footer>
