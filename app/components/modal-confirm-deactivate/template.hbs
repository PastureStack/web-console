<div class="protip">{{t 'modalConfirmDeactivate.protip' key=this.alternateLabel isServiceButton=this.isService.button}}</div>
<hr>
<div class="container-header-text">
  {{t 'modalConfirmDeactivate.header'}} {{this.isService.message}}:
  <div class="display-name">
    {{this.originalModel.displayName}}
  </div>
</div>


<div class="footer-actions">
  <button {{action "confirm"}} class="btn btn-danger">{{this.isService.button}}</button>
  <button {{action "cancel"}} class="btn btn-link">{{t 'modalConfirmDeactivate.cancel'}}</button>
</div>
