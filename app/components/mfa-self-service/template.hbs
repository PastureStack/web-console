{{#if this.reauthenticationRequired}}
  <div class="alert alert-warning" role="status"
       data-testid="mfa-reauthentication-required">
    <i class="icon icon-lock"></i>
    {{t 'authPage.mfa.sessionRevoked'}}
    {{#unless this.recoveryCodes}}
      <button type="button" class="btn btn-warning r-ml10" {{action "signInAgain"}}>
        {{t 'authPage.mfa.signInAgain'}}
      </button>
    {{/unless}}
  </div>
{{/if}}

{{#unless this.isCurrentAccount}}
  <div class="alert alert-warning" role="status"
       data-testid="mfa-managed-account-warning">
    <i class="icon icon-alert"></i>
    {{t 'authPage.mfa.managedAccountWarning'}}
  </div>
{{/unless}}

{{#if this.recoveryCodes}}
  <section class="well" data-testid="mfa-recovery-codes">
    <div class="alert alert-warning">
      <strong>{{t 'authPage.mfa.recoveryCodes.header'}}</strong>
      <p>{{t 'authPage.mfa.recoveryCodes.oneTimeHelp'}}</p>
    </div>
    <div class="row">
      {{#each this.recoveryCodes as |code|}}
        <div class="col-sm-6"><code>{{code}}</code></div>
      {{/each}}
    </div>
    <div class="r-mt15">
      {{copy-to-clipboard
        buttonText="authPage.mfa.recoveryCodes.copy"
        clipboardText=this.recoveryCodesText}}
      <button type="button" class="btn btn-primary"
              data-testid="mfa-recovery-codes-saved"
              {{action "dismissRecoveryCodes"}}>
        {{t 'authPage.mfa.recoveryCodes.saved'}}
      </button>
    </div>
  </section>
{{/if}}

<section class="well" data-testid="mfa-factor-management">
  <h2>{{t 'authPage.mfa.factor.header'}}</h2>
  {{#if this.factors.length}}
    <table class="table fixed no-lines">
      <thead>
        <tr>
          <th>{{t 'authPage.mfa.factor.type'}}</th>
          <th>{{t 'authPage.mfa.factor.label'}}</th>
          <th>{{t 'authPage.mfa.factor.created'}}</th>
          <th>{{t 'authPage.mfa.factor.lastUsed'}}</th>
          <th class="text-right">{{t 'generic.actions'}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each this.factors as |factor|}}
          <tr data-testid="mfa-factor-row">
            <td>{{t (concat 'authPage.mfa.factor.types.' factor.factorType)}}</td>
            <td>{{factor.label}}</td>
            <td>{{date-calendar factor.createdAt}}</td>
            <td>{{#if factor.lastUsedAt}}{{date-calendar factor.lastUsedAt}}{{else}}—{{/if}}</td>
            <td class="text-right">
              <button type="button" class="btn btn-sm btn-danger"
                      data-testid="mfa-revoke-factor"
                      disabled={{this.busy}} {{action "revokeFactor" factor}}>
                {{t 'generic.remove'}}
              </button>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <div class="alert alert-info">{{t 'authPage.mfa.factor.none'}}</div>
  {{/if}}

  {{#if this.isCurrentAccount}}
    <div class="row">
      <div class="col-md-6">
        <h3>{{t 'authPage.mfa.totp.header'}}</h3>
        {{#if this.totpEnrollment}}
          <p>{{t 'authPage.mfa.totp.scanHelp'}}</p>
          {{#if this.totpQrSvg}}
            <div class="mfa-totp-qr" data-testid="mfa-totp-qr">{{{this.totpQrSvg}}}</div>
          {{/if}}
          <div class="form-group">
            <label>{{t 'authPage.mfa.totp.manualSecret'}}</label>
            <div class="well mfa-secret-value"><code>{{this.totpEnrollment.totpSecret}}</code></div>
          </div>
          <div class="r-mb15">
            <a href="{{this.totpEnrollment.totpProvisioningUri}}" class="btn btn-default">
              <i class="icon icon-external-link"></i>
              {{t 'authPage.mfa.totp.openAuthenticator'}}
            </a>
            {{copy-to-clipboard clipboardText=this.totpEnrollment.totpProvisioningUri}}
          </div>
          <div class="form-group">
            <label>{{t 'authPage.mfa.factor.label'}}</label>
            {{input value=this.totpLabel class="form-control" placeholder=(t 'authPage.mfa.totp.defaultLabel')}}
          </div>
          <div class="form-group">
            <label>{{t 'authPage.mfa.totp.code'}}</label>
            {{input value=this.totpCode class="form-control" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code"}}
          </div>
          <button type="button" class="btn btn-primary" disabled={{this.busy}}
                  {{action "confirmTotp"}}>
            {{t 'authPage.mfa.totp.confirm'}}
          </button>
          <button type="button" class="btn btn-default" disabled={{this.busy}}
                  {{action "cancelTotp"}}>
            {{t 'generic.cancel'}}
          </button>
        {{else}}
          <p>{{t 'authPage.mfa.totp.help'}}</p>
          <button type="button" class="btn btn-primary" disabled={{this.busy}}
                  data-testid="mfa-begin-totp" {{action "beginTotp"}}>
            {{t 'authPage.mfa.totp.add'}}
          </button>
        {{/if}}
      </div>

      <div class="col-md-6">
        <h3>{{t 'authPage.mfa.passkey.header'}}</h3>
        {{#if this.webAuthnReady}}
          <p>{{t 'authPage.mfa.passkey.help'}}</p>
          <div class="form-group">
            <label>{{t 'authPage.mfa.factor.label'}}</label>
            {{input value=this.passkeyLabel class="form-control" placeholder=(t 'authPage.mfa.passkey.defaultLabel')}}
          </div>
          <button type="button" class="btn btn-primary" disabled={{this.busy}}
                  data-testid="mfa-begin-passkey" {{action "beginPasskey"}}>
            {{t 'authPage.mfa.passkey.add'}}
          </button>
        {{else if this.webAuthnPolicyConfigured}}
          <div class="alert alert-warning">{{t 'authPage.mfa.passkey.secureContextRequired'}}</div>
        {{else}}
          <div class="alert alert-warning">{{t 'authPage.mfa.passkey.notConfigured'}}</div>
        {{/if}}
      </div>
    </div>
  {{/if}}
</section>

{{#if this.isCurrentAccount}}
  <section class="well" data-testid="mfa-recovery-management">
    <div class="row">
      <div class="col-md-6">
        <h2>{{t 'authPage.mfa.recoveryCodes.header'}}</h2>
        <p>{{t 'authPage.mfa.recoveryCodes.help'}}</p>
        {{#unless this.status.enrolled}}
          <div class="alert alert-info">{{t 'authPage.mfa.recoveryCodes.requiresFactor'}}</div>
        {{/unless}}
        <button type="button" class="btn btn-warning"
                disabled={{or this.busy (not this.status.enrolled)}}
                {{action "regenerateRecoveryCodes"}}>
          {{t 'authPage.mfa.recoveryCodes.regenerate'}}
        </button>
      </div>
      <div class="col-md-6">
        <h2>{{t 'authPage.mfa.email.header'}}</h2>
        <p>{{t 'authPage.mfa.email.help'}}</p>
        <p class="help-block">{{t 'authPage.mfa.email.systemManaged'}}</p>
        {{#if this.status.recoveryEmailMasked}}
          <div class="alert alert-success">
            {{t 'authPage.mfa.email.verified' email=this.status.recoveryEmailMasked}}
          </div>
          <button type="button" class="btn btn-danger" disabled={{this.busy}}
                  {{action "revokeRecoveryEmail"}}>
            {{t 'authPage.mfa.email.revoke'}}
          </button>
        {{else if this.status.recoveryEmailEnrollmentAvailable}}
          {{#if this.recoveryEmailEnrollment}}
            <p>{{t 'authPage.mfa.email.sent' email=this.recoveryEmailEnrollment.recoveryEmailMasked}}</p>
            {{input value=this.recoveryEmailCode class="form-control" maxlength="6" data-testid="mfa-recovery-email-code" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" placeholder=(t 'authPage.mfa.email.code')}}
            <button type="button" class="btn btn-primary r-mt10" disabled={{this.busy}}
                    data-testid="mfa-confirm-recovery-email"
                    {{action "confirmRecoveryEmail"}}>
              {{t 'authPage.mfa.email.confirm'}}
            </button>
          {{else}}
            {{input value=this.recoveryEmail class="form-control" type="email" data-testid="mfa-recovery-email-input" autocomplete="email" placeholder=(t 'authPage.mfa.email.placeholder')}}
            <button type="button" class="btn btn-primary r-mt10" disabled={{this.busy}}
                    data-testid="mfa-begin-recovery-email"
                    {{action "beginRecoveryEmail"}}>
              {{t 'authPage.mfa.email.verify'}}
            </button>
          {{/if}}
        {{else}}
          <div class="alert alert-info">{{t 'authPage.mfa.email.notConfigured'}}</div>
        {{/if}}
      </div>
    </div>
  </section>
{{/if}}
