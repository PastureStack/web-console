<td data-title="{{t 'apiPage.table.state'}}:">
  {{badge-state model=this.model}}
</td>
<td data-title="{{t 'apiPage.table.name'}}:">
  {{#if this.model.name}}{{this.model.displayName}}{{else}}<span class="text-muted">{{t 'apiPage.table.noName'}}</span>{{/if}}
</td>
<td data-title="{{t 'apiPage.table.description'}}:">
  {{#if this.model.description}}{{this.model.description}}{{else}}<span class="text-muted">{{t 'apiPage.table.noDescription'}}</span>{{/if}}
  {{#if this.model.apiKeyPolicy}}
    <div class="text-muted">{{t (concat 'apiKeyAccess.modes.' this.model.apiKeyPolicy.mode)}} · {{t 'apiKeyAccess.revision'}} {{this.model.apiKeyPolicyRevision}}</div>
    {{#if this.model.apiKeyPolicy.expiresAt}}<div class="text-muted">{{t 'apiKeyAccess.expiry'}}: {{this.model.apiKeyPolicy.expiresAt}}</div>{{/if}}
  {{/if}}
</td>
<td data-title="{{t 'apiPage.table.publicValue'}}:">
  {{#if this.model.publicValue}}{{this.model.publicValue}}{{else}}<span class="text-muted">{{t 'apiPage.table.noPublicValue'}}</span>{{/if}}
</td>
<td data-title="{{t 'apiPage.table.created'}}:">
  <div class="text-muted">{{date-calendar this.model.created}}</div>
</td>
<td data-title="{{t 'generic.actions'}}:" class="actions">
  {{action-menu model=this.model}}
</td>
