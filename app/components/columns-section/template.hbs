{{#if this.podCount}}
  {{#each this.columns as |col index|}}
    <div class="pod-column" style={{if (eq index this.lastIndex) this.lastColumnWidthCss this.columnWidthCss}}>
      {{#each col as |item|}}
        {{yield item}}
      {{/each}}
    </div>
  {{/each}}
{{else}}
  <div class="text-center text-muted" style="margin-bottom: 20px;">{{this.emptyMessage}}</div>
{{/if}}
