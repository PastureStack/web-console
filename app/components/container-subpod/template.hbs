<div class="container-subpod">
  <div class="subpod-name clip">
    <i class="{{this.model.stateIcon}}{{this.model.stateColor}} dot "></i>
    <a class="{{if this.showEllipsis 'tiny-hellip'}}" href="{{href-to (if this.model.isVm "virtualmachine" "container") this.model.id}}">
      {{#tooltip-element tagName="span" inlineBlock=false type="tooltip-action-menu" model=this.model tooltipTemplate='tooltip-action-menu' tooltipFor="containerSubpod"}}
        {{this.displayName}}
      {{/tooltip-element}}
    </a>
  </div>
  {{#if this.model.showTransitioningMessage}}
    <div class="subpod-detail clip {{if this.model.isError 'text-danger'}}">
      {{this.model.transitioningMessage}}
    </div>
  {{else}}
    <div class="subpod-detail">
      {{format-ip this.model.displayIp}}
    </div>
  {{/if}}
  {{action-menu model=this.model showPrimary=false}}
</div>
{{#if this.children}}
  <div class="subpod-children clearfix">
    <h6 class="pull-left">{{t (if this.isKubernetes 'containerSubpod.childContainers' 'containerSubpod.childSidekicks')}}</h6>
    {{#each this.children as |child|}}
       {{container-dot model=child type='tooltip-action-menu' template='tooltip-action-menu'}}
    {{else}}
      &nbsp;
    {{/each}}
  </div>
{{/if}}
