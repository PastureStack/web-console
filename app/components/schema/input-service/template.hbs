<div class="input-service">
  <select class="{{this.selectClass}}" onchange={{action (mut this.selected) value="target.value"}}>
    <option selected={{and (eq this.selected null) (not-eq this.customMode true)}}>{{t 'schema.inputService.prompt'}}</option>
    {{#if this.showCustomOption}}
      <option value="customMode" selected={{eq this.customMode true}}>{{t 'schema.inputService.custom.prompt'}}</option>
    {{/if}}
    {{#each-in this.grouped as |group list|}}
      <optgroup label={{group}}>
        {{#each list as |svc|}}
          <option selected={{eq this.selected svc.id}} value={{svc.id}}>{{svc.stackName}}/{{svc.name}}</option>
        {{/each}}
      </optgroup>
    {{/each-in}}
  </select>
  {{#if this.customMode}}
    {{input class="form-control input-sm input-select" type="text" value=this.custom placeholder=(t 'schema.inputService.custom.placeholder')}}
  {{/if}}
</div>