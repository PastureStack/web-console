<div class="form-group">
  <label>{{t 'modalEditSnapshot.nameLabel'}}*</label>
  {{input class="form-control" value=this.snapshotName }}
</div>

{{save-cancel editing=this.editing save="saveSnapshot" cancel="cancel"}}
