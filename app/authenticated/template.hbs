{{#unless this.isPopup}}
  {{page-header
    currentPath=this.currentPath
    hasCattleSystem=this.hasCattleSystem
    switchProject="switchProject"
    switchNamespace="switchNamespace"
    goToPrevious="goToPrevious"
  }}
{{/unless}}
<main class="clearfix">
  {{#if (and this.forceUpgrade this.projects.current.needsUpgrade)}}
    {{project-upgrade model=this.projects.current}}
  {{/if}}

  {{outlet}}
</main>
{{#unless this.isPopup}}
  {{page-footer
    showAbout="showAbout"
  }}
  {{console-workspace}}
{{/unless}}
