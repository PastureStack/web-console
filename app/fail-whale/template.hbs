<section class="fail-whale">
  <div class="error">
    <h2 class="bg-danger">{{t 'failWhalePage.header'}}</h2>
    <div class="r-p20">
      <h4 class="r-mt20">{{this.model.code}} {{#if this.model.status}}({{this.model.status}}){{/if}}</h4>
      <p>{{this.model.message}}</p>
      <p class="small">{{this.model.detail}}</p>
      <div class="r-mt20">
        {{format-html-message 'failWhalePage.reloadButton'}} <a class="hand" {{action "logout"}}>{{t 'failWhalePage.logoutButton'}}</a>
      </div>
    </div>
  </div>

  {{#if this.settings.isRancher}}
    <div class="failplane">
      <img src="{{this.app.baseAssets}}assets/images/logos/fail-plane.svg" width="484" height="269" />
      <img class="failprop" src="{{this.app.baseAssets}}assets/images/logos/fail-prop.svg" width="123" height="246" />
    </div>

    <img class="failmark" src="{{this.app.baseAssets}}assets/images/logos/pasturestack-failure-node.svg" width="178" height="255" alt="{{t 'branding.recoveryNode' appName=this.settings.appName}}" />
    <img class="cloud" src="{{this.app.baseAssets}}assets/images/logos/fail-cloud1.svg" width="254" height="121" />
    <img class="cloud" src="{{this.app.baseAssets}}assets/images/logos/fail-cloud2.svg" width="151" height="91" />
    <img class="cloud" src="{{this.app.baseAssets}}assets/images/logos/fail-cloud3.svg" width="175" height="102" />
    <img class="cloud" src="{{this.app.baseAssets}}assets/images/logos/fail-cloud4.svg" width="300" height="142" />
    <img class="cloud" src="{{this.app.baseAssets}}assets/images/logos/fail-cloud5.svg" width="320" height="152" />

    <div class="wave"></div>
  {{/if}}
</section>
