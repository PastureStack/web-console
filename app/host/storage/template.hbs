<div class="storage-bulk-toolbar">
  <label class="storage-state-filter">
    <span>{{t 'hostsPage.hostPage.storageTab.filters.label'}}</span>
    <select class="input-sm" onchange={{action "changeStorageFilter" value="target.value"}}>
      <option value="all" selected={{eq this.storageFilter "all"}}>{{t 'hostsPage.hostPage.storageTab.filters.all'}}</option>
      <option value="active" selected={{eq this.storageFilter "active"}}>{{t 'hostsPage.hostPage.storageTab.filters.active'}}</option>
      <option value="detached" selected={{eq this.storageFilter "detached"}}>{{t 'hostsPage.hostPage.storageTab.filters.detached'}}</option>
    </select>
  </label>

  <span class="storage-selection-count" aria-live="polite">
    {{t 'hostsPage.hostPage.storageTab.bulkRemove.selected' count=this.selectedVolumeCount}}
  </span>

  <button
    type="button"
    class="btn btn-danger btn-sm"
    disabled={{unless this.hasSelectedVolumes true}}
    {{action "promptRemoveSelected"}}
  >
    <i class="icon icon-trash"></i>
    {{t 'hostsPage.hostPage.storageTab.bulkRemove.action' count=this.selectedVolumeCount}}
  </button>

  <span class="storage-selection-hint text-muted">
    {{t 'hostsPage.hostPage.storageTab.bulkRemove.selectableHint'}}
  </span>
</div>

{{#sortable-table
  classNames="lacsso grid sortable-table storage-table table-fit-content"
  body=this.filteredVolumes
  sortBy=this.sortBy
  bulkActions=true
  bulkActionMenu=false
  selectionFilter=this.selectableVolume
  selectionChanged=(action "selectionChanged")
  search=true
  paging=true
  perPage=this.prefs.storageTablePerPage
  pageSizeOptions=this.storagePageSizes
  perPagePreference=this.storageTablePreferenceKey
  headers=this.headers as |volume kind|}}
  {{#if (eq kind "row")}}
    {{volume-row model=volume}}
  {{else if (eq kind "nomatch")}}
    <tr><td colspan="5" class="text-center text-muted lacsso pt-20 pb-20">{{t 'hostsPage.hostPage.storageTab.table.body.noMatch'}}</td></tr>
  {{else if (eq kind "norows")}}
    <tr><td colspan="5" class="text-center text-muted lacsso pt-20 pb-20">{{t 'hostsPage.hostPage.storageTab.table.body.noData'}}</td></tr>
  {{/if}}
{{/sortable-table}}
