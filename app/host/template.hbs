<section class="header clearfix">
  <h1><LinkTo @route="hosts">{{t 'hostsPage.hostPage.header.linkTo'}}</LinkTo></h1>

  <PowerSelect @options={{this.model.all}} @selected={{this.host}} @onChange={{action "changeHost"}} @searchField="displayName" as |obj|>
    {{select-dot model=obj}}
  </PowerSelect>

  <div class="pull-right">
    {{#action-menu model=this.host size="sm" classNames="r-ml10 pull-right"}}
      <LinkTo @route="containers.new" @query={{hash hostId=this.host.id}} class="btn btn-sm btn-primary">{{t 'hostsPage.hostPage.addContainer.linkTo'}}</LinkTo>
    {{/action-menu}}

    {{header-state model=this.host classNames="pull-right"}}
  </div>
</section>

<section>
  <div class="row">
    <div class="col-md-3 r-mb15">
      {{#if this.host.description}}
        <div>
          <label>{{t 'hostsPage.hostPage.infoMultiStats.description'}} </label>
          <div>{{this.host.description}}</div>
        </div>
        <hr>
      {{/if}}

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.ip'}}</label>
        <div>{{copy-ip ip=this.host.displayIp}}</div>
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.cpu'}}</label>
        <div class="row">
          <div class="col-md-6 r-p0">
            {{#if this.host.milliCpu}}{{t 'generic.total'}}{{/if}}: {{this.host.cpuBlurb}}
            {{#if this.host.cpuTooltip}}
              {{#tooltip-element type='tooltip-basic' model=this.host tooltipTemplate='tooltip-cpu' tooltipFor="tooltipCPU"}}
                <i class="icon icon-info"></i>
              {{/tooltip-element}}
            {{/if}}
          </div>
          {{#if this.host.milliCpu}}
            <div class="col-md-6 r-p0">
              {{t 'generic.limit'}}: {{this.host.milliCpu}} {{t 'hostsPage.hostPage.infoMultiStats.milliCpu.labelText'}}
            </div>
          {{/if}}
        </div>
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.memory'}}</label>
        <div class="row">
          <div class="col-md-6 r-p0">
            {{#if this.host.memory}}{{t 'generic.total'}}{{/if}}:
            {{#if this.host.memoryBlurb}}
              {{this.host.memoryBlurb}}
            {{else}}
              <span class="text-muted">{{t 'generic.unknown'}}</span>
            {{/if}}
          </div>
          {{#if this.host.memory}}
            <div class="col-md-6 r-p0">
              {{t 'generic.limit'}}: {{this.host.memoryLimitBlurb}}
            </div>
          {{/if}}
        </div>
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.storage'}}</label>
        <div class="row">
          {{#if this.host.diskBlurb}}
            {{#if this.host.diskDetail}}
              {{#each this.host.diskDetail as |disk|}}
                <div class="col-md-6 r-p0">{{disk.value}}
                  {{#tooltip-element type='tooltip-basic' tooltipTemplate='tooltip-basic-literal' model=disk tooltipFor="hostDisk"}}
                    <i class="icon icon-info"></i>
                  {{/tooltip-element}}
               </div>
              {{/each}}
            {{else}}
              <div class="col-md-6 r-p0">{{this.host.diskBlurb}} ({{t 'generic.total'}})</div>
            {{/if}}
            <div class="col-md-6 r-p0">
              {{t 'hostsPage.hostPage.infoMultiStats.localStorageMb.labelText'}}: {{this.host.localStorageBlurb}}
            </div>
          {{else}}
            <div class="text-muted">{{t 'generic.unknown'}}</div>
          {{/if}}
        </div>
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.provider.labelText'}}</label>
        {{#if this.host.driver}}
          <div>{{this.host.driver}}</div>
        {{else}}
          <div class="text-muted">{{t 'hostsPage.hostPage.infoMultiStats.provider.noHost'}}</div>
        {{/if}}
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.kernel'}}</label>
        <div>{{this.host.info.osInfo.kernelVersion}}</div>
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.docker'}}</label>
        {{#if this.host.dockerEngineVersion}}
          <div>{{this.host.dockerEngineVersion}}</div>
        {{else}}
          <div class="text-muted">{{t 'generic.unknown'}}</div>
        {{/if}}
      </div>

      <hr>

      <div>
        <label>{{t 'hostsPage.hostPage.infoMultiStats.os'}}</label>
        {{#if this.host.osDetail}}
          <div>{{this.host.osDetail}}</div>
        {{else}}
          <div class="text-muted">{{t 'generic.unknown'}}</div>
        {{/if}}
      </div>

    </div>
    <div class="col-md-9">
      <div class="row">
        {{info-multi-stats model=this.host linkName="hostStats" single=true}}
      </div>
      <div class="row r-p15">
        <ul class="nav nav-tabs nav-tabs-well shadowed" role="tablist">
          <li><LinkTo @route="host.containers">{{t 'hostsPage.hostPage.navTabs.containers'}}</LinkTo></li>
          <li><LinkTo @route="host.ports">{{t 'hostsPage.hostPage.navTabs.ports'}}</LinkTo></li>
          <li><LinkTo @route="host.labels">{{t 'hostsPage.hostPage.navTabs.labels'}}</LinkTo></li>
          <li><LinkTo @route="host.storage">{{t 'hostsPage.hostPage.navTabs.storage'}}</LinkTo></li>
        </ul>
        <div class="table-flat well">
          {{outlet}}
        </div>
      </div>
    </div>
  </div>
</section>
