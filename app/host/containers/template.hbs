{{#sortable-table
  classNames="lacsso grid sortable-table container-table"
  body=model.instances
  sortBy=sortBy
  bulkActions=false
  search=true
  paging=true
  perPage=prefs.statsTablePerPage
  pageSizeOptions=statsPageSizes
  perPagePreference=statsTablePreferenceKey
  headers=headers
  liveSortFields=liveSortFields
  sortRevision=statsSortRevision
  animateLiveSort=true
  onPageContentChange=(action 'setVisibleStatsInstances') as |container kind|}}
  {{#if (eq kind "row")}}
    {{container-row
      model=container
      showStats=true
      showActions=true
      showCommand="inline"
      cpuMax=cpuMax
      memoryMax=memoryMax
      storageMax=storageMax
      networkMax=networkMax}}
  {{else if (eq kind "nomatch")}}
    <tr><td colspan="{{headers.length}}" class="text-center text-muted lacsso pt-20 pb-20">{{t 'containersPage.index.table.body.noMatch'}}</td></tr>
  {{else if (eq kind "norows")}}
    <tr><td colspan="{{headers.length}}" class="text-center text-muted lacsso pt-20 pb-20">{{t 'hostsPage.hostPage.containersTab.table.body.noData'}}</td></tr>
  {{/if}}
{{/sortable-table}}
