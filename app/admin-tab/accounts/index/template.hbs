<section class="header clearfix">
  <h1>{{t 'accountsPage.index.header'}}</h1>

  <div class="right-buttons">
    {{#link-to "account-security"
        classNames="btn btn-sm btn-default accounts-manage-my-mfa"
        data-testid="accounts-manage-my-mfa"}}
      <i class="icon icon-shield"></i>
      {{t 'authPage.mfa.selfService.manageMine'}}
    {{/link-to}}
    {{#link-to "admin-tab.auth.mfa"
        classNames="btn btn-sm btn-default accounts-manage-account-mfa"
        data-testid="accounts-manage-account-mfa"}}
      <i class="icon icon-users"></i>
      {{t 'authPage.mfa.manageAccounts'}}
    {{/link-to}}
    {{#if isLocal}}
      {{#link-to "admin-tab.accounts.new" classNames="btn btn-sm btn-primary"}}{{t 'accountsPage.index.localLink'}}{{/link-to}}
    {{/if}}
  </div>
</section>

<section class="well instances">
  <table class="grid fixed" style="margin-bottom: 0;">
    <thead>
      <tr>
        {{sortable-th sortable=this action="changeSort" name="state" label="generic.state" width="125"}}
        {{sortable-th sortable=this action="changeSort" name="id" label="generic.id" width="120"}}
        {{sortable-th sortable=this action="changeSort" name="kind" label="accountsPage.index.table.kind" width="120"}}
        {{#if isLocal}}
          {{sortable-th sortable=this action="changeSort" name="username" label="accountsPage.index.table.username"}}
          {{sortable-th sortable=this action="changeSort" name="name" label="generic.name"}}
        {{else}}
          <th>{{t 'accountsPage.index.table.identity'}}</th>
        {{/if}}
        <th class="actions" width="125">&nbsp;</th>
      </tr>
    </thead>
    <tbody>
      {{#each arranged as |account|}}
        {{account-row model=account isLocal=isLocal}}
      {{else}}
        <tr><td colspan="{{if isLocal '6' '5'}}" class="text-center text-muted">{{t 'accountsPage.index.table.noData'}}</td></tr>
      {{/each}}
    </tbody>
  </table>
</section>

