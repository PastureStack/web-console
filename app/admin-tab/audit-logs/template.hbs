<section class="header clearfix">
  <h1>{{t 'auditLogsPage.header'}}</h1>
</section>
<section>
  <div class="well">
    <form class="audit-log-filter-form" data-testid="audit-log-filter-panel" aria-busy={{if this.isFiltering "true" "false"}} {{action "search" on="submit"}}>
      <fieldset class="audit-log-filter-panel">
        <legend class="audit-log-filter-panel-legend">{{t 'auditLogsPage.filterBuilder.title'}}</legend>
      <div class="audit-log-filter-header">
        <p class="audit-log-filter-help">{{t 'auditLogsPage.filterBuilder.help'}}</p>
        <span class="audit-log-filter-count" data-testid="audit-log-filter-count">
          {{t 'auditLogsPage.filterBuilder.activeCount' count=this.activeFilterCount}}
        </span>
      </div>

      <div class="audit-log-filter-primary-grid">
        <fieldset class="audit-log-filter-card audit-log-filter-time">
          <legend>{{t 'auditLogsPage.filterBuilder.timeRange'}}</legend>
          <button type="button" class="audit-log-primary-control audit-log-time-open" data-testid="audit-log-time-open" {{action "openTimePicker"}}>
            <i class="icon icon-calendar" aria-hidden="true"></i>
            <span>{{this.timeRangeSummary}}</span>
            <i class="icon icon-edit" aria-hidden="true"></i>
          </button>
          <div class="audit-log-filter-card-summary">
            <span>{{t 'auditLogsPage.filterBuilder.timeZone' zone=this.timeZoneLabel}}</span>
            <span>{{t 'auditLogsPage.filterBuilder.timeInclusive'}}</span>
          </div>
        </fieldset>

        <fieldset class="audit-log-filter-card audit-log-filter-select">
          <legend>{{t 'auditLogsPage.filterBuilder.environment'}}</legend>
          <div class="audit-log-primary-control audit-log-primary-select">
            <PowerSelect
              @options={{this.environmentOptions}}
              @selected={{this.selectedEnvironment}}
              @onChange={{action "selectEnvironment"}}
              @searchField="searchText"
              @placeholder={{t 'auditLogsPage.filterBuilder.environmentPlaceholder'}}
              @allowClear={{true}}
              as |environment|
            >
              {{environment.label}}
            </PowerSelect>
          </div>
          <div class="audit-log-filter-card-summary">
            <span>{{this.environmentSelectionSummary}}</span>
            <span>{{t 'auditLogsPage.filterBuilder.permissionScoped'}}</span>
          </div>
        </fieldset>

        <fieldset class="audit-log-filter-card audit-log-filter-select">
          <legend>{{t 'auditLogsPage.filterBuilder.user'}}</legend>
          <div class="audit-log-primary-control audit-log-primary-select">
            <PowerSelect
              @options={{this.userOptions}}
              @selected={{this.selectedUser}}
              @onChange={{action "selectUser"}}
              @searchField="searchText"
              @placeholder={{t 'auditLogsPage.filterBuilder.userPlaceholder'}}
              @allowClear={{true}}
              as |user|
            >
              <span>{{user.label}}</span>
              {{#if user.detail}}<small class="audit-log-filter-option-detail">{{user.detail}}</small>{{/if}}
            </PowerSelect>
          </div>
          <div class="audit-log-filter-card-summary">
            <span>{{this.userSelectionSummary}}</span>
            <span>{{t 'auditLogsPage.filterBuilder.noRawIds'}}</span>
          </div>
        </fieldset>

        <fieldset class="audit-log-filter-card audit-log-filter-select">
          <legend>{{t 'auditLogsPage.filterBuilder.operationSource'}}</legend>
          <div class="audit-log-primary-control audit-log-primary-select">
            <PowerSelect
              @options={{this.interactionChannels}}
              @selected={{this.selectedInteractionChannel}}
              @onChange={{action "updateInteractionChannel"}}
              @searchField="label"
              @placeholder={{t 'auditLogsPage.filterBuilder.placeholders.interactionChannel'}}
              @allowClear={{true}}
              as |channel|
            >
              {{channel.label}}
            </PowerSelect>
          </div>
          <div class="audit-log-filter-card-summary">
            <span>{{this.interactionChannelSelectionSummary}}</span>
            <span>{{t 'auditLogsPage.filterBuilder.channelHelp'}}</span>
          </div>
        </fieldset>
      </div>

      {{#if this.optionalFilters.length}}
        <div class="audit-log-filter-conditions" data-testid="audit-log-filter-conditions">
          <div class="audit-log-filter-match-all">{{t 'auditLogsPage.filterBuilder.matchAll'}}</div>
          {{#each this.optionalFilters as |filterKey|}}
            <div class="audit-log-filter-row" data-filter-key={{filterKey}}>
              {{#if (eq filterKey "eventType")}}
                <label class="audit-log-filter-row-label" for="audit-log-event-type">{{t 'auditLogsPage.filterBuilder.conditions.eventType'}}</label>
                <select class="form-control input-sm audit-log-filter-operator" {{on "change" (action "selectTextOperator" "eventType")}}>
                  {{#each this.textOperators as |operator|}}
                    <option value={{operator.key}} selected={{eq this.filters.eventTypeOperator operator.key}}>{{operator.label}}</option>
                  {{/each}}
                </select>
                {{input id="audit-log-event-type" list="audit-log-event-type-suggestions" class="form-control input-sm audit-log-filter-value" value=this.filters.eventType placeholder=(t "auditLogsPage.filterBuilder.placeholders.eventType") autocomplete="off"}}
                <datalist id="audit-log-event-type-suggestions">
                  {{#each this.eventTypeSuggestions as |eventType|}}<option value={{eventType}}></option>{{/each}}
                </datalist>
              {{else if (eq filterKey "description")}}
                <label class="audit-log-filter-row-label" for="audit-log-description">{{t 'auditLogsPage.filterBuilder.conditions.description'}}</label>
                <select class="form-control input-sm audit-log-filter-operator" {{on "change" (action "selectTextOperator" "description")}}>
                  {{#each this.textOperators as |operator|}}
                    <option value={{operator.key}} selected={{eq this.filters.descriptionOperator operator.key}}>{{operator.label}}</option>
                  {{/each}}
                </select>
                {{input id="audit-log-description" class="form-control input-sm audit-log-filter-value" value=this.filters.description placeholder=(t "auditLogsPage.filterBuilder.placeholders.description")}}
              {{else if (eq filterKey "resource")}}
                <span class="audit-log-filter-row-label">{{t 'auditLogsPage.filterBuilder.conditions.resource'}}</span>
                <div class="audit-log-filter-resource-type">
                  <PowerSelect
                    @options={{this.model.resourceTypes}}
                    @selected={{this.filters.resourceType}}
                    @onChange={{action "updateResourceType"}}
                    @placeholder={{t 'auditLogsPage.filterBuilder.placeholders.resourceType'}}
                    @allowClear={{true}}
                    as |resource|
                  >
                    {{resource}}
                  </PowerSelect>
                </div>
                {{input class="form-control input-sm audit-log-filter-value" value=this.filters.resourceId placeholder=(t "auditLogsPage.filterBuilder.placeholders.resourceId") aria-label=(t "auditLogsPage.filterBuilder.placeholders.resourceId")}}
              {{else if (eq filterKey "clientIp")}}
                <label class="audit-log-filter-row-label" for="audit-log-client-ip">{{t 'auditLogsPage.filterBuilder.conditions.clientIp'}}</label>
                <span class="audit-log-filter-operator audit-log-filter-operator-static">{{t 'auditLogsPage.filterBuilder.operators.exact'}}</span>
                <div class="audit-log-filter-value-group">
                  {{input id="audit-log-client-ip" list="audit-log-client-ip-suggestions" class="form-control input-sm audit-log-filter-value" value=this.filters.clientIp placeholder=(t "auditLogsPage.filterBuilder.placeholders.clientIp") autocomplete="off" aria-describedby="audit-log-client-ip-help"}}
                  <datalist id="audit-log-client-ip-suggestions">
                    {{#each this.clientIpSuggestions as |clientIp|}}<option value={{clientIp}}></option>{{/each}}
                  </datalist>
                  {{#if this.clientIpQuickSuggestions.length}}
                    <div id="audit-log-client-ip-help" class="audit-log-autocomplete-suggestions" aria-label="{{t 'auditLogsPage.filterBuilder.autocomplete.label'}}">
                      {{#each this.clientIpQuickSuggestions as |clientIp|}}
                        <button type="button" class="audit-log-suggestion" {{action "useSuggestion" "clientIp" clientIp}}>{{clientIp}}</button>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              {{else if (eq filterKey "authType")}}
                <span class="audit-log-filter-row-label">{{t 'auditLogsPage.filterBuilder.conditions.authType'}}</span>
                <span class="audit-log-filter-operator audit-log-filter-operator-static">{{t 'auditLogsPage.filterBuilder.operators.exact'}}</span>
                <div class="audit-log-filter-value audit-log-filter-select-inline">
                  <PowerSelect
                    @options={{this.authTypes}}
                    @selected={{this.selectedAuthType}}
                    @onChange={{action "updateAuthType"}}
                    @searchField="value"
                    @placeholder={{t 'auditLogsPage.filterBuilder.placeholders.authType'}}
                    @allowClear={{true}}
                    as |type|
                  >
                    {{type.value}}
                  </PowerSelect>
                </div>
              {{/if}}
              <button type="button" class="btn btn-sm btn-link audit-log-filter-remove" title="{{t 'auditLogsPage.filterBuilder.removeCondition'}}" aria-label="{{t 'auditLogsPage.filterBuilder.removeCondition'}}" {{action "removeFilter" filterKey}}>
                <i class="icon icon-x" aria-hidden="true"></i>
              </button>
            </div>
          {{/each}}
        </div>
      {{/if}}

      {{#if this.filterError}}
        <div class="alert alert-danger audit-log-filter-error" role="alert" data-testid="audit-log-filter-error">{{this.filterError}}</div>
      {{/if}}

      <div class="audit-log-filter-footer">
        <div class="audit-log-filter-secondary-actions">
          <div class="dropdown">
            <button type="button" class="btn btn-sm btn-default dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="icon icon-search" aria-hidden="true"></i>
              {{t 'auditLogsPage.filterBuilder.shortcuts.title'}}
              <i class="icon icon-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu" role="menu">
              <li><a href="#" {{action "applyInvestigationPreset" "recentApi"}}>{{t 'auditLogsPage.filterBuilder.shortcuts.recentApi'}}</a></li>
              <li><a href="#" {{action "applyInvestigationPreset" "recentWeb"}}>{{t 'auditLogsPage.filterBuilder.shortcuts.recentWeb'}}</a></li>
              <li><a href="#" {{action "applyInvestigationPreset" "changes"}}>{{t 'auditLogsPage.filterBuilder.shortcuts.changes'}}</a></li>
              <li><a href="#" {{action "applyInvestigationPreset" "removals"}}>{{t 'auditLogsPage.filterBuilder.shortcuts.removals'}}</a></li>
            </ul>
          </div>
          <div class="dropdown">
            <button type="button" class="btn btn-sm btn-default dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" disabled={{not this.hasAvailableFilters}}>
              <i class="icon icon-plus" aria-hidden="true"></i>
              {{t 'auditLogsPage.filterBuilder.addCondition'}}
              <i class="icon icon-chevron-down" aria-hidden="true"></i>
            </button>
            {{#if this.hasAvailableFilters}}
              <ul class="dropdown-menu" role="menu">
                {{#each this.availableFilterDefinitions as |definition|}}
                  <li><a href="#" {{action "addFilter" definition.key}}>{{definition.label}}</a></li>
                {{/each}}
              </ul>
            {{/if}}
          </div>
          <div class="dropdown">
            <button type="button" class="btn btn-sm btn-default dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="icon icon-download" aria-hidden="true"></i>
              {{t 'auditLogsPage.filterBuilder.export.title'}}
              <i class="icon icon-chevron-down" aria-hidden="true"></i>
            </button>
            <ul class="dropdown-menu" role="menu">
              <li><a href="#" {{action "exportLogs" "xlsx"}}>{{t 'auditLogsPage.filterBuilder.export.xlsx'}}</a></li>
              <li><a href="#" {{action "exportLogs" "csv"}}>{{t 'auditLogsPage.filterBuilder.export.csv'}}</a></li>
              <li><a href="#" {{action "exportLogs" "json"}}>{{t 'auditLogsPage.filterBuilder.export.json'}}</a></li>
            </ul>
          </div>
        </div>
        <div class="audit-log-filter-actions">
          <button type="button" class="btn btn-sm btn-default" {{action "clearAll"}}>{{t 'auditLogsPage.filterBuilder.clear'}}</button>
          <button type="submit" class="btn btn-sm btn-primary" data-testid="audit-log-filter-apply" disabled={{this.isFiltering}}>
            {{#if this.isFiltering}}<i class="icon icon-spinner icon-spin" aria-hidden="true"></i> {{t 'auditLogsPage.filterBuilder.results.updating'}}{{else}}{{t 'auditLogsPage.filterBuilder.apply'}}{{/if}}
          </button>
        </div>
      </div>
      </fieldset>
    </form>

    <div class="audit-log-results-status {{if this.isFiltering "is-loading"}}" role="status" aria-live="polite">
      {{#if this.isFiltering}}
        {{t 'auditLogsPage.filterBuilder.results.updating'}}
      {{else}}
        {{t 'auditLogsPage.filterBuilder.results.summary' count=this.resultCount range=this.appliedRangeSummary}}
      {{/if}}
    </div>

    {{#if this.isTimePickerOpen}}
      <div class="audit-log-time-dialog-backdrop" role="presentation">
        <section class="audit-log-time-dialog" role="dialog" aria-modal="true" aria-labelledby="audit-log-time-dialog-title" data-testid="audit-log-time-dialog">
          <div class="audit-log-time-dialog-header">
            <h3 id="audit-log-time-dialog-title">{{t 'auditLogsPage.filterBuilder.timeDialog.title'}}</h3>
            <button type="button" class="btn btn-sm btn-link" aria-label="{{t 'auditLogsPage.filterBuilder.timeDialog.cancel'}}" {{action "closeTimePicker"}}>
              <i class="icon icon-x" aria-hidden="true"></i>
            </button>
          </div>
          <div class="audit-log-time-dialog-summary">{{this.timeRangeSummary}}</div>
          <div class="audit-log-filter-time-inputs">
            <div class="audit-log-time-editor">
              <label>
                <span>{{t 'auditLogsPage.filterBuilder.from'}}</span>
                {{audit-date-picker
                  value=this.createdFromDate
                  isOpen=(eq this.openDateCalendar "createdFrom")
                  label=(t 'auditLogsPage.filterBuilder.from')
                  dataTestId="audit-log-created-from"
                  onToggle=(action "toggleDateCalendar" "createdFrom")
                  onChange=(action "setDatePart" "createdFrom")
                }}
              </label>
              <div class="audit-log-time-columns" data-testid="audit-log-created-from-time-columns">
                {{audit-time-wheel
                  label=(t 'auditLogsPage.filterBuilder.timeDialog.hour')
                  ariaLabel=(t 'auditLogsPage.filterBuilder.timeDialog.fromHourLabel')
                  dataTestId="audit-log-created-from-hour"
                  options=this.hourOptions
                  selectedValue=this.createdFromHour
                  onChange=(action "setTimePart" "createdFrom" "hour")
                }}
                {{audit-time-wheel
                  label=(t 'auditLogsPage.filterBuilder.timeDialog.minute')
                  ariaLabel=(t 'auditLogsPage.filterBuilder.timeDialog.fromMinuteLabel')
                  dataTestId="audit-log-created-from-minute"
                  options=this.minuteOptions
                  selectedValue=this.createdFromMinute
                  onChange=(action "setTimePart" "createdFrom" "minute")
                }}
                {{audit-time-wheel
                  label=(t 'auditLogsPage.filterBuilder.timeDialog.period')
                  ariaLabel=(t 'auditLogsPage.filterBuilder.timeDialog.fromPeriodLabel')
                  dataTestId="audit-log-created-from-period"
                  options=this.periodOptions
                  selectedValue=this.createdFromPeriod
                  onChange=(action "setTimePart" "createdFrom" "period")
                }}
              </div>
            </div>
            <span class="audit-log-filter-time-separator" aria-hidden="true">→</span>
            <div class="audit-log-time-editor">
              <label>
                <span>{{t 'auditLogsPage.filterBuilder.to'}}</span>
                {{audit-date-picker
                  value=this.createdToDate
                  isOpen=(eq this.openDateCalendar "createdTo")
                  label=(t 'auditLogsPage.filterBuilder.to')
                  dataTestId="audit-log-created-to"
                  onToggle=(action "toggleDateCalendar" "createdTo")
                  onChange=(action "setDatePart" "createdTo")
                }}
              </label>
              <div class="audit-log-time-columns" data-testid="audit-log-created-to-time-columns">
                {{audit-time-wheel
                  label=(t 'auditLogsPage.filterBuilder.timeDialog.hour')
                  ariaLabel=(t 'auditLogsPage.filterBuilder.timeDialog.toHourLabel')
                  dataTestId="audit-log-created-to-hour"
                  options=this.hourOptions
                  selectedValue=this.createdToHour
                  onChange=(action "setTimePart" "createdTo" "hour")
                }}
                {{audit-time-wheel
                  label=(t 'auditLogsPage.filterBuilder.timeDialog.minute')
                  ariaLabel=(t 'auditLogsPage.filterBuilder.timeDialog.toMinuteLabel')
                  dataTestId="audit-log-created-to-minute"
                  options=this.minuteOptions
                  selectedValue=this.createdToMinute
                  onChange=(action "setTimePart" "createdTo" "minute")
                }}
                {{audit-time-wheel
                  label=(t 'auditLogsPage.filterBuilder.timeDialog.period')
                  ariaLabel=(t 'auditLogsPage.filterBuilder.timeDialog.toPeriodLabel')
                  dataTestId="audit-log-created-to-period"
                  options=this.periodOptions
                  selectedValue=this.createdToPeriod
                  onChange=(action "setTimePart" "createdTo" "period")
                }}
              </div>
            </div>
          </div>
          <p class="audit-log-time-wheel-help"><span aria-hidden="true">↕</span> {{t 'auditLogsPage.filterBuilder.timeDialog.wheelHelp'}}</p>
          <div class="audit-log-filter-presets" aria-label="{{t 'auditLogsPage.filterBuilder.presets.label'}}">
            <button type="button" class="audit-log-time-preset {{if (eq this.activeTimePreset "minutes15") "is-active"}}" aria-pressed={{eq this.activeTimePreset "minutes15"}} {{action "setTimePreset" 15 "minutes"}}>{{t 'auditLogsPage.filterBuilder.presets.minutes15'}}</button>
            <button type="button" class="audit-log-time-preset {{if (eq this.activeTimePreset "hour") "is-active"}}" aria-pressed={{eq this.activeTimePreset "hour"}} {{action "setTimePreset" 1 "hour"}}>{{t 'auditLogsPage.filterBuilder.presets.hour'}}</button>
            <button type="button" class="audit-log-time-preset {{if (eq this.activeTimePreset "day") "is-active"}}" aria-pressed={{eq this.activeTimePreset "day"}} {{action "setTimePreset" 24 "hours"}}>{{t 'auditLogsPage.filterBuilder.presets.day'}}</button>
            <button type="button" class="audit-log-time-preset {{if (eq this.activeTimePreset "week") "is-active"}}" aria-pressed={{eq this.activeTimePreset "week"}} {{action "setTimePreset" 7 "days"}}>{{t 'auditLogsPage.filterBuilder.presets.week'}}</button>
          </div>
          <div class="audit-log-time-dialog-actions">
            <span>{{t 'auditLogsPage.filterBuilder.timeZone' zone=this.timeZoneLabel}}</span>
            <div>
              <button type="button" class="btn btn-sm btn-default" {{action "closeTimePicker"}}>{{t 'auditLogsPage.filterBuilder.timeDialog.cancel'}}</button>
              <button type="button" class="btn btn-sm btn-primary" {{action "acceptTimePicker"}}>{{t 'auditLogsPage.filterBuilder.timeDialog.accept'}}</button>
            </div>
          </div>
        </section>
      </div>
    {{/if}}
    <table class="grid fixed table table-hover r-mb15 audit-log-results-table">
      <thead>
        {{sortable-th sortable=this action="changeSort" name="created" label="auditLogsPage.table.time" width="115" class="r-pl10"}}
        {{sortable-th sortable=this action="changeSort" name="eventType" label="auditLogsPage.table.eventType" class="r-pl10"}}
        {{sortable-th sortable=this action="changeSort" name="description" label="auditLogsPage.table.description" class="r-pl10"}}
        {{sortable-th sortable=this action="changeSort" name="accountId" label="auditLogsPage.table.environment" width="125" class="r-pl10"}}
        {{sortable-th sortable=this action="changeSort" name="resourceType" label="auditLogsPage.table.resourceTypeId" class="r-pl10"}}
        {{sortable-th sortable=this action="changeSort" name="authenticatedAsIdentityId" label="auditLogsPage.table.identity" width="175" class="r-pl10"}}
        <th width="150" class="r-pl10 audit-log-auth-ip-heading">{{t 'auditLogsPage.table.authIp'}}</th>
      </thead>
      <tbody>
        {{#each this.model.auditLog as |log|}}
          <tr>
            <td data-title="{{t 'auditLogsPage.table.time'}}:">{{date-from-now log.created}}</td>
            <td data-title="{{t 'auditLogsPage.table.eventType'}}:" class="force-wrap" title="{{log.eventType}}">
              {{log.eventType}} <i class="icon icon-info service-icon-button" {{action 'showResponseObjects' log.requestObject log.responseObject }}></i>
            </td>
            <td data-title="{{t 'auditLogsPage.table.description'}}:">{{#if log.description}}{{log.description}}{{else}}<span class="text-muted">{{t 'generic.none'}}</span>{{/if}}</td>
            <td data-title="{{t 'auditLogsPage.table.environment'}}:" class="clip">
              {{#if log.environmentDisplayName}}{{log.environmentDisplayName}}{{else}}<span class="text-muted">{{t 'auditLogsPage.table.unnamedEnvironment'}}</span>{{/if}}
            </td>
            <td data-title="{{t 'auditLogsPage.table.resourceTypeId'}}:" class="clip" title="{{log.resourceType}}">
              {{#if log.links.resource}}
                <a href="{{log.links.resource}}" target="_blank">{{log.resourceType}}{{#if log.resourceId}}: {{log.resourceId}}{{/if}}</a>
              {{else}}
                {{log.resourceType}}{{#if log.resourceId}}: {{log.resourceId}}{{/if}}
              {{/if}}
            </td>
            <td data-title="{{t 'auditLogsPage.table.identity'}}:">{{#if log.actorDisplayName}}{{log.actorDisplayName}}{{else}}<span class="text-muted">{{t 'auditLogsPage.table.unknownUser'}}</span>{{/if}}</td>
            <td data-title="{{t 'auditLogsPage.table.authIp'}}:" class="clip">
              <span class="audit-log-channel-badge">{{t (concat 'auditLogsPage.filterBuilder.channels.' log.interactionChannel)}}</span>
              <div>{{auth-type log.authType}}</div>
              <div>{{format-ip log.clientIp noIp='generic.emptyString'}}</div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
      <div class="container-paginatio text-center">
        <button class="btn btn-sm btn-default" {{action 'first'}}>{{t 'auditLogsPage.first'}}</button>
        {{#if this.showPagination }}
          <button class="btn btn-sm btn-default" {{action 'next'}}>{{t 'auditLogsPage.next'}}</button>
        {{/if}}
      </div>
  </div>
</section>
{{outlet}}
