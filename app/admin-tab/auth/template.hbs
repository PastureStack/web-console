<section class="header clearfix">
  <h1>{{t 'authPage.root.header'}}</h1>
  <div class="right-buttons">
    {{#link-to "admin-tab.auth.mfa" class="btn btn-primary"}}
      <i class="icon icon-shield"></i>
      {{t 'authPage.mfa.navigation'}}
    {{/link-to}}
  </div>
</section>

{{#unless this.access.enabled}}
  <section class="well">
    <div class="nav nav-boxes checked-active">
      {{#each this.drivers as |driver|}}
        {{#if driver.available}}
          {{#link-to driver.route aria-label=driver.label title=driver.label classNames=(concat "nav-box-item driver auth-driver " driver.css) href=false}}{{/link-to}}
        {{/if}}
      {{/each}}
    </div>
  </section>
{{else}}
  <section class="well">
    <div class="nav nav-boxes checked-active">
      {{#each this.drivers as |driver|}}
        {{#if driver.safeWhileEnabled}}
          {{#if driver.available}}
            {{#link-to driver.route aria-label=driver.label title=driver.label classNames=(concat "nav-box-item driver auth-driver " driver.css) href=false}}{{/link-to}}
          {{/if}}
        {{/if}}
      {{/each}}
    </div>
  </section>
{{/unless}}

{{outlet}}
