<section class="well">
  <h2>{{headerText}}</h2>
  <div>
    {{#if isLocalActive}}
      {{t 'authPage.localAuth.subtext.enabled.text' appName=settings.appName}} {{#link-to "admin-tab.accounts"}}{{t 'authPage.localAuth.subtext.enabled.linkText'}}{{/link-to}}
    {{else if isExternalActive}}
      {{t 'authPage.localAuth.subtext.recovery' appName=settings.appName}}
    {{else}}
      {{t 'authPage.localAuth.subtext.disabled' appName=settings.appName}}
    {{/if}}
  </div>
</section>

{{#if isLocalActive}}
  <section class="well">
    <h3>{{t 'authPage.localAuth.active.header'}}</h3>
    <hr/>
    <p>{{t 'authPage.localAuth.active.help'}}</p>
    {{#link-to "admin-tab.auth.oidc" classNames="btn btn-primary"}}
      <i class="icon icon-shield"></i> {{t 'authPage.localAuth.active.configureOidc'}}
    {{/link-to}}
  </section>
{{/if}}

{{#if isExternalActive}}
  <section class="well">
    <h3>{{t 'authPage.localAuth.switch.header'}}</h3>
    <hr/>
    <p>{{t 'authPage.localAuth.switch.help'}}</p>
    <div class="alert alert-info">
      <i class="icon icon-shield"></i>
      {{t 'authPage.localAuth.switch.security'}}
    </div>
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>{{t 'authPage.localAuth.accessDisabled.form.login.labelText'}}*</label>
          {{input type="text" value=adminPublicValue autocomplete="username" classNames="form-control"}}
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>{{t 'authPage.localAuth.accessDisabled.form.password.labelText'}}*</label>
          {{input type="password" value=adminSecretValue autocomplete="current-password" classNames="form-control"}}
        </div>
      </div>
    </div>
    {{top-errors errors=errors}}
    <button type="button" class="btn btn-primary" disabled={{createDisabled}} {{action "switchToLocal"}}>
      {{#if switching}}
        <i class="icon icon-spinner icon-spin"></i> {{t 'authPage.localAuth.switch.switching'}}
      {{else}}
        <i class="icon icon-exchange"></i> {{t 'authPage.localAuth.switch.action'}}
      {{/if}}
    </button>
  </section>
{{/if}}

{{#unless access.enabled}}
  <section class="well">
    <h3>{{t 'authPage.localAuth.accessDisabled.header'}}</h3>
    <hr/>
    <p class="help-block">{{t 'authPage.localAuth.accessDisabled.helpText' appName=settings.appName}}</p>
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>{{t 'authPage.localAuth.accessDisabled.form.login.labelText'}}*</label>
          {{input type="text" value=adminPublicValue placeholder=(t 'authPage.localAuth.accessDisabled.form.login.placeholder') classNames="form-control"}}
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>{{t 'authPage.localAuth.accessDisabled.form.name.labelText'}}</label>
          {{input type="text" value=adminName placeholder=(t 'authPage.localAuth.accessDisabled.form.name.placeholder') classNames="form-control"}}
        </div>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6">
        <div class="form-group">
          <label>{{t 'authPage.localAuth.accessDisabled.form.password.labelText'}}*</label>
          {{input type="password" value=adminSecretValue classNames="form-control"}}
          <div class="help-block">{{validateDescription}}</div>
        </div>
      </div>
      <div class="col-md-6">
        <div class="form-group">
          <label>{{t 'authPage.localAuth.accessDisabled.form.confirmPassword.labelText'}}*</label>
          {{input type="password" value=adminSecretValue2 classNames="form-control"}}
        </div>
      </div>
    </div>
  </section>

  <section class="well">
    <h3>{{t 'authPage.localAuth.accessControl.header'}}</h3>
    <hr/>
    <p class="help-block">{{t 'authPage.localAuth.accessControl.helpText'}}</p>
    {{top-errors errors=errors}}

    <button disabled={{createDisabled}} class="btn btn-primary" style="display: block;" {{action "test"}}>
      {{#if testing}}
        <i class="icon icon-spinner icon-spin"></i> {{t 'authPage.localAuth.accessControl.buttonText.post'}}
      {{else}}
        {{t 'authPage.localAuth.accessControl.buttonText.pre'}}
      {{/if}}
    </button>
  </section>
{{/unless}}
