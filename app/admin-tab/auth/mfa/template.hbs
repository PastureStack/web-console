<section class="header clearfix">
  <h1>{{t 'authPage.mfa.header'}}</h1>
  <div class="right-buttons">
    <LinkTo @route="account-security" class="btn btn-default">
      <i class="icon icon-user"></i>
      {{t 'authPage.mfa.selfService.manageMine'}}
    </LinkTo>
  </div>
</section>

{{top-errors errors=this.errors}}

<section class="well" data-testid="mfa-system-settings">
  <h2>{{t 'authPage.mfa.settings.header'}}</h2>
  <p class="help-block">{{t 'authPage.mfa.settings.scopeHelp'}}</p>
  {{#if this.settingsForm.localAdministratorRecoveryRequired}}
    <div class="alert {{if this.settingsForm.localAdministratorRecoveryEnabled 'alert-success' 'alert-danger'}}"
         role="status" data-testid="local-administrator-recovery-status">
      {{#if this.settingsForm.localAdministratorRecoveryEnabled}}
        {{t 'authPage.mfa.settings.localRecoveryReady'}}
      {{else}}
        {{t 'authPage.mfa.settings.localRecoveryBlocked'}}
      {{/if}}
    </div>
  {{/if}}
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.enforcement'}}</label>
      {{new-select classNames="form-control"
        content=this.enforcementChoices
        localizedLabel=true
        optionValuePath="value"
        value=this.settingsForm.enforcement}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.passkeyLimit'}}</label>
      {{input type="number" min="1" max="20" value=this.settingsForm.passkeyLimit class="form-control"}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.issuer'}}</label>
      {{input value=this.settingsForm.issuer class="form-control"}}
    </div>
  </div>

  <h3>{{t 'authPage.mfa.settings.webAuthn'}}</h3>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.rpName'}}</label>
      {{input value=this.settingsForm.relyingPartyName class="form-control"}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.rpId'}}</label>
      {{input value=this.settingsForm.relyingPartyId class="form-control" placeholder=(t 'authPage.mfa.settings.rpIdPlaceholder')}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.origin'}}</label>
      {{input value=this.settingsForm.origin class="form-control" placeholder=(t 'authPage.mfa.settings.originPlaceholder')}}
    </div>
  </div>
  <p class="help-block">{{t 'authPage.mfa.settings.webAuthnHelp'}}</p>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.passkeyCounterPolicy'}}</label>
      {{new-select classNames="form-control"
        content=this.passkeyCounterChoices
        localizedLabel=true
        optionValuePath="value"
        value=this.settingsForm.passkeyCounterPolicy}}
    </div>
    <div class="col-md-8">
      <p class="help-block">{{t 'authPage.mfa.settings.passkeyCounterHelp'}}</p>
    </div>
  </div>

  <h3>{{t 'authPage.mfa.settings.verificationProtection'}}</h3>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.maximumFailedAttempts'}}</label>
      {{input type="number" min="5" max="50" value=this.settingsForm.maximumFailedAttempts class="form-control"}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.lockoutSeconds'}}</label>
      {{input type="number" min="30" max="3600" value=this.settingsForm.lockoutSeconds class="form-control"}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.securityConfirmationTtlSeconds'}}</label>
      {{input type="number" min="60" max="900" value=this.settingsForm.securityConfirmationTtlSeconds class="form-control"}}
    </div>
  </div>
  <p class="help-block">{{t 'authPage.mfa.settings.verificationProtectionHelp'}}</p>

  <h3>{{t 'authPage.mfa.settings.federatedMfa'}}</h3>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.federatedMfaMode'}}</label>
      {{new-select classNames="form-control"
        content=this.federatedMfaChoices
        localizedLabel=true
        optionValuePath="value"
        value=this.settingsForm.federatedMfaMode}}
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.maximumFederatedAuthenticationAgeSeconds'}}</label>
      {{input type="number" min="60" max="3600" value=this.settingsForm.maximumFederatedAuthenticationAgeSeconds class="form-control"}}
    </div>
  </div>
  <div class="row">
    <div class="col-md-6 form-group">
      <label>{{t 'authPage.mfa.settings.trustedAuthenticationMethods'}}</label>
      {{input value=this.settingsForm.trustedAuthenticationMethods class="form-control" placeholder=(t 'authPage.mfa.settings.trustedAuthenticationMethodsPlaceholder')}}
    </div>
    <div class="col-md-6 form-group">
      <label>{{t 'authPage.mfa.settings.trustedAuthenticationContexts'}}</label>
      {{input value=this.settingsForm.trustedAuthenticationContexts class="form-control"}}
    </div>
  </div>
  <div class="alert alert-warning">
    {{t 'authPage.mfa.settings.federatedMfaWarning'}}
  </div>

  <h3>{{t 'authPage.mfa.settings.smtp'}}</h3>
  <p class="help-block">{{t 'authPage.mfa.settings.smtpHelp'}}</p>
  <div class="checkbox">
    <label>{{input type="checkbox" checked=this.settingsForm.smtpEnabled}} {{t 'authPage.mfa.settings.smtpEnabled'}}</label>
  </div>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.smtpHost'}}</label>
      {{input value=this.settingsForm.smtpHost class="form-control"}}
    </div>
    <div class="col-md-2 form-group">
      <label>{{t 'authPage.mfa.settings.smtpPort'}}</label>
      {{input type="number" min="1" max="65535" value=this.settingsForm.smtpPort class="form-control"}}
    </div>
    <div class="col-md-3 form-group">
      <label>{{t 'authPage.mfa.settings.smtpUsername'}}</label>
      {{input value=this.settingsForm.smtpUsername class="form-control" autocomplete="off"}}
    </div>
    <div class="col-md-3 form-group">
      <label>{{t 'authPage.mfa.settings.smtpPassword'}}</label>
      {{input type="password" value=this.settingsForm.smtpPassword class="form-control" autocomplete="new-password"}}
      {{#if this.settingsForm.smtpPasswordConfigured}}
        <div class="checkbox">
          <label>
            {{input type="checkbox" checked=this.settingsForm.smtpClearPassword}}
            {{t 'authPage.mfa.settings.smtpClearPassword'}}
          </label>
        </div>
      {{/if}}
    </div>
  </div>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.smtpFrom'}}</label>
      {{input type="email" value=this.settingsForm.smtpFrom class="form-control"}}
    </div>
    <div class="col-md-4">
      <div class="checkbox">
        <label>{{input type="checkbox" checked=this.settingsForm.smtpStartTls}} {{t 'authPage.mfa.settings.startTls'}}</label>
      </div>
      <div class="checkbox">
        <label>{{input type="checkbox" checked=this.settingsForm.smtpSsl}} {{t 'authPage.mfa.settings.implicitTls'}}</label>
      </div>
    </div>
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.codeTtl'}}</label>
      {{input type="number" min="60" max="600" value=this.settingsForm.emailCodeTtlSeconds class="form-control"}}
    </div>
  </div>
  <div class="row">
    <div class="col-md-4 form-group">
      <label>{{t 'authPage.mfa.settings.securityEmailLocale'}}</label>
      {{new-select classNames="form-control"
        content=this.securityEmailLocaleChoices
        localizedLabel=true
        optionValuePath="value"
        value=this.settingsForm.securityEmailLocale}}
    </div>
  </div>
  <div class="row">
    <div class="col-md-6 form-group">
      <label>{{t 'authPage.mfa.settings.testRecipient'}}</label>
      {{input type="email" value=this.testRecipient class="form-control"}}
    </div>
    <div class="col-md-6 r-pt25">
      <button type="button" class="btn btn-default" disabled={{this.busy}}
              {{action "saveSettings" true}}>
        {{t 'authPage.mfa.settings.saveAndTest'}}
      </button>
    </div>
  </div>
  <button type="button" class="btn btn-primary" disabled={{this.busy}}
          {{action "saveSettings" false}}>
    {{#if this.busy}}<i class="icon icon-spinner icon-spin"></i>{{/if}}
    {{t 'generic.save'}}
  </button>
</section>

<section class="header clearfix" data-testid="mfa-account-management-heading">
  <h2>{{t 'authPage.mfa.accountManagement.header'}}</h2>
  <p class="help-block">{{t 'authPage.mfa.accountManagement.help'}}</p>
</section>

<section class="well" data-testid="mfa-account-management">
  <div class="row">
    <div class="col-md-4">
      <label>{{t 'authPage.mfa.account'}}</label>
      {{new-select
        classNames="form-control"
        content=this.accountChoices
        optionLabelPath="label"
        optionValuePath="value"
        value=this.selectedAccountId
        action=(action "selectAccount")
      }}
    </div>
    <div class="col-md-8">
      {{partial "mfa-status-summary"}}
    </div>
  </div>
</section>

{{partial "mfa-self-service"}}

<section class="well danger-zone">
  <h2>{{t 'authPage.mfa.danger.header'}}</h2>
  <p>{{t 'authPage.mfa.danger.help'}}</p>
  <button type="button" class="btn btn-danger" disabled={{this.busy}}
          {{action "revokeAllFactors"}}>
    {{t 'authPage.mfa.danger.revokeAll'}}
  </button>
</section>
