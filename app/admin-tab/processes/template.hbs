<section class="header clearfix">
  <h1>{{t 'processesPage.header'}}</h1>
</section>
<section class="processes">
  <div class="lacsso tabs">
    <ul class="lacsso tab-header">
      <li class="lacsso"><LinkTo @route="admin-tab.processes.index" @replace={{true}} class="lacsso">{{t 'processesPage.tab.summary'}}</LinkTo></li>
      <li class="lacsso hide"><LinkTo @route="admin-tab.processes.pools" @replace={{true}} class="lacsso">{{t 'processesPage.tab.pools'}}</LinkTo></li>
      <li class="lacsso"><LinkTo @route="admin-tab.processes.list" @query={{hash which="running"}} @replace={{true}} class="lacsso">{{t 'processesPage.tab.running'}}</LinkTo></li>
      <li class="lacsso"><LinkTo @route="admin-tab.processes.list" @query={{hash which="ready"}} @replace={{true}} class="lacsso">{{t 'processesPage.tab.ready'}}</LinkTo></li>
      <li class="lacsso"><LinkTo @route="admin-tab.processes.list" @query={{hash which="delayed"}} @replace={{true}} class="lacsso">{{t 'processesPage.tab.delayed'}}</LinkTo></li>
      <li class="lacsso"><LinkTo @route="admin-tab.processes.list" @query={{hash which="completed"}} @replace={{true}} class="lacsso">{{t 'processesPage.tab.completed'}}</LinkTo></li>
    </ul>
    <div class="lacsso tab-content">
      {{outlet}}
    </div>
  </div>
</section>
