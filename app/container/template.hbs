<section class="header clearfix">
  <h1><LinkTo @route="containers">{{t 'containersPage.containerPage.header'}}</LinkTo></h1>
  <PowerSelect @options={{this.model.primaryHost.arrangedInstances}} @selected={{this.model}} @onChange={{action "changeContainer"}} @searchField="displayName" as |obj|>
    <span class="clip r-mr15">
      {{select-dot model=obj}}
    </span>
  </PowerSelect>

  <div class="pull-right">
    {{action-menu model=this.model  classNames="r-ml5 pull-right"  size="sm"}}
    {{header-state model=this.model classNames="pull-right"}}
  </div>

</section>

<section>
  <div class="row">
    <div class="col-md-3 r-mb15">
      {{#if this.model.description}}
        <div>
          <label class="block">{{t 'containersPage.containerPage.infoMultiStats.description'}}</label>
          <div>{{this.model.description}}</div>
        </div>

        <hr>
      {{/if}}

      {{#if this.model.primaryService}}
          <label class="block">{{t 'containersPage.containerPage.infoMultiStats.stack'}}</label>

          <div><LinkTo @route="stack" @model={{this.model.primaryService.stackId}}>{{this.model.primaryService.stack.displayName}}</LinkTo>/<LinkTo @route="service" @models={{array this.model.primaryService.stackId this.model.primaryService.id}}>{{this.model.primaryService.displayName}}</LinkTo></div>
        <hr>
      {{/if}}

      <div>
        <label class="block">{{t 'containersPage.containerPage.infoMultiStats.host'}}</label>
        {{#if this.model.primaryHost}}
          <LinkTo @route="host" @model={{this.model.primaryHost.id}}>{{this.model.primaryHost.displayName}}</LinkTo>
          {{copy-to-clipboard clipboardText=this.model.primaryHost.displayIp tooltipText=(t 'containersPage.containerPage.infoMultiStats.tooltip.host') size="small"}}
        {{else}}
          <span class="text-muted">{{t 'generic.none'}}</span>
        {{/if}}
      </div>

      {{#if this.model.memoryReservation}}
        <hr/>
        <div>
          <label class="block">{{t 'containersPage.containerPage.infoMultiStats.memoryReservation.labelText'}}</label>
          {{this.model.memoryReservationBlurb}}
        </div>

      {{/if}}

      {{#if this.model.milliCpuReservation}}
        <hr/>
        <div>
          <label class="block">{{t 'containersPage.containerPage.infoMultiStats.milliCpuReservation.labelText'}}</label>
          {{this.model.milliCpuReservation}}
        </div>
      {{/if}}
      <hr>

      <div>
        <label class="block">{{t 'containersPage.containerPage.infoMultiStats.ip'}}</label>
        {{copy-ip ip=this.model.displayIp showCopy=true}}
      </div>

      <hr>

      <div>
        <label class="block">{{t 'containersPage.containerPage.infoMultiStats.docker'}}</label>
        {{#if this.model.displayExternalId}}
          {{this.model.displayExternalId}} {{copy-to-clipboard clipboardText=this.model.externalId size='small'}}
        {{else}}
          <span class="text-muted">{{t 'generic.none'}}</span>
        {{/if}}
      </div>

      <hr>

      <div>
        <label class="block">{{t 'containersPage.containerPage.infoMultiStats.image'}}</label>
        <span class="force-wrap">
          {{this.model.displayImage}} {{copy-to-clipboard clipboardText=this.model.displayImage size='small'}}
        </span>
      </div>

      <hr>

      <div>
        <label class="block">{{t 'containersPage.containerPage.infoMultiStats.created'}}</label>
        <span class="force-wrap">
          {{#tooltip-element inlineBlock=true type="tooltip-basic" tooltipTemplate="tooltip-static" model=(date-str this.model.created) tagName="span"}}
            {{date-from-now this.model.created}}
          {{/tooltip-element~}}
        </span>
      </div>
    </div>
    <div class="col-md-9">
      <div class="row">
        {{info-multi-stats model=this.model linkName="containerStats" single=true}}
      </div>
      <div class="row r-p15">
        <ul class="nav nav-tabs nav-tabs-well shadowed">
          <li><LinkTo @route="container.ports" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.ports'}}</LinkTo></li>
          <li><LinkTo @route="container.commands" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.command'}}</LinkTo></li>
          <li><LinkTo @route="container.volumes" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.volumes'}}</LinkTo></li>
          <li><LinkTo @route="container.networking" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.networking'}}</LinkTo></li>
          <li><LinkTo @route="container.security" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.security'}}</LinkTo></li>
          <li><LinkTo @route="container.healthcheck" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.healthCheck'}}</LinkTo></li>
          <li><LinkTo @route="container.labels" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.labels'}}</LinkTo></li>
          <li><LinkTo @route="container.scheduling" @replace={{true}}>{{t 'containersPage.containerPage.navTabs.scheduling'}}</LinkTo></li>
        </ul>
        <div class="table-flat well">
          {{outlet}}
        </div>
      </div>

    </div>
  </div>
</section>
