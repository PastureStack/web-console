#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

lock_path="docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json"

python3 - "$lock_path" <<'PY'
import json
import sys
from pathlib import Path

lock_path = Path(sys.argv[1])
failures = 0


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


package = json.loads(Path("package.json").read_text(encoding="utf-8"))
expected = "3.0.1"
actual = package.get("devDependencies", {}).get("ember-load-initializers")
if actual != expected:
    fail("UI_EMBER_LOAD_INITIALIZERS_VERSION_DRIFT", actual=actual, expected=expected)
if "ember-export-application-global" in package.get("devDependencies", {}):
    fail("UI_OBSOLETE_APPLICATION_GLOBAL_ADDON_PRESENT")

app_source = Path("app/app.js").read_text(encoding="utf-8")
for marker in ["class App extends Application", "Resolver = Resolver;"]:
    if marker not in app_source:
        fail("UI_NATIVE_APPLICATION_BOOT_MARKER_MISSING", marker=marker)
if "Application.extend(" in app_source:
    fail("UI_CLASSIC_APPLICATION_BOOT_PRESENT")

global_initializer = Path("app/initializers/export-application-global.js").read_text(encoding="utf-8")
for marker in ["import { classify } from '@ember/string';", "classify(config.modulePrefix)"]:
    if marker not in global_initializer:
        fail("UI_APPLICATION_GLOBAL_INITIALIZER_MARKER_MISSING", marker=marker)
if "from 'ember'" in global_initializer:
    fail("UI_APPLICATION_GLOBAL_INITIALIZER_USES_REMOVED_EMBER_MODULE")

if not lock_path.is_file():
    fail("UI_EMBER_LOAD_INITIALIZERS_LOCK_MISSING", file=lock_path)
else:
    lock = json.loads(lock_path.read_text(encoding="utf-8"))
    packages = lock.get("packages", {})
    root = packages.get("", {})
    root_actual = root.get("devDependencies", {}).get("ember-load-initializers")
    resolved = packages.get("node_modules/ember-load-initializers", {})
    resolved_version = resolved.get("version")
    resolved_deps = resolved.get("dependencies", {})

    if root_actual != expected:
        fail("UI_EMBER_LOAD_INITIALIZERS_LOCK_ROOT_DRIFT", actual=root_actual, expected=expected)
    if resolved_version != expected:
        fail("UI_EMBER_LOAD_INITIALIZERS_LOCK_VERSION_DRIFT", actual=resolved_version, expected=expected)
    if resolved_deps:
        fail("UI_EMBER_LOAD_INITIALIZERS_UNEXPECTED_RUNTIME_DEPS", actual=sorted(resolved_deps))
    if "node_modules/ember-export-application-global" in packages:
        fail("UI_OBSOLETE_APPLICATION_GLOBAL_ADDON_LOCKED")

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(f"UI_EMBER_LOAD_INITIALIZERS_UPGRADE_OK version={expected} lockfile={lock_path}")
print("The initializer loader and application bootstrap use the maintained Ember 7.2 boundary without the removed global Ember module.")
print("failure_count=0")
PY
