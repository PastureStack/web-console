#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import json
import sys
from pathlib import Path

failures = 0

def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())

package = json.loads(Path("package.json").read_text(encoding="utf-8"))
lock_path = Path("package-lock.json")
dev = package.get("devDependencies", {})
overrides = package.get("overrides", {})
if "osenv" in dev:
    fail("OSENV_DEV_DEP_REINTRODUCED", actual=dev.get("osenv"))
if "osenv" in overrides:
    fail("OSENV_OVERRIDE_REINTRODUCED", actual=overrides.get("osenv"))

lock = json.loads(lock_path.read_text(encoding="utf-8"))
packages = lock.get("packages", {})
root = packages.get("", {})
if package.get("devDependencies", {}) != root.get("devDependencies", {}):
    fail("OSENV_COMPAT_LOCK_ROOT_DEV_DEP_DRIFT")
resolved_osenv = [
    (path, meta.get("version"))
    for path, meta in sorted(packages.items())
    if path == "node_modules/osenv" or path.endswith("/node_modules/osenv")
]
for path, version in resolved_osenv:
    fail("OSENV_LOCK_PACKAGE_REINTRODUCED", package=path, version=version)

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)
print(f"UI_OSENV_REMOVAL_OK osenv=absent lockfile={lock_path}")
print("The modern development graph no longer resolves osenv; no compatibility override is active.")
print("failure_count=0")
PY
