#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

python3 - <<'PY_CHECK'
import json
from pathlib import Path

bower = json.loads(Path("bower.json").read_text())
if "dagre" in bower.get("dependencies", {}):
    raise SystemExit("bower.json must not depend on dagre")

package = json.loads(Path("package.json").read_text())
dependencies = package.get("devDependencies", {})
if dependencies.get("dagre-d3-es") != "7.0.14":
    raise SystemExit("package.json must pin dagre-d3-es 7.0.14")
for retired in ["dagre", "graphlib"]:
    if retired in dependencies:
        raise SystemExit(f"package.json must not retain unmaintained {retired}")
PY_CHECK

if grep -R "bower_components/graphlib\|bower_components/dagre" -n ember-cli-build.js app tests 2>/dev/null; then
  echo "dagre/graphlib must be imported from npm paths, not Bower" >&2
  exit 1
fi

if grep -q "vendor/dagre-d3\|node_modules/graphlib\|node_modules/dagre/dist" ember-cli-build.js scripts/node24-lock-smoke.js; then
  echo "legacy dagre browser globals must not remain active" >&2
  exit 1
fi
grep -q "from 'dagre-d3-es'" app/components/stack-graph/component.js
grep -q "d3.zoom()" app/components/stack-graph/component.js
grep -q "d3.zoomIdentity" app/components/stack-graph/component.js
grep -q "arrowheadClass" app/components/stack-graph/component.js
grep -q "curve: d3.curveBundle.beta(1)" app/components/stack-graph/component.js
grep -q "expectDagreD3ESModules" scripts/node24-lock-smoke.js
grep -q "dagreLayout.layout(graph)" scripts/node24-lock-smoke.js
grep -q "dagre-d3 stack graph layout smoke failed" scripts/node24-lock-smoke.js

if ! grep -q "setDefaultEdgeLabel(function()" app/components/stack-graph/component.js; then
  echo "stack graph must define a default dagre edge label for compatibility with disconnected service graphs" >&2
  exit 1
fi


echo "ui-dagre-d3-es-modernization-ok"
