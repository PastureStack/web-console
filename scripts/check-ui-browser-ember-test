#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

node_image=${PASTURESTACK_NODE24_IMAGE:-node:24.22.1-bookworm@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a}
launcher=${PASTURESTACK_UI_TESTEM_LAUNCHER:-chromium}
chromium_package=${PASTURESTACK_CHROMIUM_APT_PACKAGE:-chromium}

if ! command -v docker >/dev/null 2>&1; then
  echo "UI_BROWSER_EMBER_TEST_DOCKER_MISSING image=$node_image"
  exit 1
fi

docker run --rm \
  -v "$repo_root:/src:ro" \
  -e "PASTURESTACK_UI_TESTEM_LAUNCHER=$launcher" \
  -e "PASTURESTACK_CHROMIUM_APT_PACKAGE=$chromium_package" \
  -e "PASTURESTACK_UI_TEST_FILTER=${PASTURESTACK_UI_TEST_FILTER:-}" \
  "$node_image" \
  bash -lc '
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    apt-get update >/dev/null
    apt-get install -y --no-install-recommends "$PASTURESTACK_CHROMIUM_APT_PACKAGE" ca-certificates fonts-noto-core fonts-noto-cjk fontconfig >/dev/null
    # Minimal Chromium installs otherwise measure CJK fallback/tofu glyphs,
    # not the actual localized text used by the viewport regressions.
    test -n "$(fc-list :lang=zh-tw)"
    test -n "$(fc-list :lang=fa)"
    fc-match -f "%{family}\n" :lang=zh-tw
    fc-match -f "%{family}\n" :lang=fa
    echo UI_BROWSER_LOCALE_FONTS_OK

    tmpdir=$(mktemp -d)
    cleanup() {
      rm -rf "$tmpdir"
    }
    trap cleanup EXIT

    cp -a /src/. "$tmpdir/"
    cd "$tmpdir"
    cmp package-lock.json docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json
    test "$(node --version)" = v24.22.1
    npm install --global --ignore-scripts --no-audit --no-fund npm@12.0.2 >/dev/null
    test "$(npm --version)" = 12.0.2

    npm ci --ignore-scripts --no-audit --no-fund
    if [[ "$PASTURESTACK_UI_TESTEM_LAUNCHER" = "chromium" ]]; then
      export CHROME_BIN="${CHROME_BIN:-/usr/bin/chromium}"
    fi
    args=(--ssl=false --host 127.0.0.1 --config-file testem.js)
    if [[ -n "$PASTURESTACK_UI_TEST_FILTER" ]]; then
      args+=(--filter "$PASTURESTACK_UI_TEST_FILTER")
    fi
    ./node_modules/.bin/ember test "${args[@]}"
  '

echo "UI_BROWSER_EMBER_TEST_OK image=$node_image launcher=$launcher"
echo "failure_count=0"
