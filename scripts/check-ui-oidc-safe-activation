#!/usr/bin/env bash
set -euo pipefail

controller=app/admin-tab/auth/oidc/controller.js
access_service=app/services/access.js
controller_test=tests/unit/admin-tab/auth/oidc/controller-test.js
access_test=tests/unit/services/access-test.js

for marker in \
  "activateWithCodeFlow: function(code)" \
  "enabled: false" \
  "sessionSnapshot = this.get('access').suspendSession()" \
  "return this.get('access').login(code, 'oidcconfig')" \
  "model.set('enabled', true)" \
  "this.get('access').restoreSession(sessionSnapshot)"; do
  grep -F "$marker" "$controller" >/dev/null
done

for marker in \
  "suspendSession()" \
  "restoreSession(snapshot)" \
  "this.clearSessionKeys()" \
  "this.get('cookies').setWithOptions(C.COOKIE.TOKEN, snapshot.token"; do
  grep -F "$marker" "$access_service" >/dev/null
done

for marker in \
  "stages OIDC with security disabled and restores the local session after login failure" \
  "enables OIDC only after the new platform session exists"; do
  grep -F "$marker" "$controller_test" >/dev/null
done

grep -F "suspends and restores the current provider session around activation" \
  "$access_test" >/dev/null

printf '%s\n' \
  'UI_OIDC_SAFE_ACTIVATION_OK staged_disabled=1 old_cookie_suspended=1 provider_rollback_before_session_restore=1 enable_after_login=1'
