#!/usr/bin/env python3
import hashlib
import json
import re
import tarfile
from pathlib import Path

repo = Path(__file__).resolve().parents[1]
package_path = repo / "package.json"
lock_path = repo / "docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json"

package = json.loads(package_path.read_text(encoding="utf-8"))
lock = json.loads(lock_path.read_text(encoding="utf-8"))
packages = lock.get("packages", {})
compat_spec = "file:vendor/ember-fetch-compat/ember-fetch-5.1.3-pasturestack.6.tgz"
api_store_compat_spec = "file:vendor/ember-api-store-compat/ember-api-store-2.8.5-pasturestack.2.tgz"


def fail(message):
    raise SystemExit(message)


def package_entry(path):
    item = packages.get(path)
    if not item:
        fail(f"missing lock package path: {path}")
    return item


if package.get("devDependencies", {}).get("ember-api-store") != api_store_compat_spec:
    fail("package.json must use the reviewed ember-api-store compatibility package")
if package.get("devDependencies", {}).get("ember-fetch") != compat_spec:
    fail("package.json must use the reviewed ember-fetch browser-global compatibility package")

root_deps = packages.get("", {}).get("devDependencies", {})
if root_deps.get("ember-api-store") != api_store_compat_spec:
    fail("lock root must use the reviewed ember-api-store compatibility package")
if root_deps.get("ember-fetch") != compat_spec:
    fail("lock root must use the reviewed ember-fetch compatibility package")

api_store = package_entry("node_modules/ember-api-store")
if api_store.get("version") != "2.8.5":
    fail(f"lock resolves ember-api-store {api_store.get('version')} instead of 2.8.5")
if api_store.get("resolved") != api_store_compat_spec:
    fail(f"lock resolves unreviewed ember-api-store source {api_store.get('resolved')}")

api_store_deps = api_store.get("dependencies", {})
expected_api_store_deps = {
    "ember-auto-import": "2.13.1",
    "ember-cli-babel": "8.3.1",
    "ember-fetch": "^5.1.1",
    "set-cookie-parser": "2.7.2",
}
if api_store_deps != expected_api_store_deps:
    fail(f"ember-api-store reviewed dependency boundary changed: {api_store_deps}")

ember_fetch = package_entry("node_modules/ember-fetch")
if ember_fetch.get("version") != "5.1.3":
    fail(f"lock resolves ember-fetch {ember_fetch.get('version')} instead of 5.1.3")
if ember_fetch.get("resolved") != compat_spec:
    fail(f"lock resolves unreviewed ember-fetch source {ember_fetch.get('resolved')}")
if ember_fetch.get("dependencies") != {"ember-cli-babel": "8.3.1"}:
    fail(f"native ember-fetch compatibility package has an unexpected build boundary: {ember_fetch.get('dependencies')}")

auto_import = package_entry("node_modules/ember-auto-import")
if auto_import.get("version") != "2.13.1":
    fail(f"lock resolves ember-auto-import {auto_import.get('version')} instead of 2.13.1")
if "node_modules/ember-api-store/node_modules/ember-auto-import" in packages:
    fail("ember-api-store retained the obsolete ember-auto-import 1.x build graph")

compat_dir = repo / "vendor/ember-fetch-compat"
runtime_path = compat_dir / "vendor/ember-fetch.js"
archive_path = compat_dir / "ember-fetch-5.1.3-pasturestack.6.tgz"
license_path = compat_dir / "LICENSE.md"
upstream_path = compat_dir / "UPSTREAM.md"
for required in [runtime_path, archive_path, license_path, upstream_path]:
    if not required.is_file():
        fail(f"reviewed ember-fetch compatibility file missing: {required.relative_to(repo)}")

if hashlib.sha256(archive_path.read_bytes()).hexdigest() != "0a504cb75b7ce5bcc68329b32d3fae1e9434233b3f243560d09a484c248ede02":
    fail("reviewed ember-fetch compatibility archive hash changed")
if hashlib.sha256(license_path.read_bytes()).hexdigest() != "bae5cb45df11b4fa8e894ae3b9b13595e154ade61ee6c57d5cfcd422771153a7":
    fail("ember-fetch upstream MIT license changed")

runtime = runtime_path.read_text(encoding="utf-8")
for marker in [
    "define('fetch', ['exports'], function(exports)",
    "typeof globalThis !== 'undefined'",
    "Object.defineProperty(exports, name",
    "global.fetch.apply(global, arguments)",
    "AbortController",
]:
    if marker not in runtime:
        fail(f"ember-fetch native compatibility marker missing: {marker}")
for forbidden in [
    "Ember.Test",
    "registerWaiter",
    "abortcontroller-polyfill",
    "node-fetch",
    "whatwg-fetch",
    "rollup",
    "babel-core",
]:
    if forbidden in runtime:
        fail(f"ember-fetch native runtime contains obsolete build marker: {forbidden}")

with tarfile.open(archive_path, "r:gz") as archive:
    archived_runtime = archive.extractfile("package/vendor/ember-fetch.js")
    if archived_runtime is None or archived_runtime.read() != runtime_path.read_bytes():
        fail("ember-fetch compatibility source and install archive differ")

api_store_compat_dir = repo / "vendor/ember-api-store-compat"
api_store_archive = api_store_compat_dir / "ember-api-store-2.8.5-pasturestack.2.tgz"
api_store_package_path = api_store_compat_dir / "package.json"
api_store_license_path = api_store_compat_dir / "LICENSE"
api_store_upstream_path = api_store_compat_dir / "UPSTREAM.md"
for required in [api_store_archive, api_store_package_path, api_store_license_path, api_store_upstream_path]:
    if not required.is_file():
        fail(f"reviewed ember-api-store compatibility file missing: {required.relative_to(repo)}")
if hashlib.sha256(api_store_archive.read_bytes()).hexdigest() != "91fedcf4e3d950567c4fd323cf31f1dac64948220fae9f29f63c76872b405453":
    fail("reviewed ember-api-store compatibility archive hash changed")
if hashlib.sha256(api_store_license_path.read_bytes()).hexdigest() != "0d542e0c8804e39aa7f37eb00da5a762149dc682d7829451287e11b938e94594":
    fail("ember-api-store upstream Apache-2.0 license changed")
api_store_package = json.loads(api_store_package_path.read_text(encoding="utf-8"))
if api_store_package.get("dependencies") != expected_api_store_deps:
    fail("ember-api-store compatibility source metadata changed")
if api_store_package.get("pasturestackCompatibility", {}).get("revision") != 2:
    fail("ember-api-store compatibility revision marker is missing")
with tarfile.open(api_store_archive, "r:gz") as archive:
    for relative in ["package.json", "LICENSE", "UPSTREAM.md"]:
        archived = archive.extractfile(f"package/{relative}")
        source = api_store_compat_dir / relative
        if archived is None or archived.read() != source.read_bytes():
            fail(f"ember-api-store compatibility source and install archive differ: {relative}")

for forbidden in [
    "node_modules/ember-network",
    "node_modules/babel-traverse",
    "node_modules/babel-core",
    "node_modules/broccoli-rollup",
    "node_modules/rollup-plugin-babel",
    "node_modules/ember-route-action-helper",
]:
    if forbidden in packages:
        fail(f"forbidden dependency returned to lock: {forbidden}")

initializer_compat = repo / "app/utils/initialize-api-store.js"
if not initializer_compat.is_file():
    fail("ember-api-store Ember 6 initializer compatibility boundary is missing")
initializer_compat_text = initializer_compat.read_text(encoding="utf-8")
for marker in [
    "application.register(`service:${serviceName}`, Store)",
    "application.hasRegistration('model:resource')",
    "import { getOwner, setOwner } from '@ember/application'",
    "adoptStoreOwner(this._super(...arguments), this)",
    "this._group(type).forEach((instance) => adoptStoreOwner(instance, this))",
    "properties[propertyName] = service(serviceName)",
    "injectService(Controller, propertyName, serviceName)",
    "injectService(Route, propertyName, serviceName)",
    "injectService(Component, propertyName, serviceName)",
]:
    if marker not in initializer_compat_text:
        fail(f"ember-api-store initializer compatibility marker missing: {marker}")
if ".inject(" in initializer_compat_text:
    fail("removed registry injection API returned to ember-api-store compatibility boundary")

store_initializers = [
    repo / "app/initializers/ember-api-store.js",
    repo / "app/initializers/auth-store.js",
    repo / "app/initializers/user-store.js",
    repo / "app/initializers/webhook-store.js",
]
for initializer_path in store_initializers:
    if not initializer_path.is_file():
        fail(f"local ember-api-store initializer missing: {initializer_path.relative_to(repo)}")
    initializer_text = initializer_path.read_text(encoding="utf-8")
    if "ui/utils/initialize-api-store" not in initializer_text:
        fail(f"local ember-api-store initializer bypasses compatibility boundary: {initializer_path.relative_to(repo)}")
    if "ember-api-store/initializers/store" in initializer_text:
        fail(f"removed addon registry injector remains active: {initializer_path.relative_to(repo)}")

reference_compat = repo / "app/utils/api-store-references.js"
if not reference_compat.is_file():
    fail("ember-api-store reference compatibility boundary is missing")
reference_compat_text = reference_compat.read_text(encoding="utf-8")
for marker in [
    "computed(field",
    "import { computed, get } from '@ember/object'",
    "store._state.watchReference",
    "store._state.missingReference",
    "set(_computedKey, value)",
    "referenceTypeForField(field, true)",
    "referencedType || referenceTypeForField(field)",
]:
    if marker not in reference_compat_text:
        fail(f"ember-api-store reference compatibility marker missing: {marker}")
if "ember-api-store/utils/denormalize" in reference_compat_text:
    fail("reference compatibility boundary must own the Ember 6 relationship setters")

reference_tests = (repo / "tests/unit/utils/api-store-references-test.js").read_text(encoding="utf-8")
for marker in [
    "accepts expanded API relationships without a missing computed setter",
    "resolves ID relationships and registers reference watches",
]:
    if marker not in reference_tests:
        fail(f"ember-api-store reference regression test missing: {marker}")

reference_models = []
for model_path in sorted((repo / "app/models").glob("*.js")):
    model_text = model_path.read_text(encoding="utf-8")
    if "ember-api-store/utils/denormalize" in model_text:
        fail(f"model bypasses API-store reference compatibility boundary: {model_path.relative_to(repo)}")
    if "ui/utils/api-store-references" in model_text:
        reference_models.append(model_path)
if len(reference_models) != 13:
    fail(f"unexpected API-store reference model count: {len(reference_models)}")

runtime_packages = {
    "bootstrap-multiselect": {
        "version": "2.0.0",
        "integrity": "sha512-m8dTwF+mLlpt8PtXfAXyERJLOGNuNrVuU9aQi2WMfwfwSzhgN+LbTaRuTk8Y15NZiMzy2m/FPfhKKgOOJxk2WQ==",
        "license_sha256": "e87a389b5937ef5ba537318b1502d80dbe9748617d853e7ea2bb4bd1451ccde5",
        "license": "Apache License, Version 2.0 OR BSD 3-Clause License",
    },
    "ember-power-select": {
        "version": "9.0.2",
        "integrity": "sha512-XsbvnIhdeL/HJSThsLgJCMgYKJIn6HFLgWRARJffsMfUE1hsW5XAL8pQkGA5iBpl69cZ3RA5U5ljttZDQoR/rg==",
        "license_sha256": "fee7ff7079edfdbac1c78d0329da16ae9b6ef73405cec197ed6136ddf1d70117",
    },
    "ember-basic-dropdown": {
        "version": "9.0.0",
        "integrity": "sha512-v14n7srtuHyZEgy+uESN/sN5UtavfnCrZ70i+iUlzfTgMc/Mq0U9pteilNVftn6CSiHvV8o2SRaRauvKYNJFBA==",
        "license_sha256": "fee7ff7079edfdbac1c78d0329da16ae9b6ef73405cec197ed6136ddf1d70117",
    },
    "ember-concurrency": {
        "version": "5.2.0",
        "integrity": "sha512-NUptPzaxaF2XWqn3VQ5KqiLSRqPFIZhWXH3UkOMhiedmiolxGYjUV96maoHWdd5msxNgQBC0UkZ28m7pV7A0sQ==",
        "license_sha256": "c7543891093cb613eeb5a90c16a18fa25b8708a0c7c1c67691202384ff9b6567",
    },
    "ember-modifier": {
        "version": "4.3.0",
        "integrity": "sha512-O0rirSLQbGg0VJ/NqoQ4uN1bh2iAekZC/Ykma+FkjCM2ofrO38u+d8n3+AK6uVWeMJmogGX2KL+Is5fofoInJg==",
        "license_sha256": "0390d452d98169895ab1ca8c14d35471642759366d51e1cfd014ded8bb10c51d",
    },
}
for package_name, expected in runtime_packages.items():
    version = expected["version"]
    if package.get("devDependencies", {}).get(package_name) != version:
        fail(f"package.json must pin {package_name} to {version}")
    if root_deps.get(package_name) != version:
        fail(f"lock root must pin {package_name} to {version}")
    runtime_entry = package_entry(f"node_modules/{package_name}")
    expected_resolved = f"https://registry.npmjs.org/{package_name}/-/{package_name}-{version}.tgz"
    if runtime_entry.get("version") != version:
        fail(f"lock resolves {package_name} {runtime_entry.get('version')} instead of {version}")
    if runtime_entry.get("resolved") != expected_resolved:
        fail(f"lock resolves unreviewed {package_name} source {runtime_entry.get('resolved')}")
    if runtime_entry.get("integrity") != expected["integrity"]:
        fail(f"lock integrity changed for {package_name}")
    expected_license = expected.get("license", "MIT")
    if runtime_entry.get("license") != expected_license:
        fail(f"lock license changed for {package_name}: {runtime_entry.get('license')}")

    legal_dir = repo / "vendor" / "runtime-licenses" / package_name
    runtime_license = legal_dir / "LICENSE.md"
    runtime_upstream = legal_dir / "UPSTREAM.md"
    for required in [runtime_license, runtime_upstream]:
        if not required.is_file():
            fail(f"runtime legal file missing: {required.relative_to(repo)}")
    if hashlib.sha256(runtime_license.read_bytes()).hexdigest() != expected["license_sha256"]:
        fail(f"runtime license changed for {package_name}")
    upstream_text = runtime_upstream.read_text(encoding="utf-8")
    for marker in [
        f"- Upstream package: `{package_name}`",
        f"- Upstream version: `{version}`",
        f"- Upstream tarball: `{expected_resolved}`",
        f"- npm integrity: `{expected['integrity']}`",
    ]:
        if marker not in upstream_text:
            fail(f"runtime provenance marker missing for {package_name}: {marker}")

template_roots = [
    repo / "app",
    repo / "vendor" / "lacsso" / "app",
    repo / "vendor" / "lacsso" / "upstream-templates",
]
template_paths = []
for template_root in template_roots:
    template_paths.extend(sorted(template_root.rglob("*.hbs")))

duplicate_action_context = re.compile(r"(?:\{\{|\()action\s+this\s+")
legacy_link_to = re.compile(r"\{\{#?link-to\b")
invalid_link_to_attribute = re.compile(r"<LinkTo\b[^>]*@(tagName|classNames|href)=", re.DOTALL)
legacy_power_select = re.compile(r"\{\{#power-select\b")
template_action_count = 0
power_select_count = 0
for template_path in template_paths:
    template = template_path.read_text(encoding="utf-8")
    relative = template_path.relative_to(repo)
    if duplicate_action_context.search(template):
        fail(f"template action duplicates the compiler-managed context: {relative}")
    if legacy_link_to.search(template):
        fail(f"legacy positional LinkTo remains: {relative}")
    if invalid_link_to_attribute.search(template):
        fail(f"invalid modern LinkTo attribute remains: {relative}")
    if legacy_power_select.search(template):
        fail(f"legacy PowerSelect invocation remains: {relative}")
    if "(route-action" in template or "{{route-action" in template:
        fail(f"unmaintained route-action helper remains: {relative}")
    if "{{#if hasBlock" in template or "{{if hasBlock" in template:
        fail(f"legacy hasBlock property remains: {relative}")
    template_action_count += len(re.findall(r"(?:\{\{|\()action\s+", template))
    power_select_count += template.count("<PowerSelect")

storage_template = (repo / "app/host/storage/template.hbs").read_text(encoding="utf-8")
if 'pageSizeChanged=(action "storagePageSizeChanged")' not in storage_template:
    fail("storage page-size callback is missing from the host storage table")

if template_action_count != 494:
    fail(f"unexpected template action count: {template_action_count}")
if power_select_count != 11:
    fail(f"unexpected modern PowerSelect count: {power_select_count}")

action_compat_paths = [
    repo / "app" / "helpers" / "action.js",
    repo / "app" / "modifiers" / "action.js",
    repo / "app" / "utils" / "legacy-template-action.js",
    repo / "tests" / "unit" / "utils" / "legacy-template-action-test.js",
]
action_compat = "\n".join(path.read_text(encoding="utf-8") for path in action_compat_paths)
for marker in [
    "createLegacyClosureAction",
    "invokeLegacyModifierAction",
    "isAllowedActionEvent",
    "named.target === undefined ? context : named.target",
    "element.removeEventListener(eventName, handler)",
    "invokes a quoted action with curried and invocation arguments",
]:
    if marker not in action_compat:
        fail(f"template action compatibility marker missing: {marker}")
for forbidden in ["__container__", "_actions", "requireModule("]:
    if forbidden in action_compat:
        fail(f"template action compatibility uses a private runtime API: {forbidden}")

terminal_component = (repo / "app" / "components" / "workspace-terminal" / "component.js").read_text(encoding="utf-8")
terminal_tests = (repo / "tests" / "unit" / "components" / "workspace-terminal-test.js").read_text(encoding="utf-8")
for marker in [
    "function terminalCloseAction(options)",
    "this.get('socket') !== socket",
    "action === 'create'",
    "action === 'reconnect'",
    "probes a stale broker session before it has completed the handshake",
    "reconnects only after a live broker session disconnects",
]:
    if marker not in terminal_component + terminal_tests:
        fail(f"terminal reconnect regression marker missing: {marker}")

deprecated = [path for path, item in packages.items() if item.get("deprecated")]
print(
    "ui-ember-api-store-fetch-upgrade-ok "
    f"version=2.8.5 api_store_compat_revision=2 ember-fetch=5.1.3 fetch_compat_revision=6 initializer_compat_revision=2 reference_compat_revision=2 "
    f"ember6_template_compat_revision=1 terminal_reconnect_revision=2 "
    f"deprecated_count={len(deprecated)} package_count={len(packages)}"
)
