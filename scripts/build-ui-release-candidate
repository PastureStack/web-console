#!/usr/bin/env bash
set -euo pipefail

# The host launches this same script inside the immutable builder. Only source
# and a dedicated artifact directory cross the boundary; host SDKs do not.
builder_image='node:24.22.1-bookworm@sha256:6449e19d8184d84062525b6a7524def03146c2cb04a7f08b076680d0e8e4240a'

copy_release_source() {
  local source_dir=$1 destination=$2
  mkdir -p "$destination"
  tar -C "$source_dir" \
    --exclude='./.git' --exclude='./node_modules' --exclude='./dist' \
    --exclude='./build' --exclude='*/node_modules' \
    -cf - . | tar -xf - -C "$destination"
}

packaged_release_tree() {
  local archive=$1 destination=$2 version=$3
  mkdir -p "$destination"
  tar -xzf "$archive" -C "$destination"
  test "$(cat "$destination/$version/VERSION.txt")" = "$version"
  printf '%s\n' "$destination/$version"
}

capture_builder_inventory() {
  local output=$1
  python3 scripts/capture-ui-builder-inventory.py "$output"
  python3 - "$output" "$builder_image" "$GITHUB_SHA" <<'PY'
import json
from pathlib import Path
import shutil
import sys

file, image, commit = sys.argv[1:]
data = json.loads(Path(file).read_text(encoding="utf-8"))
assert data["producer"] == commit, "Builder source commit mismatch"
assert data["claims"]["rubyAbsent"] is True, "Ruby is present in the release builder"
assert not data["rubyBinaries"] and not data["rubyPackageBackports"], "Ruby inventory is not empty"
assert shutil.which("ruby") is None, "Ruby executable is present on builder PATH"
data["scope"] = "Isolated release container OS packages and bounded Ruby binary locations; not the GitHub host SDK inventory"
data["producerEnvironment"] = {"kind": "isolated-release-container", "image": image}
Path(file).write_text(json.dumps(data, sort_keys=True, indent=2) + "\n", encoding="utf-8")
print("UI_RELEASE_BUILDER_RUBY_ABSENT source=" + commit + " image=" + image)
PY
}

build_inside_container() {
  local source_dir=$1 output_dir=$2 package_version schema_dir verifier_manifest_sha verifier_lock_sha
  test -f /.dockerenv
  test "$(node --version)" = v24.22.1
  command -v python3 >/dev/null
  work_root=$(mktemp -d /tmp/pasturestack-ui-release.XXXXXX)
  [[ "$work_root" = /tmp/pasturestack-ui-release.* ]]
  trap 'rm -rf "$work_root"' EXIT
  copy_release_source "$source_dir" "$work_root/source"
  cd "$work_root/source"
  package_version=$(node -p 'require("./package.json").version')
  capture_builder_inventory "$output_dir/builder-container-inventory-before.json"

  npm install --global --ignore-scripts --no-audit --no-fund npm@12.0.2 >/dev/null
  test "$(npm --version)" = 12.0.2
  verifier_manifest_sha=$(sha256sum tools/sbom-verifier/package.json | awk '{print $1}')
  verifier_lock_sha=$(sha256sum tools/sbom-verifier/package-lock.json | awk '{print $1}')
  npm ci --ignore-scripts --no-audit --no-fund
  npm ci --prefix tools/sbom-verifier --ignore-scripts --no-audit --no-fund
  npm audit --prefix tools/sbom-verifier --audit-level=low
  schema_dir="$work_root/cyclonedx-1.6"
  mkdir -p "$schema_dir"
  for schema in bom-1.6.schema.json spdx.schema.json jsf-0.82.schema.json; do
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
      --retry 5 --retry-all-errors --output "$schema_dir/$schema" \
      "https://raw.githubusercontent.com/CycloneDX/specification/1.6/schema/$schema"
  done
  (
    cd "$schema_dir"
    printf '%s\n' \
      '3e92dddbc30cf7f6a02b80f0942b1a4cfd4fb1c26f1dfc4310afa9d613cafb93  bom-1.6.schema.json' \
      'baa9d3bd1ed57b6751b0887edead6b5063ff53ff7429cf85d476c6c94af0166e  spdx.schema.json' \
      '8bae002c25e723db7ee1f26afde680ae1a2b1a8f6b4b4b0fd65dc3becb090aae  jsf-0.82.schema.json' \
      | sha256sum --check
  )
  node --test scripts/test-ui-sbom.js scripts/test-ui-build-module-boundary.js scripts/test-ui-webpack-inventory.js
  python3 -B scripts/test-ui-builder-inventory.py
  python3 -B scripts/test-ui-builder-boundary.py
  if [[ "$VALIDATION_SCOPE" = sbom ]]; then
    bash scripts/check-ui-critical-high-dependencies
    node scripts/check-ui-npm-audit.js
  fi

  build_candidate() {
    local output=$1 canonical_dist
    rm -rf dist build/security-browser
    export CONCAT_STATS=1
    export CONCAT_STATS_PATH="$PWD/build/security-browser/concat-stats"
    export PASTURESTACK_MODULE_INVENTORY=1
    ./node_modules/.bin/ember build --environment production
    node scripts/check-ui-build-module-boundary.js
    bash scripts/package-static-candidate "$package_version" dist "$output"
    # The packager removes test chunks/maps/pseudo-locales and adds VERSION.txt.
    # Verify the original archive's canonical tree, not the pre-package dist.
    canonical_dist=$(packaged_release_tree "$output" "$output.tree" "$package_version")
    node scripts/generate-ui-sbom.js \
      --dist "$canonical_dist" --archive "$output" \
      --webpack-inventory build/security-browser/webpack-modules.json \
      --concat-stats build/security-browser/concat-stats \
      --verifier-root tools/sbom-verifier \
      --verifier-manifest-sha256 "$verifier_manifest_sha" --verifier-lock-sha256 "$verifier_lock_sha" \
      --source-commit "$GITHUB_SHA" --output-dir "$output.sbom"
    node scripts/verify-ui-sbom-schema.js "$schema_dir/bom-1.6.schema.json" \
      "$output.sbom/runtime.cdx.json" "$output.sbom/build.cdx.json"
  }

  build_candidate "$work_root/web-console-a.tar.gz"
  build_candidate "$work_root/web-console-b.tar.gz"
  cmp "$work_root/web-console-a.tar.gz" "$work_root/web-console-b.tar.gz"
  for document in runtime.cdx.json build.cdx.json artifact-manifest.json; do
    cmp "$work_root/web-console-a.tar.gz.sbom/$document" \
      "$work_root/web-console-b.tar.gz.sbom/$document"
  done
  test "$(tar -tzf "$work_root/web-console-a.tar.gz" | cut -d/ -f1 | sort -u)" = "$package_version"
  test "$(tar -xOzf "$work_root/web-console-a.tar.gz" "${package_version}/VERSION.txt")" = "$package_version"
  test "$(tar -tzf "$work_root/web-console-a.tar.gz" | grep -Ec "^${package_version}/translations/zh-tw\\.json$")" -eq 1
  if tar -tzf "$work_root/web-console-a.tar.gz" | grep -Eq '\.map$'; then
    echo WEB_CONSOLE_SOURCE_MAP_PRESENT >&2
    exit 1
  fi
  capture_builder_inventory "$output_dir/builder-container-inventory-after.json"

  local release_asset="$output_dir/web-console-${package_version}.tar.gz"
  cp "$work_root/web-console-a.tar.gz" "$release_asset"
  for document in runtime.cdx.json build.cdx.json artifact-manifest.json; do
    cp "$work_root/web-console-a.tar.gz.sbom/$document" "$output_dir/web-console-${package_version}-$document"
  done
  cp build/security-browser/webpack-modules.json "$output_dir/browser-webpack-modules.json"
  tar -czf "$output_dir/browser-concat-stats.tar.gz" -C build/security-browser/concat-stats .
  local release_name
  release_name=$(basename "$release_asset")
  (
    cd "$output_dir"
    sha256sum "$release_name" >"${release_name}.sha256"
    sha256sum "web-console-${package_version}-runtime.cdx.json" \
      "web-console-${package_version}-build.cdx.json" \
      "web-console-${package_version}-artifact-manifest.json" >"web-console-${package_version}-sbom.sha256"
  )
  test "$(awk '{print $2}' "${release_asset}.sha256")" = "$release_name"
  printf 'WEB_CONSOLE_VALIDATION_OK source=%s package=%s artifact=%s sha256=%s\n' \
    "$GITHUB_SHA" "$package_version" "$package_version" "$(sha256sum "$release_asset" | awk '{print $1}')"
}

main() {
  [[ "${GITHUB_SHA:-}" =~ ^[a-fA-F0-9]{40}$ ]]
  [[ "${SOURCE_DATE_EPOCH:-}" =~ ^[0-9]+$ ]]
  case "${VALIDATION_SCOPE:-full}" in full|dependency-security|host-disk|sbom) ;; *) exit 2 ;; esac
  export VALIDATION_SCOPE=${VALIDATION_SCOPE:-full}
  if [[ "${1:-}" = --inside-container ]]; then
    [[ $# -eq 3 ]]
    build_inside_container "$2" "$3"
    return
  fi
  [[ $# -eq 1 ]]
  local repo_root output_dir node_image
  repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
  output_dir=$(cd "$1" && pwd)
  [[ "$output_dir" != "$repo_root" && "$output_dir" != "$repo_root/"* ]]
  node_image=${PASTURESTACK_NODE24_IMAGE:-$builder_image}
  test "$node_image" = "$builder_image"
  docker run --rm \
    --mount "type=bind,source=$repo_root,target=/source,readonly" \
    --mount "type=bind,source=$output_dir,target=/output" \
    --env "GITHUB_SHA=$GITHUB_SHA" \
    --env "SOURCE_DATE_EPOCH=$SOURCE_DATE_EPOCH" \
    --env "VALIDATION_SCOPE=$VALIDATION_SCOPE" \
    "$node_image" \
    bash /source/scripts/build-ui-release-candidate --inside-container /source /output
}

if [[ "${BASH_SOURCE[0]}" = "$0" ]]; then
  main "$@"
fi
