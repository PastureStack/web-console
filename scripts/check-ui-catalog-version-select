#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

required_files=(
  app/components/new-select/component.js
  app/utils/catalog-version-options.js
  tests/unit/components/new-select-test.js
  tests/unit/utils/catalog-version-options-test.js
  docs/catalog-upgrade-contract.md
)

for path in "${required_files[@]}"; do
  test -f "$path"
done

grep -F "ungroupedContent: Ember.computed(" app/components/new-select/component.js >/dev/null
grep -F "groupedContent: Ember.computed(" app/components/new-select/component.js >/dev/null
grep -F "catalogVersionOptions(links, currentOption)" app/catalog-tab/launch/route.js >/dev/null
grep -F "resourceValue(results.upgrade, 'upgradeVersionLinks') || {}" app/catalog-tab/launch/route.js >/dev/null

if grep -F "this.set('ungroupedContent', Ember.computed" app/components/new-select/component.js; then
  echo 'Catalog choices still depend on an unsupported instance-level computed descriptor' >&2
  exit 1
fi

if grep -F "this.set('groupedContent', Ember.computed" app/components/new-select/component.js; then
  echo 'Grouped choices still depend on an unsupported instance-level computed descriptor' >&2
  exit 1
fi

printf 'UI_CATALOG_VERSION_SELECT_OK mapping=upgradeVersionLinks rendering=reactive-native-select\n'
