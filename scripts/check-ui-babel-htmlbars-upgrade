#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import json
import sys
from pathlib import Path

failures = 0


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


package = json.loads(Path("package.json").read_text(encoding="utf-8"))
dev = package.get("devDependencies", {})
overrides = package.get("overrides", {})
build = Path("ember-cli-build.js").read_text(encoding="utf-8")
if "includePolyfill" in build:
    fail("LEGACY_BABEL_INCLUDE_POLYFILL_REMAINS")
expected = {
    "ember-cli-babel": "8.3.2",
    "ember-cli-htmlbars": "7.0.1",
}
for name, version in expected.items():
    if dev.get(name) != version:
        fail("UI_BABEL_HTMLBARS_DECLARATION_UNEXPECTED", package=name, actual=dev.get(name), expected=version)
if overrides.get("ember-cli-htmlbars") != "7.0.1":
    fail("UI_HTMLBARS_OVERRIDE_UNEXPECTED", actual=overrides.get("ember-cli-htmlbars"), expected="7.0.1")

lock_path = Path("docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json")
if not lock_path.is_file():
    fail("MISSING_PACKAGE_LOCK", file=lock_path)
else:
    lock = json.loads(lock_path.read_text(encoding="utf-8"))
    packages = lock.get("packages", {})
    root = packages.get("", {})
    for field in ("dependencies", "devDependencies", "engines"):
        if package.get(field, {}) != root.get(field, {}):
            fail("PACKAGE_LOCK_ROOT_FIELD_DRIFT", field=field)
    for name, version in expected.items():
        root_path = f"node_modules/{name}"
        actual = packages.get(root_path, {}).get("version")
        if actual != version:
            fail("UI_BABEL_HTMLBARS_ROOT_LOCK_VERSION_UNEXPECTED", package=root_path, actual=actual, expected=version)
    htmlbars_matches = {
        path: meta.get("version")
        for path, meta in packages.items()
        if path.endswith("node_modules/ember-cli-htmlbars")
    }
    for package_path, actual in sorted(htmlbars_matches.items()):
        if actual != "7.0.1":
            fail("UI_HTMLBARS_LOCK_VERSION_UNEXPECTED", package=package_path, actual=actual, expected="7.0.1")
    legacy_babel = {
        path: meta.get("version")
        for path, meta in packages.items()
        if path.endswith("node_modules/ember-cli-babel") and str(meta.get("version", "")).startswith(("4.", "5."))
    }
    for package_path, actual in sorted(legacy_babel.items()):
        fail("EMBER_CLI_BABEL_LEGACY_VERSION_STILL_RESOLVED", package=package_path, actual=actual)
    package_count = len(packages)

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(f"UI_BABEL_HTMLBARS_UPGRADE_OK ember-cli-babel=8.3.2 ember-cli-htmlbars=7.0.1 inline-precompile=removed lockfile={lock_path} package_count={package_count}")
print("The root Babel and every HTMLBars compiler path are current for Ember 7.2; addon-owned Babel 6/7 paths remain explicitly tracked as build-only debt.")
print("failure_count=0")
PY
