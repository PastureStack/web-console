#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

grep -F 'var activeCssOutputPaths = app.options.outputPaths.app.css;' ember-cli-build.js >/dev/null
grep -F 'Object.assign(activeCssOutputPaths, themeCssOutputPaths);' ember-cli-build.js >/dev/null

module_id_settings=$(grep -Ec "moduleIds:" ember-cli-build.js || true)
chunk_id_settings=$(grep -Ec "chunkIds:" ember-cli-build.js || true)
if [[ "$module_id_settings" -ne 1 ]] ||
   ! grep -F "moduleIds: 'natural'" ember-cli-build.js >/dev/null; then
  echo "AUTO_IMPORT_MODULE_IDS_NOT_REPRODUCIBLE count=$module_id_settings"
  exit 1
fi
if [[ "$chunk_id_settings" -ne 1 ]] ||
   ! grep -F "chunkIds: 'deterministic'" ember-cli-build.js >/dev/null; then
  echo "AUTO_IMPORT_CHUNK_IDS_NOT_DETERMINISTIC count=$chunk_id_settings"
  exit 1
fi

grep -F "plugins: [new NormalizeTemplateModuleNameWebpackPlugin()]" ember-cli-build.js >/dev/null
grep -F "normalize-template-module-name-webpack-plugin" ember-cli-build.js >/dev/null
"${NODE_BINARY:-node}" ./scripts/check-ui-template-module-name-normalization

tmpdir=$(mktemp -d)
cleanup() {
  rm -rf "$tmpdir"
}
trap cleanup EXIT

mkdir -p "$tmpdir/dist/assets"
mkdir -p "$tmpdir/dist/licenses/ember"
mkdir -p "$tmpdir/dist/licenses/ember-fetch"
runtime_legal_packages=(bootstrap-multiselect ember-power-select ember-basic-dropdown ember-concurrency ember-modifier)
for package_name in "${runtime_legal_packages[@]}"; do
  mkdir -p "$tmpdir/dist/licenses/runtime/$package_name"
done
mkdir -p "$tmpdir/dist/translations"
cat >"$tmpdir/dist/index.html" <<'HTML'
<!doctype html>
<script src="assets/vendor-test.js"></script>
<script src="assets/ui-test.js"></script>
HTML
printf 'vendor\n' >"$tmpdir/dist/assets/vendor-test.js"
printf 'define("ui/utils/bootstrap-runtime",["exports","bootstrap"],function(){return window.bootstrap=runtime})\n' >"$tmpdir/dist/assets/ui-test.js"
for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do
  printf 'body { color: #123456; }\n' >"$tmpdir/dist/assets/$theme_asset"
done
printf 'detached test bundle @ember/test-helpers /tmp/random-build-path\n' >"$tmpdir/dist/assets/chunk.999.test-only.js"
printf 'source map\n' >"$tmpdir/dist/assets/ui-test.js.map"
printf '{}\n' >"$tmpdir/dist/translations/en-us.json"
printf '{}\n' >"$tmpdir/dist/translations/none.json"
cp vendor/ember/LICENSE "$tmpdir/dist/licenses/ember/LICENSE"
cp vendor/ember/UPSTREAM.md "$tmpdir/dist/licenses/ember/UPSTREAM.md"
cp vendor/ember-fetch-compat/LICENSE.md "$tmpdir/dist/licenses/ember-fetch/LICENSE.md"
cp vendor/ember-fetch-compat/UPSTREAM.md "$tmpdir/dist/licenses/ember-fetch/UPSTREAM.md"
for package_name in "${runtime_legal_packages[@]}"; do
  cp "vendor/runtime-licenses/$package_name/LICENSE.md" "$tmpdir/dist/licenses/runtime/$package_name/LICENSE.md"
  cp "vendor/runtime-licenses/$package_name/UPSTREAM.md" "$tmpdir/dist/licenses/runtime/$package_name/UPSTREAM.md"
done

printf 'Bootstrap v3.3.7 vendor\n' >"$tmpdir/dist/assets/vendor-test.js"
if SOURCE_DATE_EPOCH=1700000000 bash ./scripts/package-static-candidate \
    9.9.9 "$tmpdir/dist" "$tmpdir/unsafe.tar.gz" >"$tmpdir/unsafe.out" 2>&1; then
  echo "VULNERABLE_BOOTSTRAP_RUNTIME_ACCEPTED"
  exit 1
fi
if ! grep -q 'DIST_LEGACY_BOOTSTRAP_RUNTIME_PRESENT signature=Bootstrap v3.' "$tmpdir/unsafe.out"; then
  cat "$tmpdir/unsafe.out"
  echo "VULNERABLE_BOOTSTRAP_REJECTION_REASON_UNEXPECTED"
  exit 1
fi
printf 'vendor\n' >"$tmpdir/dist/assets/vendor-test.js"

out="$tmpdir/9.9.9.tar.gz"
out_repeat="$tmpdir/9.9.9-repeat.tar.gz"
SOURCE_DATE_EPOCH=1700000000 bash ./scripts/package-static-candidate 9.9.9 "$tmpdir/dist" "$out" >"$tmpdir/ui-static-layout.out"

# Repack after changing source mtimes to prove that the release tarball is
# controlled by SOURCE_DATE_EPOCH rather than the build host clock.
touch -d '@1800000000' "$tmpdir/dist/index.html" "$tmpdir/dist/assets/ui-test.js"
SOURCE_DATE_EPOCH=1700000000 bash ./scripts/package-static-candidate 9.9.9 "$tmpdir/dist" "$out_repeat" >/dev/null
if ! cmp -s "$out" "$out_repeat"; then
  echo "STATIC_ARTIFACT_NOT_REPRODUCIBLE first=$out second=$out_repeat"
  exit 1
fi

tar_list="$tmpdir/tar.list"
tar -tzf "$out" > "$tar_list"
grep -qx '9.9.9/index.html' "$tar_list"
grep -qx '9.9.9/VERSION.txt' "$tar_list"
grep -qx '9.9.9/assets/vendor-test.js' "$tar_list"
grep -qx '9.9.9/assets/ui-test.js' "$tar_list"
for theme_asset in ui-light.css ui-light.rtl.css ui-dark.css ui-dark.rtl.css; do
  grep -qx "9.9.9/assets/${theme_asset}" "$tar_list"
done
grep -qx '9.9.9/licenses/ember/LICENSE' "$tar_list"
grep -qx '9.9.9/licenses/ember/UPSTREAM.md' "$tar_list"
grep -qx '9.9.9/licenses/ember-fetch/LICENSE.md' "$tar_list"
grep -qx '9.9.9/licenses/ember-fetch/UPSTREAM.md' "$tar_list"
for package_name in "${runtime_legal_packages[@]}"; do
  grep -qx "9.9.9/licenses/runtime/${package_name}/LICENSE.md" "$tar_list"
  grep -qx "9.9.9/licenses/runtime/${package_name}/UPSTREAM.md" "$tar_list"
done
grep -qx '9.9.9/translations/en-us.json' "$tar_list"

if grep -Eq '\.map$' "$tar_list"; then
  echo "SOURCE_MAP_ENTRY_PRESENT"
  exit 1
fi

if grep -Eq '/assets/chunk\.999\.test-only\.js$' "$tar_list"; then
  echo "TEST_ONLY_AUTO_IMPORT_CHUNK_PRESENT"
  exit 1
fi


if grep -Eq '/translations/none\.json$' "$tar_list"; then
  echo "DEVELOPMENT_LOCALE_ENTRY_PRESENT"
  exit 1
fi

if grep -qx 'index.html' "$tar_list"; then
  echo "BARE_INDEX_ENTRY_PRESENT"
  exit 1
fi

extract="$tmpdir/extract"
mkdir -p "$extract"
tar -xzf "$out" -C "$extract"
if grep -R -aF '@ember/test-helpers' "$extract" >/dev/null; then
  echo "TEST_HELPER_RUNTIME_PRESENT"
  exit 1
fi
if grep -R -aF '/tmp/' "$extract" >/dev/null; then
  echo "TEMP_BUILD_PATH_PRESENT"
  exit 1
fi
version=$(cat "$extract/9.9.9/VERSION.txt")
if [[ "$version" != "9.9.9" ]]; then
  echo "VERSION_TXT_MISMATCH actual=$version expected=9.9.9"
  exit 1
fi

expected_ember_license=84e97eb6663fa5fa07f36661e6040ab8a557b165c13860e2e72c1a692ca3c2a0
actual_ember_license=$(sha256sum "$extract/9.9.9/licenses/ember/LICENSE" | awk 'NR == 1 {print $1}')
if [[ "$actual_ember_license" != "$expected_ember_license" ]]; then
  echo "EMBER_LICENSE_ARCHIVE_DRIFT actual=$actual_ember_license expected=$expected_ember_license"
  exit 1
fi

expected_ember_fetch_license=bae5cb45df11b4fa8e894ae3b9b13595e154ade61ee6c57d5cfcd422771153a7
actual_ember_fetch_license=$(sha256sum "$extract/9.9.9/licenses/ember-fetch/LICENSE.md" | awk 'NR == 1 {print $1}')
if [[ "$actual_ember_fetch_license" != "$expected_ember_fetch_license" ]]; then
  echo "EMBER_FETCH_LICENSE_ARCHIVE_DRIFT actual=$actual_ember_fetch_license expected=$expected_ember_fetch_license"
  exit 1
fi

for package_name in "${runtime_legal_packages[@]}"; do
  if ! cmp -s \
      "vendor/runtime-licenses/$package_name/LICENSE.md" \
      "$extract/9.9.9/licenses/runtime/$package_name/LICENSE.md"; then
    echo "RUNTIME_LICENSE_ARCHIVE_DRIFT package=$package_name"
    exit 1
  fi
  if ! cmp -s \
      "vendor/runtime-licenses/$package_name/UPSTREAM.md" \
      "$extract/9.9.9/licenses/runtime/$package_name/UPSTREAM.md"; then
    echo "RUNTIME_PROVENANCE_ARCHIVE_DRIFT package=$package_name"
    exit 1
  fi
done

if [[ ! -s "${out}.sha256" ]]; then
  echo "SHA256_FILE_MISSING file=${out}.sha256"
  exit 1
fi

checksum_target=$(awk 'NR == 1 {print $2}' "${out}.sha256")
if [[ "$checksum_target" != "$(basename "$out")" ]]; then
  echo "SHA256_TARGET_NOT_PORTABLE actual=$checksum_target expected=$(basename "$out")"
  exit 1
fi
(
  cd "$(dirname "$out")"
  sha256sum -c "$(basename "${out}.sha256")"
)

cat "$tmpdir/ui-static-layout.out"
echo "ui-auto-import-reproducible-ids-ok module_ids=natural chunk_ids=deterministic"
echo "ui-static-artifact-reproducible-ok"
echo "ui-static-artifact-layout-ok"
echo "failure_count=0"
