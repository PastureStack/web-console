#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

initializer=app/initializers/resizable-table-columns.js
utility=app/utils/resizable-table-columns.js
styles=app/styles/components/_sortable.scss
header_styles=app/styles/layout/_header.scss
test_file=tests/unit/utils/resizable-table-columns-test.js
sortable_table=vendor/lacsso/addon/templates/components/sortable-table.hbs
sortable_header=vendor/lacsso/addon/components/sortable-thead.js
failures=0

require_file() {
  local file=$1
  if [[ ! -f "$file" ]]; then
    echo "RESIZABLE_TABLE_REQUIRED_FILE_MISSING file=$file"
    failures=$((failures + 1))
  fi
}

require_pattern() {
  local file=$1
  local pattern=$2
  local description=$3
  if ! grep -Eq "$pattern" "$file"; then
    echo "RESIZABLE_TABLE_PATTERN_MISSING file=$file description=$description"
    failures=$((failures + 1))
  fi
}

require_file "$initializer"
require_file "$utility"
require_file "$styles"
require_file "$header_styles"
require_file "$test_file"
require_file "$sortable_table"
require_file "$sortable_header"

require_pattern "$utility" 'table\.grid:not\(\[data-column-resize="off"\]\)' 'data-grid selector with an explicit opt-out'
require_pattern "$utility" 'MutationObserver' 'dynamic Ember table discovery'
require_pattern "$utility" 'directHeaderCells' 'legacy direct-TH header support'
require_pattern "$utility" 'data-table-column-sizer' 'shared colgroup sizing'
require_pattern "$utility" 'pointerdown' 'pointer drag resizing'
require_pattern "$utility" 'ArrowLeft.*ArrowRight.*Enter' 'keyboard resizing and auto-fit'
require_pattern "$utility" 'MAX_INITIAL_COLUMN_WIDTH' 'bounded initial auto-fit width'
require_pattern "$utility" 'headerWidthHints' 'legacy width hints used as auto-fit minimums'
require_pattern "$utility" 'ROLE_PROFILES' 'semantic column profiles'
require_pattern "$utility" 'selection:' 'selection role profile'
require_pattern "$utility" 'minWidth:[[:space:]]*48' 'compact selection column'
require_pattern "$utility" 'columnRoleFromName' 'sortable field role inference'
require_pattern "$utility" 'data-column-role-resolved' 'runtime role evidence'
require_pattern "$sortable_table" 'data-column-role="selection"' 'bulk selection metadata'
require_pattern "$sortable_header" 'name:data-column-name' 'sortable field metadata'
require_pattern "$sortable_header" 'resolvedColumnRole:data-column-role' 'sortable role metadata'
require_pattern "$styles" 'white-space:[[:space:]]*nowrap' 'desktop non-wrapping cells'
require_pattern "$styles" 'overflow-x:[[:space:]]*hidden' 'fitted tables suppress meaningless scrollbars'
require_pattern "$styles" 'table-column-scroll-host-overflowing' 'horizontal scrolling only for real overflow'
require_pattern "$utility" 'hasHorizontalOverflow' 'sub-pixel-safe overflow detection'
require_pattern "$header_styles" 'right:[[:space:]]*0' 'environment menu overlay ends at its containing row'
require_pattern "$header_styles" 'width:[[:space:]]*auto' 'environment menu overlay does not impose a fixed width'
require_pattern "$styles" 'th:last-child[[:space:]]+\.table-column-resize-handle' 'last resize handle contained within the table'
require_pattern "$styles" '@media \(max-width:[[:space:]]*694px\)' 'stacked mobile fallback'

if [[ $failures -ne 0 ]]; then
  echo "failure_count=$failures"
  exit 1
fi

echo "UI_RESIZABLE_TABLE_COLUMNS_OK selector=table.grid auto_fit=true semantic_profiles=true selection_width=48 pointer=true keyboard=true mobile_fallback=true"
echo "Only rendered data grids with a multi-column table header are enhanced; layout tables remain unchanged."
echo "failure_count=0"
