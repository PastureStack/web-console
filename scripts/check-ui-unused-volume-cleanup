#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_root"

utility=app/utils/unused-volume-cleanup.js
controller=app/host/storage/controller.js
page=app/host/storage/template.hbs
component=app/components/confirm-clean-unused-volumes/component.js
modal=app/components/confirm-clean-unused-volumes/template.hbs
styles=app/styles/components/_modals.scss
test_file=tests/unit/utils/unused-volume-cleanup-test.js
documentation=docs/storage-cleanup.md

required_files=(
  "$utility"
  "$controller"
  "$page"
  "$component"
  "$modal"
  "$styles"
  "$test_file"
  "$documentation"
)

for path in "${required_files[@]}"; do
  if [[ ! -f "$path" ]]; then
    echo "UNUSED_VOLUME_CLEANUP_REQUIRED_FILE_MISSING file=$path" >&2
    exit 1
  fi
done

require_fixed() {
  local file=$1
  local marker=$2
  local description=$3

  if ! grep -F "$marker" "$file" >/dev/null; then
    echo "UNUSED_VOLUME_CLEANUP_MARKER_MISSING file=$file description=$description" >&2
    exit 1
  fi
}

require_fixed "$utility" "value(volume, 'state') === 'detached'" 'detached-state requirement'
require_fixed "$utility" "!value(volume, 'removed')" 'removed-item exclusion'
require_fixed "$utility" "!value(volume, 'instanceId')" 'instance attachment exclusion'
require_fixed "$utility" "!hasActiveMount(volume)" 'active-mount exclusion'
require_fixed "$utility" "!!actionLinks.remove" 'API remove-action requirement'
require_fixed "$utility" 'const TEST_MARKER' 'explicit test-purpose marker'
require_fixed "$utility" 'const PROTECTED_MARKER' 'recovery and production protection'
require_fixed "$controller" 'classifyUnusedVolumes' 'guarded classification'
require_fixed "$controller" "toggleModal('confirm-clean-unused-volumes'" 'confirmation dialog'
require_fixed "$component" "runWithConcurrency(volumes, 4" 'bounded request concurrency'
require_fixed "$component" "doAction('remove', {}, {catchGrowl: false})" 'public resource action'
require_fixed "$modal" 'cleanup.preview' 'candidate preview'
require_fixed "$modal" 'cleanup.progress' 'progress reporting'
require_fixed "$modal" 'cleanup.failed' 'failure reporting'
require_fixed "$test_file" 'it selects only detached test volumes' 'eligibility unit coverage'
require_fixed "$test_file" 'it protects recovery names and ambiguous detached volumes' 'protection unit coverage'
require_fixed "$test_file" 'concurrency is bounded' 'concurrency unit coverage'

for locale in en-us de-de fa-ir fil-ph fr-fr hu-hu ja-jp ko-kr pt-br ru-ru uk-ua zh-hans zh-tw; do
  require_fixed "translations/${locale}.yaml" 'cleanup:' "cleanup messages for ${locale}"
done

if grep -RInEi \
  '@sha256|[A-Z]:\\Users\\|DELETE[[:space:]]+FROM' \
  "${required_files[@]}"; then
  echo 'Bulk cleanup source contains a digest, private workstation path, or direct database deletion.' >&2
  exit 1
fi

if [[ -n ${PASTURESTACK_PRIVATE_MARKER:-} ]] &&
  grep -RInF -- "$PASTURESTACK_PRIVATE_MARKER" "${required_files[@]}"; then
  echo 'Bulk cleanup source contains a configured private marker.' >&2
  exit 1
fi

echo 'UI_UNUSED_VOLUME_CLEANUP_OK eligibility=explicit-test-only active_mounts=protected recovery_names=protected concurrency=4'
