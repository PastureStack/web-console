#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PYCHECK'
import json
import re
import sys
from pathlib import Path

failures = 0


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


package = json.loads(Path("package.json").read_text(encoding="utf-8"))
bower = json.loads(Path("bower.json").read_text(encoding="utf-8"))
build = Path("ember-cli-build.js").read_text(encoding="utf-8")
lock_path = Path("package-lock.json")
lock = json.loads(lock_path.read_text(encoding="utf-8"))

billboard_version = "4.0.3"
d3_version = "7.9.0"
dev_deps = package.get("devDependencies", {}) or {}
if dev_deps.get("billboard.js") != billboard_version:
    fail("BILLBOARD_DEP_VERSION_UNEXPECTED", actual=dev_deps.get("billboard.js"), expected=billboard_version)
if dev_deps.get("d3") != d3_version:
    fail("D3_DEP_VERSION_UNEXPECTED", actual=dev_deps.get("d3"), expected=d3_version)
if "c3" in dev_deps or "c3" in (bower.get("dependencies", {}) or {}):
    fail("UNMAINTAINED_C3_DEPENDENCY_REMAINS")
if "node_modules/billboard.js/dist/billboard.css" not in build:
    fail("BILLBOARD_CSS_IMPORT_MISSING")
for forbidden in ["node_modules/c3/", "bower_components/c3/", "node_modules/d3/d3.js", "bower_components/d3/"]:
    if forbidden in build:
        fail("LEGACY_CHART_GLOBAL_IMPORT_REMAINS", path=forbidden)

packages = lock.get("packages", {}) or {}
root_dev = (packages.get("", {}) or {}).get("devDependencies", {}) or {}
for name, expected in [("billboard.js", billboard_version), ("d3", d3_version)]:
    if root_dev.get(name) != expected:
        fail("CHART_LOCK_ROOT_VERSION_UNEXPECTED", package=name, actual=root_dev.get(name), expected=expected)
    actual = (packages.get(f"node_modules/{name}", {}) or {}).get("version")
    if actual != expected:
        fail("CHART_LOCK_PACKAGE_VERSION_UNEXPECTED", package=name, actual=actual, expected=expected)
if "node_modules/c3" in packages:
    fail("UNMAINTAINED_C3_LOCK_ENTRY_REMAINS")
d3_color_versions = sorted({
    metadata.get("version")
    for path, metadata in packages.items()
    if path.endswith("node_modules/d3-color") and metadata.get("version")
})
if d3_color_versions != ["3.1.0"]:
    fail("D3_COLOR_FIXED_VERSION_UNEXPECTED", actual=d3_color_versions, expected=["3.1.0"])

sources = "\n".join(
    path.read_text(encoding="utf-8")
    for path in Path("app/components").rglob("*.js")
)
billboard_usage_count = len(re.findall(r"\bbb\.generate\(", sources))
if billboard_usage_count != 4:
    fail("BILLBOARD_USAGE_COUNT_UNEXPECTED", actual=billboard_usage_count, expected=4)
for forbidden in ["c3.generate(", "d3.scale.linear(", "d3.svg.area(", "d3.behavior.zoom(", "d3.event."]:
    if forbidden in sources:
        fail("LEGACY_CHART_API_REMAINS", api=forbidden)
for required in ["from 'billboard.js'", "from 'd3'", "d3.scaleLinear()", "d3.area()", "d3.zoom()"]:
    if required not in sources:
        fail("MODERN_CHART_API_MISSING", api=required)

multi_stats = Path("app/components/info-multi-stats/component.js").read_text(encoding="utf-8")
if multi_stats.count("point: HOST_STATS_POINT_OPTIONS") != 4:
    fail("HOST_STATS_POINT_DISABLE_COUNT_UNEXPECTED", actual=multi_stats.count("point: HOST_STATS_POINT_OPTIONS"), expected=4)
if "colors: ['#27ae60', '#DBE8B1']" not in multi_stats:
    fail("HOST_STATS_CPU_PALETTE_DIFFERS_FROM_LEGEND")
for chart_type, series in {
    "cpu": ["System", "User"],
    "memory": ["Used"],
    "network": ["Transmit", "Receive"],
    "storage": ["Write", "Read"],
}.items():
    series_literal = f"{chart_type}: Object.freeze({series!r})"
    if series_literal not in multi_stats:
        fail("HOST_STATS_INITIAL_SERIES_MISSING", chart=chart_type, expected=series)
    if f"groups: initialGraphGroups('{chart_type}', single)" not in multi_stats:
        fail("HOST_STATS_INITIAL_GROUP_MISSING", chart=chart_type)

chart_styles = "\n".join(
    Path(path).read_text(encoding="utf-8")
    for path in ["app/styles/components/_multi-stats.scss", "app/styles/pages/_host.scss"]
)
if ".c3" in chart_styles or "c3-" in chart_styles:
    fail("LEGACY_C3_STYLE_SELECTOR_REMAINS")
for required in [".bb {", ".bb-axis", ".bb-area-System", ".bb-tooltip-name-System"]:
    if required not in chart_styles:
        fail("BILLBOARD_HOST_STYLE_SELECTOR_MISSING", selector=required)

modernization = Path("docs/modernization.md").read_text(encoding="utf-8")
for phrase in [f"billboard.js@{billboard_version}", f"d3@{d3_version}", "C3 retirement", "d3-color@3.1.0"]:
    if phrase not in modernization:
        fail("CHART_MODERNIZATION_DOC_MISSING", phrase=phrase)

node24_smoke = Path("scripts/node24-lock-smoke.js").read_text(encoding="utf-8")
for phrase in [f'expectPackageJsonVersion("billboard.js", "{billboard_version}")', f'expectVersion("d3", "{d3_version}")', 'expectMissing("c3")', "expectModernChartModules", "modern-chart-module-smoke-ok"]:
    if phrase not in node24_smoke:
        fail("CHART_NODE24_LOCK_SMOKE_MISSING", phrase=phrase)

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(f"UI_CHART_RUNTIME_MODERNIZATION_OK billboard={billboard_version} d3={d3_version} d3_color={d3_color_versions[0]} billboard_generate_usages={billboard_usage_count} lock={lock_path}")
print("failure_count=0")
PYCHECK
