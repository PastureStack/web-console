#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

python3 - <<'PY_CHECK'
import json
import re
from pathlib import Path

expected_version = "5.3.8"
pkg = json.loads(Path("package.json").read_text(encoding="utf-8"))
bower = json.loads(Path("bower.json").read_text(encoding="utf-8"))
lock = json.loads(Path("docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json").read_text(encoding="utf-8"))

if "bootstrap-sass-official" in bower.get("dependencies", {}):
    raise SystemExit("bower.json must not depend on bootstrap-sass-official")
if "bootstrap-sass" in pkg.get("devDependencies", {}):
    raise SystemExit("package.json must not depend on bootstrap-sass")
if pkg.get("devDependencies", {}).get("bootstrap") != expected_version:
    raise SystemExit("package.json must pin Bootstrap 5.3.8")
if "node_modules/bootstrap-sass" in lock.get("packages", {}):
    raise SystemExit("release lock must not resolve bootstrap-sass")
bootstrap_lock = lock.get("packages", {}).get("node_modules/bootstrap", {})
if bootstrap_lock.get("version") != expected_version:
    raise SystemExit(f"release lock Bootstrap version drift: {bootstrap_lock.get('version')!r}")
if bootstrap_lock.get("license") != "MIT":
    raise SystemExit("release lock Bootstrap license drift")
if Path("vendor/bootstrap-sass").exists():
    raise SystemExit("obsolete vendored Bootstrap 3 source must be absent")

build = Path("ember-cli-build.js").read_text(encoding="utf-8")
expected_imports = []
actual_imports = [
    path
    for path in re.findall(r"app\.import\('(?P<path>[^']+)'\)", build)
    if path.startswith("node_modules/bootstrap/")
]
if actual_imports != expected_imports:
    raise SystemExit(
        f"Bootstrap 5 build imports drift: actual={actual_imports!r} expected={expected_imports!r}"
    )

authority_sha256 = "bab18039ee378d9afc63421db33f52bc685ff993e0c5dbddd21b4526752347f1"
presentation_files = {
    "app/styles/vendors/_bootstrap3-layout-light.scss":
        "44954011eda0601c61ac8742227be654d6a679c52805ccbaebd94678c2b675b8",
    "app/styles/vendors/_bootstrap3-layout-dark.scss":
        "1264fdf5c2237451cad8151538183c208a8ce5190746b82552dfeab395da23ca",
}
for file_name, expected_sha256 in presentation_files.items():
    path = Path(file_name)
    if not path.is_file():
        raise SystemExit(f"v1.6.358 presentation contract missing: {file_name}")
    source = path.read_text(encoding="utf-8")
    actual_sha256 = __import__("hashlib").sha256(path.read_bytes()).hexdigest()
    if actual_sha256 != expected_sha256:
        raise SystemExit(
            f"v1.6.358 presentation contract drift: file={file_name} "
            f"actual={actual_sha256} expected={expected_sha256}"
        )
    if authority_sha256 not in source or "Bootstrap 3.4.1 CSS under MIT" not in source:
        raise SystemExit(f"v1.6.358 presentation provenance missing: {file_name}")
    if ".glyphicon" in source:
        raise SystemExit(f"unused Glyphicons restored in presentation contract: {file_name}")

theme_imports = {
    "app/styles/app-light.scss": 'meta.load-css("app/styles/vendors/bootstrap3-layout-light")',
    "app/styles/app-dark.scss": 'meta.load-css("app/styles/vendors/bootstrap3-layout-dark")',
}
for file_name, marker in theme_imports.items():
    if marker not in Path(file_name).read_text(encoding="utf-8"):
        raise SystemExit(f"v1.6.358 presentation import missing: {file_name}")

bridge = Path("app/styles/helpers/_bootstrap-root-bridge.scss").read_text(encoding="utf-8")
for marker in (
    ".navbar-toggler",
    "@extend .navbar-toggle",
    ".dropdown-menu.show",
    ".collapse.show",
    ".modal.show .modal-dialog",
    ".modal-backdrop.show",
    ".tooltip.show",
    ".popover.show",
):
    if marker not in bridge:
        raise SystemExit(f"Bootstrap 5 presentation state bridge missing marker: {marker}")

icon_css = Path("vendor/icons/style.css").read_text(encoding="utf-8")
if '.icon-shield:before { content: "\\e939"; }' not in icon_css:
    raise SystemExit("security/MFA shield icon compatibility alias is missing")

for file_name in (
    "vendor/runtime-licenses/bootstrap3-layout-compat/LICENSE.md",
    "vendor/runtime-licenses/bootstrap3-layout-compat/UPSTREAM.md",
):
    if not Path(file_name).is_file():
        raise SystemExit(f"v1.6.358 presentation license evidence missing: {file_name}")

app_source = Path("app/app.js").read_text(encoding="utf-8")
runtime_source = Path("app/utils/bootstrap-runtime.js").read_text(encoding="utf-8")
for marker in (
    "import installBootstrapRuntime from './utils/bootstrap-runtime';",
    "installBootstrapRuntime();",
):
    if marker not in app_source:
        raise SystemExit(f"Bootstrap application boot boundary missing marker: {marker}")
for marker in (
    "import * as Bootstrap from 'bootstrap';",
    "window.bootstrap = Bootstrap;",
):
    if marker not in runtime_source:
        raise SystemExit(f"Bootstrap application runtime boundary missing marker: {marker}")
if "bootstrap/dist/js/bootstrap.bundle.js" in build:
    raise SystemExit("Bootstrap UMD bundle must not be imported into the production vendor bundle")

forbidden_source_patterns = {
    "Bootstrap loading-state data API": re.compile(r"data-loading-text", re.I),
    "Bootstrap 3 data API": re.compile(r"data-toggle\s*=", re.I),
}
active_sources = [
    path
    for root in (Path("app"), Path("tests"))
    for path in root.rglob("*")
    if path.is_file() and path.suffix in {".js", ".hbs", ".html"}
]
violations = []
for path in active_sources:
    source = path.read_text(encoding="utf-8")
    for description, pattern in forbidden_source_patterns.items():
        if pattern.search(source):
            violations.append(f"{path}: {description}")
if violations:
    raise SystemExit("Legacy Bootstrap API restored:\n" + "\n".join(violations))

test_source = Path("tests/unit/vendor/bootstrap-runtime-boundary-test.js").read_text(encoding="utf-8")
for marker in ("Button", "Collapse", "Dropdown", "Tooltip", "Popover", expected_version):
    if marker not in test_source:
        raise SystemExit(f"Bootstrap browser runtime boundary missing marker: {marker}")

print(
    f"ui-bootstrap5-runtime-ok version={expected_version} "
    f"presentation_authority=server-v1.6.358 legacy_javascript_absent=true"
)
PY_CHECK
