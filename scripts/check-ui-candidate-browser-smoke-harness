#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import subprocess
import sys
from pathlib import Path

failures = 0


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


shell_path = Path("scripts/smoke-ui-candidate-browser")
js_path = Path("scripts/ui-candidate-browser-smoke.js")
docs_path = Path("docs/modernization.md")
mfa_docs_path = Path("docs/multi-factor-authentication.md")
mfa_templates = [
    Path("app/login/index/template.hbs"),
    Path("app/admin-tab/auth/mfa/template.hbs"),
    Path("app/templates/mfa-self-service.hbs"),
]
account_security_route = Path("app/router.js")
admin_mfa_template = Path("app/admin-tab/auth/mfa/template.hbs")
self_service_template = Path("app/templates/mfa-self-service.hbs")

for path in [shell_path, js_path]:
    if not path.is_file():
        fail("UI_BROWSER_SMOKE_FILE_MISSING", file=path)

for path in mfa_templates:
    if not path.is_file():
        fail("UI_MFA_TEMPLATE_MISSING", file=path)
        continue
    template = path.read_text(encoding="utf-8")
    for marker in ["disabled=waiting", "disabled=busy"]:
        if marker in template:
            fail("UI_MFA_LITERAL_DISABLED_ATTRIBUTE", file=path, marker=marker)

if not account_security_route.is_file():
    fail("UI_MFA_ACCOUNT_SECURITY_ROUTE_MISSING", file=account_security_route)
elif "this.route('account-security', {path: '/account/security', resetNamespace: true});" not in \
        account_security_route.read_text(encoding="utf-8"):
    fail("UI_MFA_ACCOUNT_SECURITY_ROUTE_NOT_ROOT_SCOPED", file=account_security_route)

if admin_mfa_template.is_file():
    admin_mfa = admin_mfa_template.read_text(encoding="utf-8")
    system_index = admin_mfa.find('data-testid="mfa-system-settings"')
    account_index = admin_mfa.find('data-testid="mfa-account-management"')
    if system_index < 0 or account_index < 0 or system_index >= account_index:
        fail("UI_MFA_GLOBAL_SETTINGS_NOT_SEPARATED_FROM_ACCOUNT", file=admin_mfa_template)
    for marker in [
        "authPage.mfa.settings.scopeHelp",
        "authPage.mfa.settings.smtpHelp",
    ]:
        if marker not in admin_mfa:
            fail("UI_MFA_GLOBAL_SETTINGS_SCOPE_MISSING", file=admin_mfa_template, marker=marker)

if self_service_template.is_file():
    self_service = self_service_template.read_text(encoding="utf-8")
    if "authPage.mfa.email.systemManaged" not in self_service:
        fail("UI_MFA_RECOVERY_DESTINATION_SCOPE_MISSING", file=self_service_template)
    for forbidden in ["settingsForm.smtpHost", "settingsForm.smtpUsername", "settingsForm.smtpPassword"]:
        if forbidden in self_service:
            fail("UI_MFA_SELF_SERVICE_EXPOSES_SMTP", file=self_service_template, marker=forbidden)

if shell_path.is_file():
    stage_result = subprocess.run(
        ["git", "ls-files", "--stage", "--", shell_path.as_posix()],
        capture_output=True,
        text=True,
    )
    if stage_result.returncode == 0:
        if not stage_result.stdout.startswith("100755 "):
            fail("UI_BROWSER_SMOKE_SCRIPT_NOT_EXECUTABLE", file=shell_path)
    elif not shell_path.stat().st_mode & 0o111:
        fail("UI_BROWSER_SMOKE_SCRIPT_NOT_EXECUTABLE", file=shell_path)
    shell = shell_path.read_text(encoding="utf-8")
    for marker in [
        "PASTURESTACK_USER",
        "PASTURESTACK_PASS",
        "PASTURESTACK_TOTP_SECRET",
        "UI_CANDIDATE_TARBALL",
        "PASTURESTACK_API_TARGET",
        "--strip-components=1",
        "require.resolve('playwright')",
    ]:
        if marker not in shell:
            fail("UI_BROWSER_SMOKE_SHELL_MARKER_MISSING", marker=marker)

if js_path.is_file():
    js = js_path.read_text(encoding="utf-8")
    for marker in [
        "const headers = { ...req.headers };",
        "server.on(\"upgrade\", proxyUpgrade)",
        "net.connect",
        "req.rawHeaders",
        "wsUpgradeCount",
        "credentials: \"same-origin\"",
        "net::ERR_ABORTED",
        "UI_SMOKE_ROUTES",
        "UI_SMOKE_REQUIRE_HOSTS",
        "UI_SMOKE_SERVE_ONLY",
        "UI_SMOKE_BIND",
        "ui-candidate-preview-ready",
        "PASTURESTACK_PROJECT_ID",
        "assertApiStoreContract",
        "api-store-contract-smoke-ok",
        "assertI18nHealth",
        "i18n-smoke-ok",
        "loadingErrors",
        "rendered an empty body",
        "Loading Error:",
        "assertI18nFormatterContract",
        "i18n-formatter-smoke-ok",
        "assertTemplateActionBridge",
        "template-action-bridge-smoke-ok",
        "service:intl",
        "service:user-language",
        "sideLoadLanguage(\"zh-tw\")",
        "sideLoadLanguage(\"zh-hans\")",
        "currentTotp",
        "PASTURESTACK_TOTP_SECRET",
        "PASTURESTACK_MFA_MANAGED_ACCOUNT_ID",
        "UI_SMOKE_EXERCISE_TOTP_ENROLLMENT",
        "UI_SMOKE_EXERCISE_PASSKEY_ENROLLMENT",
        "UI_SMOKE_REQUIRE_EMAIL_RECOVERY",
        "UI_SMOKE_EXPECT_PASSKEY_LIMIT",
        "accounts-manage-my-mfa",
        "mfa-self-service-summary",
        "mfa-managed-account-warning",
        "MfaAccountHolderRequired",
        "WebAuthn.addVirtualAuthenticator",
        "passkey-enrollment-smoke-ok",
        "passkey-login-smoke-ok",
        "recovery-email-self-service-smoke-ok",
        "passkey-limit-smoke-ok",
        "passkey-revocation-smoke-ok",
        "pagination.multi",
        "translation not found",
        "%MISSING%",
        "Template version not found",
        "Error check update",
        "did not open a proxied WebSocket",
    ]:
        if marker not in js:
            fail("UI_BROWSER_SMOKE_JS_MARKER_MISSING", marker=marker)
    if "host: target.host" in js or "host: apiTarget" in js:
        fail("UI_BROWSER_SMOKE_REWRITES_HOST_HEADER")

combined = "\n".join(path.read_text(encoding="utf-8") for path in [p for p in [shell_path, js_path] if p.is_file()])
for forbidden in ["10.0.0." + "125", "/home" + "/ubuntu", "Pass" + "word:", "RANCHER_" + "PASS=", "chen" + "21019:", "ey" + "J"]:
    if forbidden in combined:
        fail("UI_BROWSER_SMOKE_SECRET_OR_LAB_MARKER", marker=forbidden)

docs = docs_path.read_text(encoding="utf-8") if docs_path.is_file() else ""
for phrase in [
    "No-Publish Candidate Browser Smoke Harness",
    "preserve the browser-facing Host header",
    "scripts/smoke-ui-candidate-browser",
    "UI_SMOKE_SERVE_ONLY=1",
]:
    if phrase not in docs:
        fail("UI_BROWSER_SMOKE_DOC_MISSING", phrase=phrase)

mfa_docs = mfa_docs_path.read_text(encoding="utf-8") if mfa_docs_path.is_file() else ""
mfa_docs_single_line = " ".join(mfa_docs.split())
for phrase in [
    "exactly one SMTP delivery configuration",
    "can be read or changed only by an active system administrator",
    "Individual accounts store only their own verified recovery destination address",
]:
    if phrase not in mfa_docs_single_line:
        fail("UI_MFA_SMTP_SCOPE_DOC_MISSING", phrase=phrase)

ci = Path("scripts/ci").read_text(encoding="utf-8")
if "./scripts/check-ui-candidate-browser-smoke-harness" not in ci:
    fail("UI_BROWSER_SMOKE_CI_GATE_MISSING")

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print("ui-candidate-browser-smoke-harness-ok")
print("failure_count=0")
PY
