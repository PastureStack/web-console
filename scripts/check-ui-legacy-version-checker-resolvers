#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

lock_path="docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json"

python3 - "$lock_path" <<'PY'
import json
import sys
from pathlib import Path

lock_path = Path(sys.argv[1])
failures = 0
expected_root = "5.1.2"


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


package = json.loads(Path("package.json").read_text(encoding="utf-8"))
if not lock_path.is_file():
    fail("UI_LEGACY_VERSION_CHECKER_LOCK_MISSING", file=lock_path)
else:
    lock = json.loads(lock_path.read_text(encoding="utf-8"))
    packages = lock.get("packages", {})
    root = packages.get("node_modules/ember-cli-version-checker", {})
    if root.get("version") != expected_root:
        fail("UI_VERSION_CHECKER_ROOT_DRIFT", actual=root.get("version"), expected=expected_root)
    for path, info in sorted(packages.items()):
        if path.endswith("node_modules/ember-cli-version-checker") and str(info.get("version", "")).startswith("1."):
            fail("UI_LEGACY_VERSION_CHECKER_1X_RETURNED", path=path, actual=info.get("version"))

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(f"UI_LEGACY_VERSION_CHECKER_RESOLVERS_OK root={expected_root} legacy_1x=0 lockfile={lock_path}")
print("The Ember 6.12 root checker is current and no unsupported 1.x checker remains in the locked addon graph.")
print("failure_count=0")
PY
