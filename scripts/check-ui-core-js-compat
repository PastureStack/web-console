#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import json
import sys
from pathlib import Path

package = json.loads(Path("package.json").read_text(encoding="utf-8"))
lock = json.loads(Path("package-lock.json").read_text(encoding="utf-8"))
packages = lock.get("packages", {})
failures = []

if "core-js" in package.get("overrides", {}):
    failures.append("obsolete package override for core-js remains")

resolved = [
    path for path in packages
    if path == "node_modules/core-js"
    or path.endswith("/node_modules/core-js")
    or path == "node_modules/core-js-pure"
    or path.endswith("/node_modules/core-js-pure")
]
if resolved:
    failures.append(f"core-js packages returned to the active lock: {resolved}")

if failures:
    for failure in failures:
        print(f"UI_CORE_JS_COMPAT_FAIL {failure}")
    print(f"failure_count={len(failures)}")
    sys.exit(1)

print("UI_CORE_JS_REMOVAL_OK core-js=absent core-js-pure=absent")
print("failure_count=0")
PY
