#!/usr/bin/env node
'use strict';

const assert = require('assert');
const fs = require('fs');
const path = require('path');
const {
  serializeTranslation,
  translationDefinitions,
} = require('../lib/production-translations');

const repoRoot = path.resolve(__dirname, '..');
const args = process.argv.slice(2);
const mode = args[0] || '--source';
const definitions = translationDefinitions(repoRoot, 'production');
const expectedLocales = definitions.map((definition) => definition.locale);

function fail(message) {
  process.stderr.write(`UI_PRODUCTION_TRANSLATIONS_INVALID ${message}\n`);
  process.exit(1);
}

function validateSource() {
  const packageJson = require('../package.json');
  const lock = require('../package-lock.json');
  const emberBuild = fs.readFileSync(path.join(repoRoot, 'ember-cli-build.js'), 'utf8');
  const intlConfig = fs.readFileSync(path.join(repoRoot, 'config', 'ember-intl.js'), 'utf8');

  if (packageJson.devDependencies['broccoli-file-creator'] !== '2.1.1') {
    fail('broccoli-file-creator must be a direct, exactly pinned build dependency');
  }

  if (lock.packages[''].devDependencies['broccoli-file-creator'] !== '2.1.1' ||
      lock.packages['node_modules/broccoli-file-creator'].version !== '2.1.1') {
    fail('package-lock.json does not pin broccoli-file-creator 2.1.1');
  }

  if (!emberBuild.includes('buildTranslationTrees(__dirname, env)') ||
      !emberBuild.includes('app.toTree(translationTrees)')) {
    fail('ember-cli-build.js does not attach the generated translation tree');
  }

  if (intlConfig.includes('translation-reducer')) {
    fail('obsolete ember-intl translation-reducer hook remains');
  }

  if (expectedLocales.includes('none')) {
    fail('development-only none locale is in the production locale set');
  }

  if (!expectedLocales.includes('en-us') || !expectedLocales.includes('zh-tw')) {
    fail('required en-us or zh-tw locale is missing');
  }

  definitions.forEach((definition) => {
    const parsed = JSON.parse(definition.content);
    assert.strictEqual(definition.content, serializeTranslation(parsed));
  });
}

function materialize(distDir) {
  definitions.forEach((definition) => {
    const output = path.join(distDir, definition.outputPath);
    fs.mkdirSync(path.dirname(output), { recursive: true });
    fs.writeFileSync(output, definition.content, 'utf8');
  });
}

function validateDist(distDir, allowNone) {
  const translationsDir = path.join(distDir, 'translations');

  if (!fs.existsSync(translationsDir)) {
    fail(`translation directory is missing: ${translationsDir}`);
  }

  definitions.forEach((definition) => {
    const artifactPath = path.join(distDir, definition.outputPath);

    if (!fs.existsSync(artifactPath)) {
      fail(`translation artifact is missing: ${definition.outputPath}`);
    }

    const artifact = fs.readFileSync(artifactPath, 'utf8');
    if (artifact !== definition.content) {
      fail(`translation artifact differs from canonical YAML: ${definition.outputPath}`);
    }
  });

  const actualLocales = fs.readdirSync(translationsDir)
    .filter((filename) => filename.endsWith('.json'))
    .map((filename) => filename.replace(/\.json$/, ''))
    .sort();
  const allowedLocaleSets = [expectedLocales];
  if (allowNone) {
    allowedLocaleSets.push(expectedLocales.concat('none').sort());
  }

  if (!allowedLocaleSets.some((locales) => JSON.stringify(actualLocales) === JSON.stringify(locales))) {
    fail(`locale set differs: actual=${actualLocales.join(',')} expected=${expectedLocales.join(',')}`);
  }
}

if (mode === '--source') {
  validateSource();
} else if (mode === '--materialize') {
  if (!args[1]) {
    fail('--materialize requires a dist directory');
  }
  materialize(path.resolve(args[1]));
} else if (mode === '--dist') {
  if (!args[1]) {
    fail('--dist requires a dist directory');
  }
  validateDist(path.resolve(args[1]), args.includes('--allow-none'));
} else {
  fail(`unknown mode: ${mode}`);
}

process.stdout.write(
  `UI_PRODUCTION_TRANSLATIONS_OK mode=${mode} locale_count=${expectedLocales.length} locales=${expectedLocales.join(',')}\n`
);
