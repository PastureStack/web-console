#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import json
import sys
from pathlib import Path

failures = 0


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


package = json.loads(Path("package.json").read_text(encoding="utf-8"))
overrides = package.get("overrides", {}) or {}
if "raw-body" in overrides or overrides.get("body@5.1.0") != {"raw-body": "2.5.3"}:
    fail("RAW_BODY_OVERRIDE_UNEXPECTED", expected="body@5.1.0 only: raw-body 2.5.3")
if overrides.get("body-parser") != "2.4.0":
    fail("BODY_PARSER_SECURITY_PIN_MISSING", expected="2.4.0")

lock_path = Path("docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json")
if not lock_path.is_file():
    fail("MISSING_SASS_REPLACEMENT_LOCK", file=lock_path)
else:
    lock = json.loads(lock_path.read_text(encoding="utf-8"))
    packages = lock.get("packages", {}) or {}
    def raw_body_for(parent):
        nested = f"node_modules/{parent}/node_modules/raw-body"
        return packages.get(nested, packages.get("node_modules/raw-body", {}))
    legacy_raw = raw_body_for("body")
    parser_raw = raw_body_for("body-parser")
    if legacy_raw.get("version") != "2.5.3":
        fail("RAW_BODY_LOCK_VERSION_UNEXPECTED", actual=legacy_raw.get("version"), expected="2.5.3")
    if parser_raw.get("version") != "3.0.2":
        fail("BODY_PARSER_RAW_BODY_LOCK_VERSION_UNEXPECTED", actual=parser_raw.get("version"), expected="3.0.2")
    for path, info in packages.items():
        if path.endswith("/raw-body") and info.get("deprecated"):
            fail("DEPRECATED_RAW_BODY_REMAINS", package=path, version=info.get("version"))
    package_count = len(packages)

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(f"UI_RAW_BODY_OVERRIDE_OK raw-body=2.5.3 lockfile={lock_path} package_count={package_count}")
print("Legacy live-reload body uses raw-body 2.5.3; modern body-parser uses its supported raw-body 3.0.2. No global cross-major override.")
print("failure_count=0")
PY
