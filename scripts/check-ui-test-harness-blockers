#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import json
import re
import sys
from pathlib import Path

failures = 0


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


package = json.loads(Path("package.json").read_text(encoding="utf-8"))
dev_deps = package.get("devDependencies", {}) or {}
if "ember-cli-qunit" in dev_deps:
    fail("EMBER_CLI_QUNIT_STILL_PRESENT")
if "ember-qunit" in dev_deps:
    fail("EMBER_QUNIT_STILL_PRESENT")
if "ember-test-helpers" in dev_deps:
    fail("EMBER_TEST_HELPERS_STILL_PRESENT")
if dev_deps.get("qunit") != "2.26.0":
    fail("DIRECT_QUNIT_VERSION_UNEXPECTED", actual=dev_deps.get("qunit"), expected="2.26.0")

all_test_files = [path for path in Path("tests").rglob("*") if path.is_file()]
test_files = [path for path in Path("tests").rglob("*.js")]
if len(all_test_files) < 40:
    fail("UI_TEST_TOTAL_FILE_COUNT_TOO_LOW", actual=len(all_test_files), minimum=40)
if len(test_files) < 38:
    fail("UI_TEST_JS_FILE_COUNT_TOO_LOW", actual=len(test_files), minimum=38)

module_for_count = 0
module_for_component_count = 0
direct_qunit_import_count = 0
for path in test_files:
    text = path.read_text(encoding="utf-8")
    module_for_count += len(re.findall(r"\bmoduleFor\s*\(", text))
    module_for_component_count += len(re.findall(r"\bmoduleForComponent\s*\(", text))
    direct_qunit_import_count += len(re.findall(r"from ['\"]qunit['\"]", text))

if module_for_count != 0:
    fail("MODULE_FOR_USAGE_COUNT_UNEXPECTED", actual=module_for_count, expected=0)
if module_for_component_count != 0:
    fail("MODULE_FOR_COMPONENT_USAGE_UNEXPECTED", actual=module_for_component_count, expected=0)
if direct_qunit_import_count != 100:
    fail("DIRECT_QUNIT_IMPORT_COUNT_UNEXPECTED", actual=direct_qunit_import_count, expected=100)

volatile_computed_count = 0
for path in Path("app").rglob("*.js"):
    volatile_computed_count += len(re.findall(r"\.volatile\s*\(", path.read_text(encoding="utf-8")))
if volatile_computed_count != 0:
    fail("REMOVED_VOLATILE_COMPUTED_API_REMAINS", actual=volatile_computed_count, expected=0)

removed_ember_copy_count = 0
for path in Path("app").rglob("*.js"):
    removed_ember_copy_count += len(re.findall(r"\bEmber\.copy\s*\(", path.read_text(encoding="utf-8")))
if removed_ember_copy_count != 0:
    fail("REMOVED_EMBER_COPY_API_REMAINS", actual=removed_ember_copy_count, expected=0)

navigation_tree = Path("app/utils/navigation-tree.js").read_text(encoding="utf-8")
for marker in ["import { A, isArray } from '@ember/array'", "cloneNavigationValue", "Object.getPrototypeOf(value)"]:
    if marker not in navigation_tree:
        fail("NAVIGATION_TREE_COPY_BOUNDARY_MARKER_MISSING", marker=marker)

registry_inject_count = 0
for path in Path("app/initializers").glob("*.js"):
    registry_inject_count += len(re.findall(r"\bapplication\.inject\s*\(", path.read_text(encoding="utf-8")))
if registry_inject_count != 0:
    fail("REMOVED_APPLICATION_REGISTRY_INJECT_REMAINS", actual=registry_inject_count, expected=0)

removed_link_component_count = 0
for path in Path("app").rglob("*.js"):
    removed_link_component_count += len(re.findall(r"\bEmber\.LinkComponent\b", path.read_text(encoding="utf-8")))
if removed_link_component_count != 0:
    fail("REMOVED_EMBER_LINK_COMPONENT_REMAINS", actual=removed_link_component_count, expected=0)

removed_transition_method_count = 0
for path in Path("app").rglob("*.js"):
    source = path.read_text(encoding="utf-8")
    removed_transition_method_count += len(re.findall(
        r"\bthis\.(?:transitionTo|replaceWith|transitionToRoute)\s*\(|\.transitionToRoute\s*\(|\.replaceRoute\s*\(",
        source,
    ))
    removed_transition_method_count += len(re.findall(r"\bthis\.transitionTo\.apply\s*\(", source))
if removed_transition_method_count != 0:
    fail("REMOVED_ROUTE_OR_CONTROLLER_TRANSITION_METHOD_REMAINS", actual=removed_transition_method_count, expected=0)

router_initializer = Path("app/initializers/inject-router.js").read_text(encoding="utf-8")
for marker in [
    "import Controller from '@ember/controller'",
    "import Route from '@ember/routing/route'",
    "service('router')",
    "injectRouter(Component)",
    "injectRouter(Controller)",
    "injectRouter(Route)",
    "injectRouter(Resource)",
]:
    if marker not in router_initializer:
        fail("PUBLIC_ROUTER_SERVICE_INJECTION_MARKER_MISSING", marker=marker)
if "router:main" in router_initializer:
    fail("PRIVATE_ROUTER_MAIN_INJECTION_RETURNED")

route_initializer = Path("app/initializers/extend-ember-route.js").read_text(encoding="utf-8")
for marker in [
    "this.get('router.currentRoute')",
    "info.paramNames",
    "routeInfoArguments(routeInfo)",
    "parentRouteInfo(routeInfo)",
]:
    if marker not in route_initializer:
        fail("PUBLIC_ROUTE_INFO_NAVIGATION_MARKER_MISSING", marker=marker)
for private_marker in ["currentHandlerInfos", "this.router.router", "_names"]:
    if private_marker in route_initializer:
        fail("PRIVATE_ROUTE_INFO_NAVIGATION_RETURNED", marker=private_marker)

authenticated_controller = Path("app/authenticated/controller.js").read_text(encoding="utf-8")
if "import { alias } from '@ember/object/computed'" not in authenticated_controller or "currentPath : alias('router.currentRouteName')" not in authenticated_controller:
    fail("PUBLIC_CURRENT_ROUTE_NAME_ALIAS_MISSING")
if "application.currentPath" in authenticated_controller:
    fail("REMOVED_APPLICATION_CURRENT_PATH_ALIAS_RETURNED")

for legacy_link_path in [
    Path("app/initializers/extend-ember-link.js"),
    Path("app/components/link-to-as-attrs/component.js"),
]:
    if legacy_link_path.exists():
        fail("LEGACY_LINK_COMPONENT_BOUNDARY_REMAINS", file=legacy_link_path)

page_header_template = Path("app/components/page-header/template.hbs").read_text(encoding="utf-8")
for marker in ["<LinkTo", "@models={{", "@query={{", "@current-when={{"]:
    if marker not in page_header_template:
        fail("PUBLIC_LINK_TO_MARKER_MISSING", marker=marker)
if "link-to-as-attrs" in page_header_template:
    fail("LEGACY_LINK_TO_AS_ATTRS_INVOCATION_REMAINS")
page_header_component = Path("app/components/page-header/component.js").read_text(encoding="utf-8")
if page_header_component.count("normalizeNavigationQueryParams") != 3:
    fail("LINK_TO_QUERY_NORMALIZATION_BOUNDARY_MISSING")

owner_lookup = Path("app/utils/owner-lookup.js")
if not owner_lookup.is_file():
    fail("OWNER_LOOKUP_COMPATIBILITY_MISSING", file=owner_lookup)
else:
    owner_lookup_text = owner_lookup.read_text(encoding="utf-8")
    for phrase in ["getOwner(this)", "owner.lookup(fullName)", ".readOnly()"]:
        if phrase not in owner_lookup_text:
            fail("OWNER_LOOKUP_COMPATIBILITY_MARKER_MISSING", phrase=phrase)

growl_initializer = Path("app/initializers/growl.js").read_text(encoding="utf-8")
if re.search(r"['\"]session['\"]\s*,\s*['\"]service:growl['\"]", growl_initializer):
    fail("GROWL_INITIALIZER_SESSION_COLLISION_RESTORED")

direct_qunit_tests = [
    Path("tests/unit/instance-initializers/intl-test.js"),
    Path("tests/unit/application/route-test.js"),
    Path("tests/unit/admin-tab/accounts/new/controller-test.js"),
    Path("tests/unit/admin-tab/auth/mfa/controller-test.js"),
    Path("tests/unit/components/mfa-security-confirmation-test.js"),
    Path("tests/unit/login/index/controller-test.js"),
    Path("tests/unit/helpers/date-calendar-test.js"),
    Path("tests/unit/helpers/date-from-now-test.js"),
    Path("tests/unit/helpers/date-str-test.js"),
    Path("tests/unit/helpers/format-html-message-test.js"),
    Path("tests/unit/helpers/lower-case-test.js"),
    Path("tests/unit/helpers/nl-to-br-test.js"),
    Path("tests/unit/helpers/upper-case-test.js"),
    Path("tests/unit/utils/util-test.js"),
    Path("tests/unit/utils/localized-catalog-field-test.js"),
    Path("tests/unit/utils/natural-sort-test.js"),
    Path("tests/unit/utils/rolling-rms-test.js"),
    Path("tests/unit/utils/totp-qr-test.js"),
    Path("tests/unit/utils/volume-bulk-remove-test.js"),
    Path("tests/unit/vendor/legacy-component-action-test.js"),
    Path("tests/unit/components/legacy-context-partial-test.js"),
    Path("tests/unit/components/new-select-test.js"),
    Path("tests/unit/components/workspace-terminal-test.js"),
    Path("tests/unit/components/form-ports-test.js"),
    Path("tests/unit/components/new-container-port-preflight-test.js"),
    Path("tests/unit/services/prefs-test.js"),
    Path("tests/unit/utils/socket-test.js"),
    Path("tests/unit/utils/owner-lookup-test.js"),
    Path("tests/unit/utils/catalog-question-answer-test.js"),
    Path("tests/unit/utils/catalog-version-options-test.js"),
    Path("tests/unit/bulk-action-handler/service-test.js"),
    Path("tests/unit/routes/loading-test.js"),
    Path("tests/unit/routes/index-test.js"),
    Path("tests/unit/stack/chart/controller-test.js"),
    Path("tests/unit/stack/chart/route-test.js"),
    Path("tests/unit/backuptargets/route-test.js"),
    Path("tests/unit/container/volumes/route-test.js"),
    Path("tests/unit/container/ports/route-test.js"),
    Path("tests/unit/container/labels/route-test.js"),
    Path("tests/unit/storagepools/pools/route-test.js"),
    Path("tests/unit/pods/container/route-test.js"),
    Path("tests/unit/pods/login/route-test.js"),
    Path("tests/unit/pods/hosts/controller-test.js"),
    Path("tests/unit/pods/hosts/route-test.js"),
    Path("tests/unit/pods/logout/route-test.js"),
    Path("tests/unit/routes/fail-whale-test.js"),
    Path("tests/unit/initializers/extend-ember-input-test.js"),
    Path("tests/unit/initializers/pod-component-layouts-test.js"),
    Path("tests/unit/initializers/touch-test.js"),
    Path("tests/unit/pods/hosts/new/route-test.js"),
    Path("tests/unit/mixins/subscribe-test.js"),
    Path("tests/unit/mixins/store-tweaks-test.js"),
    Path("tests/integration/components/select-tab/component-test.js"),
]
for path in direct_qunit_tests:
    text = path.read_text(encoding="utf-8")
    if "from 'ember-qunit'" in text or 'from "ember-qunit"' in text:
        fail("DIRECT_QUNIT_TEST_STILL_IMPORTS_EMBER_QUNIT", file=path)
    if re.search(r"\bmoduleFor\s*\(", text):
        fail("DIRECT_QUNIT_TEST_STILL_USES_MODULE_FOR", file=path)
    if "from 'qunit'" not in text and 'from "qunit"' not in text:
        fail("DIRECT_QUNIT_TEST_MISSING_DIRECT_QUNIT_IMPORT", file=path)

for path in test_files + [Path("tests/test-helper.js")]:
    text = path.read_text(encoding="utf-8")
    if "from 'ember-qunit'" in text or 'from "ember-qunit"' in text:
        fail("EMBER_QUNIT_IMPORT_REMAINS", file=path)

test_helper = Path("tests/test-helper.js").read_text(encoding="utf-8")
for phrase in ["Object.keys(window.requirejs.entries)", ".filter((name) => /(?:^|\\/)(?:test|tests)\\/.+-test$/", ".forEach((name) => window.require(name))"]:
    if phrase not in test_helper:
        fail("DIRECT_QUNIT_TEST_HELPER_BOOTSTRAP_MISSING", phrase=phrase)
if "ember-cli-test-loader" in dev_deps:
    fail("RETIRED_EMBER_CLI_TEST_LOADER_RETURNED")

bower = json.loads(Path("bower.json").read_text(encoding="utf-8"))
bower_deps = bower.get("dependencies", {}) or {}
if bower_deps:
    fail("BOWER_DEPENDENCIES_REMAIN", actual=",".join(sorted(bower_deps)))

testem_json = json.loads(Path("testem.json").read_text(encoding="utf-8"))
if testem_json.get("launch_in_ci") != ["Chrome"]:
    fail("TESTEM_CI_BROWSER_UNEXPECTED", actual=testem_json.get("launch_in_ci"), expected="Chrome")
if "PhantomJS" in json.dumps(testem_json):
    fail("TESTEM_JSON_STILL_REFERENCES_PHANTOMJS")
chrome_args = testem_json.get("browser_args", {}).get("Chrome", [])
required_chrome_args = [
    "--headless=new",
    "--disable-gpu",
    "--no-sandbox",
    "--disable-dev-shm-usage",
    "--remote-debugging-port=0",
]
for arg in required_chrome_args:
    if arg not in chrome_args:
        fail("TESTEM_CHROME_ARG_MISSING", arg=arg)

testem_js = Path("testem.js").read_text(encoding="utf-8")
if "PhantomJS" in testem_js or "phantomjs" in testem_js:
    fail("TESTEM_JS_STILL_REFERENCES_PHANTOMJS")
for phrase in ['"Chrome"', '"browser_args"', '"--headless=new"']:
    if phrase not in testem_js:
        fail("TESTEM_JS_CHROME_HEADLESS_CONFIG_MISSING", phrase=phrase)

build_js = Path("ember-cli-build.js").read_text(encoding="utf-8")
for phrase in [
    "node_modules/qunit/qunit/qunit.css",
    "node_modules/qunit/qunit/qunit.js",
    "vendor/qunit-module-shim.js",
    "{ type: 'test' }",
]:
    if phrase not in build_js:
        fail("DIRECT_QUNIT_TEST_SUPPORT_IMPORT_MISSING", phrase=phrase)

qunit_shim = Path("vendor/qunit-module-shim.js")
if not qunit_shim.is_file():
    fail("DIRECT_QUNIT_MODULE_SHIM_MISSING", file=qunit_shim)
else:
    shim_text = qunit_shim.read_text(encoding="utf-8")
    for phrase in ["define('qunit'", "exports.module = QUnit.module;", "exports.test = QUnit.test;"]:
        if phrase not in shim_text:
            fail("DIRECT_QUNIT_MODULE_SHIM_MARKER_MISSING", phrase=phrase)

lock_path = Path("docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json")
if not lock_path.is_file():
    fail("MISSING_SASS_REPLACEMENT_LOCK", file=lock_path)
else:
    lock = json.loads(lock_path.read_text(encoding="utf-8"))
    root = (lock.get("packages", {}) or {}).get("", {})
    if root.get("devDependencies", {}) != dev_deps:
        fail("SASS_REPLACEMENT_LOCK_DEV_DEPENDENCIES_DRIFT")
    packages = lock.get("packages", {}) or {}
    for package_path in packages:
        if package_path == "node_modules/ember-cli-qunit" or package_path.startswith("node_modules/ember-cli-qunit/"):
            fail("EMBER_CLI_QUNIT_STILL_IN_LOCK", path=package_path)
        if package_path == "node_modules/ember-qunit" or package_path.startswith("node_modules/ember-qunit/"):
            fail("EMBER_QUNIT_STILL_IN_LOCK", path=package_path)
        if package_path == "node_modules/ember-test-helpers" or package_path.startswith("node_modules/ember-test-helpers/"):
            fail("EMBER_TEST_HELPERS_STILL_IN_LOCK", path=package_path)
    if packages.get("node_modules/qunit", {}).get("version") != "2.26.0":
        fail("DIRECT_QUNIT_LOCK_VERSION_UNEXPECTED", actual=packages.get("node_modules/qunit", {}).get("version"))

browser_gate = Path("scripts/check-ui-browser-ember-test")
if not browser_gate.is_file():
    fail("BROWSER_EMBER_TEST_GATE_MISSING", file=browser_gate)
else:
    gate_text = browser_gate.read_text(encoding="utf-8")
    for phrase in [
        "node:24.20.0-bookworm@sha256:be23f54a88d34e8824c741b19b91064094f92c1c97b194144bfc8b50d67258e2",
        "PASTURESTACK_UI_TESTEM_LAUNCHER",
        "npm ci --ignore-scripts --no-audit --no-fund",
        "./node_modules/.bin/ember test",
    ]:
        if phrase not in gate_text:
            fail("BROWSER_EMBER_TEST_GATE_MARKER_MISSING", phrase=phrase)

environment = Path("config/environment.js").read_text(encoding="utf-8")
if "templateCompilerPath" in environment:
    fail("EOL_TEMPLATE_COMPILER_OVERRIDE_REMAINS")

release_lock = json.loads(Path("package-lock.json").read_text(encoding="utf-8"))
release_packages = release_lock.get("packages", {}) or {}
if release_packages.get("node_modules/ember-source", {}).get("version") != "7.2.0":
    fail("EMBER_CURRENT_TEMPLATE_COMPILER_LOCK_MISSING")

modernization = Path("docs/modernization.md").read_text(encoding="utf-8")
required_phrases = [
    "No-Publish Test Harness Blocker Inventory",
    "No-Publish Low-Risk Route And Service Direct QUnit Migration",
    "No-Publish Route Model Direct QUnit Migration",
    "No-Publish Session And Initializer Direct QUnit Migration",
    "No-Publish Hosts New Direct QUnit Migration",
    "No-Publish Select Tab Direct QUnit Migration",
    "No-Publish Browser Ember Test Gate",
    "No-Publish Ember QUnit Helper Removal",
    "No-Publish Testem Browser Runtime Modernization",
    "ember-source@7.2.0",
    "ember-cli-qunit",
    "moduleFor",
]
for phrase in required_phrases:
    if phrase not in modernization:
        fail("TEST_HARNESS_BLOCKER_DOC_MISSING", phrase=phrase)

ci = Path("scripts/ci").read_text(encoding="utf-8")
if "./scripts/check-ui-browser-ember-test" not in ci:
    fail("BROWSER_EMBER_TEST_CI_GATE_MISSING")

template_files = list(Path("app").rglob("*.hbs")) + list(Path("vendor").rglob("*.hbs"))
component_as_property = re.compile(r"\{\{[#/]?\s*this\.[A-Za-z0-9_]*-")
removed_partial_helper = re.compile(r"\{\{\s*partial\b")
for path in template_files:
    text = path.read_text(encoding="utf-8")
    if component_as_property.search(text):
        fail("TEMPLATE_COMPONENT_MISCLASSIFIED_AS_PROPERTY", file=path)
    if removed_partial_helper.search(text):
        fail("REMOVED_PARTIAL_HELPER_INVOCATION_REMAINS", file=path)

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(
    "UI_TEST_HARNESS_BLOCKERS_RECORDED "
    f"test_files={len(all_test_files)} js_files={len(test_files)} moduleFor={module_for_count} "
    f"moduleForComponent={module_for_component_count} directQunitImports={direct_qunit_import_count} "
    f"directQunitTests={len(direct_qunit_tests)} "
    f"volatileComputed={volatile_computed_count} removedLinkComponent={removed_link_component_count} "
    f"removedTransitionMethods={removed_transition_method_count} "
    f"registryInject={registry_inject_count} "
    f"templates={len(template_files)} "
    "testemCiBrowser=Chrome lockedTemplateCompiler=7.2.0 browserEmberGate=present emberQunitHelpers=removed"
)
print("Browser ember test is now a no-publish source gate; generated asset diff and live route smoke remain required before artifact publication.")
print("failure_count=0")
PY
