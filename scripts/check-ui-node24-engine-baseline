#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
cd "$repo_root"

python3 - <<'PY'
import json
import sys
from pathlib import Path

failures = 0
expected = ">=24"
expected_node = "24.20.0"
expected_npm = "12.0.2"
files = [
    Path("package.json"),
    Path("docs/baselines/package.node-sass-baseline.json"),
    Path("docs/baselines/npm-package-lock.node24-ignore-scripts.json"),
    Path("docs/baselines/npm-package-lock.sass-replacement.node24-ignore-scripts.json"),
]
workflow = Path(".github/workflows/validate.yml")
node_version_file = Path(".node-version")
upload_artifact_v7 = "actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a # v7.0.1"


def fail(code, **fields):
    global failures
    failures += 1
    details = " ".join(f"{key}={value}" for key, value in fields.items())
    print(f"{code} {details}".rstrip())


for path in files:
    if not path.is_file():
        fail("UI_NODE24_ENGINE_FILE_MISSING", file=path)
        continue
    data = json.loads(path.read_text(encoding="utf-8"))
    if "package-lock" in path.name or path.name.startswith("npm-package-lock"):
        actual = ((data.get("packages") or {}).get("") or {}).get("engines", {}).get("node")
    else:
        actual = data.get("engines", {}).get("node")
    if actual != expected:
        fail("UI_NODE24_ENGINE_DRIFT", file=path, actual=actual, expected=expected)

package = json.loads(Path("package.json").read_text(encoding="utf-8"))
if package.get("packageManager") != f"npm@{expected_npm}":
    fail(
        "UI_NPM_PACKAGE_MANAGER_DRIFT",
        actual=package.get("packageManager"),
        expected=f"npm@{expected_npm}",
    )
dev_engines = package.get("devEngines") or {}
runtime = dev_engines.get("runtime") or {}
package_manager = dev_engines.get("packageManager") or {}
for field, actual, expected_value in [
    ("runtime.name", runtime.get("name"), "node"),
    ("runtime.version", runtime.get("version"), expected_node),
    ("runtime.onFail", runtime.get("onFail"), "error"),
    ("packageManager.name", package_manager.get("name"), "npm"),
    ("packageManager.version", package_manager.get("version"), expected_npm),
    ("packageManager.onFail", package_manager.get("onFail"), "error"),
]:
    if actual != expected_value:
        fail("UI_DEV_ENGINE_DRIFT", field=field, actual=actual, expected=expected_value)
if not node_version_file.is_file():
    fail("UI_NODE_VERSION_FILE_MISSING", file=node_version_file)
elif node_version_file.read_text(encoding="utf-8").strip() != expected_node:
    fail(
        "UI_NODE_VERSION_FILE_DRIFT",
        actual=node_version_file.read_text(encoding="utf-8").strip(),
        expected=expected_node,
    )

if not workflow.is_file():
    fail("UI_NODE24_WORKFLOW_MISSING", file=workflow)
else:
    workflow_text = workflow.read_text(encoding="utf-8")
    if upload_artifact_v7 not in workflow_text:
        fail("UI_NODE24_UPLOAD_ARTIFACT_ACTION_DRIFT", file=workflow)
    for marker in [
        f"NODE_VERSION: {expected_node}",
        f'test "$(node --version)" = v{expected_node}',
        f'test "$(npm --version)" = {expected_npm}',
        "node:24.20.0-bookworm@sha256:be23f54a88d34e8824c741b19b91064094f92c1c97b194144bfc8b50d67258e2",
    ]:
        if marker not in workflow_text:
            fail("UI_PINNED_TOOLCHAIN_MARKER_MISSING", marker=marker)
    for marker in [
        'package_version=$(node -p \'require("./package.json").version\')',
        'bash scripts/package-static-candidate',
        '"$package_version"',
        '"${package_version}/VERSION.txt"',
        'release_name=$(basename "$release_asset")',
        'sha256sum "$release_name" >"${release_name}.sha256"',
        'test "$(awk \'{print $2}\' "${release_asset}.sha256")" = "$release_name"',
    ]:
        if marker not in workflow_text:
            fail("UI_RELEASE_CHECKSUM_PORTABILITY_MARKER_MISSING", marker=marker)
    if "UI_COMPATIBILITY_VERSION" in workflow_text:
        fail("UI_RELEASE_STALE_COMPATIBILITY_VERSION_REMAINS", file=workflow)
    if 'sha256sum "$release_asset" >"${release_asset}.sha256"' in workflow_text:
        fail("UI_RELEASE_CHECKSUM_ABSOLUTE_PATH_REMAINS", file=workflow)

transitive_legacy = []
for path in files:
    if not path.is_file() or not path.name.startswith("npm-package-lock"):
        continue
    data = json.loads(path.read_text(encoding="utf-8"))
    for package_path, package_data in (data.get("packages") or {}).items():
        if package_path == "":
            continue
        engines = package_data.get("engines")
        if isinstance(engines, dict) and engines.get("node") == ">= 0.12.0":
            transitive_legacy.append(f"{path}:{package_path}")

if failures:
    print(f"failure_count={failures}")
    sys.exit(1)

print(
    "UI_NODE24_ENGINE_BASELINE_OK "
    f"node_engine=>=24 pinned_node={expected_node} pinned_npm={expected_npm}"
)
if transitive_legacy:
    print("known_transitive_legacy_node_engine_markers=" + ",".join(transitive_legacy))
print("The active UI maintenance source and lock baseline roots no longer advertise Node 0.12 compatibility; transitive legacy package metadata remains a documented no-publish blocker.")
print("failure_count=0")
PY
