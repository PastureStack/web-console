{
  "framework": "qunit",
  "host": "127.0.0.1",
  "test_page": "tests/index.html?hidepassed",
  "disable_watching": true,
  "launch_in_ci": [
    "Headless Chrome"
  ],
  "launch_in_dev": [
    "Headless Chrome"
  ],
  "browser_args": {
    "Headless Chrome": [
      "--disable-extensions",
      "--disable-component-extensions-with-background-pages",
      "--disable-background-networking",
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--do-not-de-elevate"
    ],
    "chromium": [
      "--headless=new",
      "--disable-gpu",
      "--disable-extensions",
      "--disable-component-extensions-with-background-pages",
      "--disable-background-networking",
      "--no-sandbox",
      "--disable-dev-shm-usage",
      "--remote-debugging-port=0"
    ]
  }
}
