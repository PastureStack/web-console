<table class="fixed grid sortable-table lacsso">
  <thead class="lacsso">
    <tr class="fixed-header-placeholder lacsso">
      {{#if this.bulkActions}}
        <th class="lacsso" width="40" data-column-role="selection"></th>
      {{/if}}
      {{#each this.visibleHeaders as |header idx|}}
        <th class="lacsso" width={{if header.width header.width}}></th>
      {{/each}}
    </tr>
    {{#if (or this.paging this.search this.columnSelector this.bulkActions)}}
      <div class="fixed-header-actions row lacsso">
        {{#if (and this.bulkActions this.bulkActionMenu)}}
          <div class="sortable-table-action-controls lacsso">
            <div class="container-actions lacsso">
              {{#if this.availableActions}}
                {{#rl-dropdown-container class="dropdown lacsso"}}
                  {{#rl-dropdown-toggle class="btn btn-sm bg-primary lacsso"}}
                    {{t 'generic.actions'}} {{#if (gt this.selectedNodes.length 1)}}({{this.selectedNodes.length}}) {{/if}}<span class="icon icon-chevron-down" style="position: relative; top: 2px;"></span>
                  {{/rl-dropdown-toggle}}

                  {{#rl-dropdown tagName="ul" class="resource-actions global-actions dropdown-menu dropdown-menu-right lacsso" closeOnChildClick="a:link"}}
                    <li class="resource-actions-tabbable"><a tabindex="-1" id="resource-actions-first" aria-label="Select an Action below"></a></li>
                    {{#each this.availableActions as |availableAction index|}}
                      {{#if availableAction.disabled}}
                        <li class="disabled">
                          <a href="#" onclick="return false;" tabindex={{index}}>
                            {{if availableAction.bulkActionName availableAction.bulkActionName availableAction.translatedLabel}}
                            <i class="{{availableAction.icon}}"></i>
                          </a>
                        </li>
                      {{else}}
                        <li>
                          <a href="#" onclick={{action 'executeBulkAction' availableAction.action}} tabindex={{index}}>
                            {{if availableAction.bulkActionName availableAction.bulkActionName availableAction.translatedLabel}}
                            <i class="{{availableAction.icon}}"></i>
                          </a>
                        </li>
                      {{/if}}
                    {{/each}}
                  {{/rl-dropdown}}
                {{/rl-dropdown-container}}
              {{else}}
                <button class="btn btn-sm bg-primary lacsso" disabled>
                  {{t 'generic.actions'}} <span class="icon icon-chevron-down" style="position: relative; top: 2px;"></span>
                </button>
              {{/if}}
            </div>
          </div>
        {{/if}}
        {{#if (or this.paging this.search this.columnSelector)}}
          <div class="sortable-table-filter-controls lacsso">
            <div class="sortable-table-filter-bar lacsso">
              {{#if this.columnSelector}}
                {{#rl-dropdown-container class="dropdown sortable-table-column-selector lacsso"}}
                  {{#rl-dropdown-toggle class="btn btn-sm bg-default lacsso" title=(t 'generic.columns')}}
                    <i class="icon icon-thumbnails" aria-hidden="true"></i>
                    <span>{{t 'generic.columns'}}</span>
                    <i class="icon icon-chevron-down" aria-hidden="true"></i>
                  {{/rl-dropdown-toggle}}
                  {{#rl-dropdown tagName="ul" class="dropdown-menu sortable-table-column-menu lacsso" closeOnChildClick=false}}
                    {{#each this.selectableColumnOptions as |option|}}
                      <li>
                        <a href="#" role="menuitemcheckbox" aria-checked={{if option.visible "true" "false"}} onclick={{action "toggleColumn" option}}>
                          <i class="icon {{if option.visible "icon-check" "icon-square"}}" aria-hidden="true"></i>
                          <span>
                            {{#if option.translationKey}}
                              {{t option.translationKey}}
                            {{else}}
                              {{option.displayName}}
                            {{/if}}
                          </span>
                        </a>
                      </li>
                    {{/each}}
                  {{/rl-dropdown}}
                {{/rl-dropdown-container}}
              {{/if}}
              {{#if this.paging}}
                <label class="sortable-table-page-size lacsso">
                  <span>{{t 'pagination.rowsPerPage'}}</span>
                  <select class="input-sm lacsso" onchange={{action "changePerPage" value="target.value"}}>
                    {{#each this.pageSizeOptions as |size|}}
                      <option value={{size}} selected={{eq size this.selectedPageSize}}>
                        {{#if (eq size 0)}}{{t 'pagination.all'}}{{else}}{{size}}{{/if}}
                      </option>
                    {{/each}}
                  </select>
                </label>
              {{/if}}
              {{#if this.search}}
                <div class="row inline-form gutless sortable-table-search lacsso">
                  <span class="col span-3 input-label bg-default input-sm lacsso">
                    <label>{{t 'generic.search'}}:</label>
                  </span>
                  {{input value=this.searchText type="search" class="col span-8 input-sm lacsso"}}
                  {{#if this.searchText}}
                    <span class="col span-1 lacsso">
                      <button class="btn btn-sm bg-default" {{action 'clearSearch'}}><i class="icon icon-close"/></button>
                    </span>
                  {{/if}}
                </div>
              {{/if}}
            </div>
          </div>
        {{/if}}
        {{#if this.paging}}
          <div class="sortable-table-pagination lacsso">
            {{page-numbers content=this.pagedContent class="no-select" indexTo=this.indexTo indexFrom=this.indexFrom totalCount=this.filtered.length}}
          </div>
        {{/if}}
      </div>
    {{/if}}

    <tr class="fixed-header lacsso">
      {{#if this.bulkActions}}
        <th width="40" class="select-for-action" data-column-role="selection">
          {{check-box classNames="select-all-check" checked=this.isAll disabled=(not this.hasSelectablePagedContent)}}
        </th>
      {{/if}}
      {{#each this.visibleHeaders as | header |}}
        {{sortable-thead
          sortable=this
          current=this.sortBy
          descending=this.descending
          action="changeSort"
          name=header.name
          isActions=header.isActions
          label=header.displayName
          translationKey=header.translationKey
          classNames=header.classNames
          columnRole=header.columnRole
          isSortable=header.isSortable
          }}
      {{/each}}
    </tr>
  </thead>
  <tbody class="lacsso">
    {{#if this.prefix}}
      {{yield null 'prefix' this.dt this.visibleColumnMap}}
    {{/if}}
    {{#each this.pagedContent as |content|}}
      <tr data-row-id={{content.id}}>
        {{#if this.bulkActions}}
          <td width="40" class="select-for-action" data-column-role="selection">
            {{check-box nodeId=content.id disabled=(not (array-includes this.selectablePagedContent content))}}
          </td>
        {{/if}}
        {{#if hasBlock}}
          {{yield content 'row' this.dt this.visibleColumnMap}}
        {{else}}
          {{#each this.visibleHeaders as |header|}}
            <td data-title={{header.displayName}} data-id={{content.id}}>{{select-property content header.name}}</td>
          {{/each}}
        {{/if}}
      </tr>
    {{else}}
      {{#if hasBlock}}
        {{yield null (if this.arranged.length 'nomatch' 'norows') this.dt this.visibleColumnMap}}
      {{/if}}
    {{/each}}
    {{#if this.suffix}}
      {{yield null 'suffix' this.dt this.visibleColumnMap}}
    {{/if}}
  </tbody>
</table>
