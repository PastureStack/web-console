<div class="lacsso pagination-container">
  <div class="lacsso btn-group btn-group-sm">
    <a class="lacsso arrow prev enabled-arrow btn bg-default" disabled={{unless (gte this.content.page 2) 'disabled'}} {{action "pageClicked" 1}}><span class="icon icon-chevron-beginning"></span></a>
    <a class="lacsso arrow prev enabled-arrow btn bg-default" disabled={{unless this.canStepBackward 'disabled'}} {{action "incrementPage" -1}}><span class="icon icon-chevron-left"></span></a>
    <div class="overview-text lacsso btn bg-default" style="border: 0;">{{if this.content.totalPages this.content.page 0}} / {{this.content.totalPages}}</div>
    <a class="lacsso arrow next enabled-arrow btn bg-default" disabled={{unless this.canStepForward 'disabled'}} {{action "incrementPage" 1}}><span class="icon icon-chevron-right"></span></a>
    <a class="lacsso arrow prev enabled-arrow btn bg-default" disabled={{if (gte this.content.page this.content.totalPages) 'disabled'}} {{action "pageClicked" this.content.totalPages}}><span class="icon icon-chevron-end"></span></a>
  </div>
</div>
